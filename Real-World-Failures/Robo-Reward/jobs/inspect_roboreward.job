#!/bin/bash
#SBATCH --job-name=inspect_roboreward
#SBATCH --output=/home/pkarageo/master-thesis/Robo-Reward-FPS/logs/inspect_roboreward_%j.txt
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00

# Activate Conda
source $(conda info --base)/etc/profile.d/conda.sh
conda activate /var/scratch/pkarageo/conda_envs/roboreward

# Environment setup for HuggingFace
export HF_HOME="/var/scratch/pkarageo/hf_cache"

# Debug Info
echo "============================================"
echo "RoboReward Dataset Inspector"
echo "============================================"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "============================================"

# Create output directory
mkdir -p /var/scratch/pkarageo/roboreward_dataset

# Run inspector
python -u /home/pkarageo/master-thesis/Robo-Reward-FPS/scripts/inspect_roboreward_dataset.py

echo "============================================"
echo "Inspection completed at: $(date)"
echo "============================================"
