#!/bin/bash
#SBATCH --job-name=rclone_splits_od
#SBATCH --output=/home/pkarageorgis1/Master-Thesis/Real-World-Failures/Robometer/logs/rclone_push_splits_onedrive_%j.out
#SBATCH --partition=staging
#SBATCH --mem=8G
#SBATCH --cpus-per-task=2
#SBATCH --time=01:00:00

# Push robometer_frames_splits_full (~1.5 GB, 27 files) to OneDrive via rclone.
# Same throttle settings as the frame_dataset push since we share the same
# OneDrive endpoint.

SRC="/projects/prjs1958/robometer_frames_splits_full"
DST="myonedrive:robometer_frames_splits_full"

echo "============================================================"
echo "rclone push robometer_frames_splits_full -> OneDrive"
echo "  Job ID:   $SLURM_JOB_ID"
echo "  Node:     $(hostname)"
echo "  Source:   $SRC"
echo "  Dest:     $DST"
echo "  Date:     $(date)"
echo "============================================================"

rclone --version | head -1

rclone copy "$SRC" "$DST" \
    --transfers 2 \
    --checkers 8 \
    --onedrive-chunk-size 30M \
    --bwlimit 30M \
    --tpslimit 6 \
    --stats 30s \
    --stats-one-line \
    --retries 10 \
    --low-level-retries 30 \
    --log-level INFO

RC=$?
echo "============================================================"
echo "rclone exit code: $RC"
echo "Done at: $(date)"
echo "============================================================"
exit $RC
