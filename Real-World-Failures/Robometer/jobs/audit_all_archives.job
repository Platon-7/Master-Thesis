#!/bin/bash
#SBATCH --job-name=rmt_audit
#SBATCH --output=/home/pkarageorgis1/Master-Thesis/Real-World-Failures/Robometer/logs/audit_all_archives_%j.out
#SBATCH --partition=staging
#SBATCH --mem=16G
#SBATCH --cpus-per-task=4
#SBATCH --time=06:00:00

# Scan every archive in the Robometer dataset (single + split) and report
# success/failure counts. Identifies orphan successes.
# Output: JSON report + human-readable log.

SCRIPT_DIR="/gpfs/home3/pkarageorgis1/Master-Thesis/Real-World-Failures/Robometer"

echo "============================================================"
echo "RoboMeter Full Dataset Audit"
echo "  Job ID: $SLURM_JOB_ID"
echo "  Node:   $(hostname)"
echo "  Date:   $(date)"
echo "============================================================"

python3 "${SCRIPT_DIR}/audit_all_archives.py"

echo "============================================================"
echo "Done at: $(date)"
echo "============================================================"
