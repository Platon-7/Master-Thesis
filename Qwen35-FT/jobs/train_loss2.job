#!/bin/bash
#SBATCH --job-name=qwen35_ft_l2
#SBATCH --output=logs/train_loss2_%j.out
#SBATCH --error=logs/train_loss2_%j.err
#SBATCH --time=72:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH --mem=480G

# Full fine-tune of vanilla Qwen3.5-4B with Loss 2 (asymmetric C51 + BCE).
# Multi-GPU FSDP via accelerate. Defaults to single node 4×H100.
#
# To launch on N nodes (N×4 GPUs total), override --nodes at submit time:
#     sbatch --nodes=2 --export=ALL,EXTRA="..." jobs/train_loss2.job
#
# Recipe overrides (set at launch via `sbatch --export=ALL,VAR=val,...`):
#   * MAX_STEPS=N                          → training.max_steps
#   * EXTRA="++data.use_icl=false ..."     → arbitrary Hydra overrides
#   * WANDB_PROJECT=...                    → WandB project (default Qwen35_FT)
#   * WEIGHTS_DIR=...                      → checkpoint output root

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
QWEN35_DIR="${QWEN35_DIR:-$HERE}"
HF_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/projects/prjs1958/robometer_frames_hf}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1

# Env interpreter — overrideable via ENV_PREFIX so the same job works on
# both your local conda env and Leonardo's conda-packed copy.
ENV_PREFIX="${ENV_PREFIX:-/home/pkarageorgis1/.conda/envs/robometer_qwen35_gpu}"
PYTHON="$ENV_PREFIX/bin/python"
ACCELERATE="$ENV_PREFIX/bin/accelerate"
if [[ ! -x "$PYTHON" ]] || [[ ! -x "$ACCELERATE" ]]; then
    echo "ERROR: env interpreter / accelerate not executable at $ENV_PREFIX/bin/" >&2
    exit 1
fi
# Put env's bin/ on PATH so `#!/usr/bin/env python3.10` shebangs resolve to
# the env interpreter (matters for conda-packed envs — conda-unpack only
# rewrites absolute-path shebangs, not /usr/bin/env-style ones).
export PATH="$ENV_PREFIX/bin:$PATH"

export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_DIR"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export WANDB_PROJECT="${WANDB_PROJECT:-Qwen35_FT}"
export WANDB_API_KEY="${WANDB_API_KEY:-}"
export WANDB_ENTITY="${WANDB_ENTITY:-nlp-squad}"

# Tar-shard dataset root (HF + MP4 stack bypassed — train_ft.py reads
# pairs_unified.jsonl + tar shards directly).
export TAR_DATASET_ROOT="${TAR_DATASET_ROOT:-/projects/prjs1958/robometer_frame_dataset}"

# CRITICAL: cd into Qwen35-FT/ so the vendored robometer/ wins on import precedence.
cd "$QWEN35_DIR"
export PYTHONPATH="$QWEN35_DIR:${PYTHONPATH:-}"

# ---------------- multi-node topology ----------------
# SLURM tells us how many nodes were allocated and which is the head. Single-node
# stays exactly as before; multi-node uses srun to launch one accelerate per node,
# each spawning local_world_size GPUs and joining the global rendezvous.
NUM_NODES="${SLURM_NNODES:-1}"
GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
TOTAL_PROCESSES=$(( NUM_NODES * GPUS_PER_NODE ))

# Pick a free-ish port deterministically from the job id (avoids collisions across
# concurrent jobs on the same node) and resolve the head node IP.
RDZV_PORT=$(( 10000 + ${SLURM_JOB_ID:-0} % 50000 ))
NODE_LIST=( $(scontrol show hostnames "$SLURM_JOB_NODELIST") )
HEAD_NODE="${NODE_LIST[0]}"
HEAD_NODE_IP=$(srun --nodes=1 --ntasks=1 -w "$HEAD_NODE" hostname --ip-address | head -1)

# NCCL: explicit Snellius-friendly settings. Auto-detects InfiniBand HCAs; set
# NCCL_DEBUG=INFO via EXTRA env vars for first multi-node run if you hit hangs.
export NCCL_ASYNC_ERROR_HANDLING=1
export FI_PROVIDER=efa     # ignored if not present; harmless
# Avoid Python+NCCL launching in fork mode (sometimes hangs on multi-node):
export OMP_NUM_THREADS=1
# ------------------------------------------------------

# Sed-flatten the YAML configs into Hydra ++key=value overrides.
readarray -t OVERRIDES < <(
    grep -hv '^[[:space:]]*#' "$HERE/configs/train_base.yaml" "$HERE/configs/loss2_c51.yaml" \
      | sed -e 's/[[:space:]]*#.*//' \
      | grep -v '^[[:space:]]*$' \
      | sed -e 's/: */=/' -e 's/^/++/'
)

EXTRA="${EXTRA:-}"
if [[ -n "${MAX_STEPS:-}" ]]; then
    EXTRA="$EXTRA ++training.max_steps=$MAX_STEPS"
fi
if [[ -n "${WANDB_ENTITY:-}" ]]; then
    EXTRA="$EXTRA logging.wandb_entity=$WANDB_ENTITY"
fi

WEIGHTS_DIR="${WEIGHTS_DIR:-/projects/prjs1958/Qwen35_FT_weights}"
mkdir -p "$WEIGHTS_DIR"

echo "==================== launch summary ===================="
echo "Nodes              : $NUM_NODES  (${NODE_LIST[*]})"
echo "Head node          : $HEAD_NODE  ($HEAD_NODE_IP)"
echo "GPUs per node      : $GPUS_PER_NODE"
echo "TOTAL_PROCESSES    : $TOTAL_PROCESSES"
echo "Rendezvous port    : $RDZV_PORT"
echo "WEIGHTS_DIR        : $WEIGHTS_DIR"
echo "MAX_STEPS          : ${MAX_STEPS:-<from-yaml>}"
echo "EXTRA              : $EXTRA"
echo "OVERRIDES count    : ${#OVERRIDES[@]}"
echo "========================================================"

# Single-node: call accelerate directly (faster startup, no srun overhead).
# Multi-node: srun -ntasks-per-node=1 spawns one accelerate per node; accelerate
# then forks GPUS_PER_NODE local processes. SLURM_NODEID is set per srun task.
if [[ "$NUM_NODES" -le 1 ]]; then
    "$ACCELERATE" launch \
      --config_file configs/distributed/fsdp_qwen35.yaml \
      --num_machines=1 \
      --num_processes="$TOTAL_PROCESSES" \
      --machine_rank=0 \
      --main_process_ip="$HEAD_NODE_IP" \
      --main_process_port="$RDZV_PORT" \
      train_ft.py "${OVERRIDES[@]}" $EXTRA \
      training.output_dir="$WEIGHTS_DIR/loss2_${SLURM_JOB_ID:-local}"
else
    srun --ntasks-per-node=1 --cpu-bind=none bash -c "
        \"$ACCELERATE\" launch \\
          --config_file configs/distributed/fsdp_qwen35.yaml \\
          --num_machines=$NUM_NODES \\
          --num_processes=$TOTAL_PROCESSES \\
          --machine_rank=\$SLURM_NODEID \\
          --main_process_ip=$HEAD_NODE_IP \\
          --main_process_port=$RDZV_PORT \\
          train_ft.py ${OVERRIDES[*]} $EXTRA \\
          training.output_dir=$WEIGHTS_DIR/loss2_${SLURM_JOB_ID:-local}
    "
fi
