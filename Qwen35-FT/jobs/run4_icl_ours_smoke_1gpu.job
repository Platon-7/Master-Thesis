#!/bin/bash
#SBATCH --job-name=qwen35_ft_run4_smoke
#SBATCH --account=gusei17535
#SBATCH --output=logs/run4_icl_ours_smoke_%j.out
#SBATCH --error=logs/run4_icl_ours_smoke_%j.err
#SBATCH --time=00:30:00
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --ntasks-per-node=1
#SBATCH --mem=120G

# 1-GPU smoke of run4_icl_ours. Same env / overrides pipeline / config as the prod
# 8-GPU run, but: 1 H100, max_steps=5, batch_size=2, no eval/save/wandb. Goal is to
# confirm env + data + ICL pair loading + FSDP single-rank launch all wire up before
# the multi-node job clears the queue.

set -uo pipefail   # NOT -e: capture trainer exit code so we can print it

cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
QWEN35_DIR="${QWEN35_DIR:-$HERE}"
HF_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/scratch-shared/$USER/robometer_frames_hf_full_step2}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1

ENV_PREFIX="${ENV_PREFIX:-/scratch-shared/$USER/envs/robometer_qwen35_gpu}"
if [[ ! -x "$ENV_PREFIX/bin/python" ]]; then
    echo "ERROR: ENV_PREFIX env not found at $ENV_PREFIX" >&2
    exit 1
fi
PYTHON="$ENV_PREFIX/bin/python"
ACCELERATE="$ENV_PREFIX/bin/accelerate"
[[ -x "$PYTHON" && -x "$ACCELERATE" ]] || { echo "ERROR: env binaries missing at $ENV_PREFIX/bin/" >&2; exit 1; }
export PATH="$ENV_PREFIX/bin:$PATH"

export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_DIR"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
# WandB explicitly disabled — smoke doesn't write a run.
unset WANDB_PROJECT WANDB_API_KEY WANDB_ENTITY
export WANDB_MODE=disabled

cd "$QWEN35_DIR"
export PYTHONPATH="$QWEN35_DIR:${PYTHONPATH:-}"

readarray -t OVERRIDES < <(
    grep -hv '^[[:space:]]*#' "$HERE/configs/train_base.yaml" "$HERE/configs/run4_icl_ours.yaml" \
      | sed -e 's/[[:space:]]*#.*//' \
      | grep -v '^[[:space:]]*$' \
      | sed -e 's/: */=/' -e 's/^/++/'
)

SMOKE=$(cat <<'EOF'
++training.max_steps=5
++training.per_device_train_batch_size=2
++training.do_eval=false
++training.evaluation_strategy=no
++training.save_strategy=no
++training.logging_steps=1
++custom_eval.eval_types=[]
++custom_eval.policy_ranking_dual_icl=false
++logging.log_to=[]
EOF
)
SMOKE_ARGS=$(echo "$SMOKE" | tr '\n' ' ')

WEIGHTS_DIR="/scratch-shared/$USER/Qwen35_FT_smoke/run4_${SLURM_JOB_ID:-local}"
mkdir -p "$WEIGHTS_DIR"

NUM_PROC=1

echo "==================== smoke launch summary ===================="
echo "config             : run4_icl_ours.yaml (ICL on, loss2 c51+bce)"
echo "FSDP num_processes : $NUM_PROC"
echo "ENV_PREFIX         : $ENV_PREFIX"
echo "HF_DIR             : $HF_DIR"
echo "WEIGHTS_DIR        : $WEIGHTS_DIR"
echo "OVERRIDES count    : ${#OVERRIDES[@]}"
echo "SMOKE overrides    :"
echo "$SMOKE" | sed 's/^/  /'
echo "==============================================================="

"$ACCELERATE" launch \
  --config_file configs/distributed/fsdp_qwen35.yaml \
  --num_processes="$NUM_PROC" \
  train.py "${OVERRIDES[@]}" $SMOKE_ARGS \
  training.output_dir="$WEIGHTS_DIR"
RC=$?

echo
echo "==================== smoke exit summary ===================="
echo "trainer return code: $RC"
if [[ $RC -eq 0 ]]; then
    echo "SMOKE PASSED — run4_icl_ours (1 GPU)"
else
    echo "SMOKE FAILED — run4_icl_ours (1 GPU) rc=$RC"
fi
echo "============================================================"
exit $RC
