#!/bin/bash
#SBATCH --job-name=qwen35_ft_run6_p2
#SBATCH --account=gusei17535
#SBATCH --output=logs/run6_noicl_standard_phase2_%j.out
#SBATCH --error=logs/run6_noicl_standard_phase2_%j.err
#SBATCH --time=24:00:00
#SBATCH --partition=gpu_h100
#SBATCH --nodes=2
#SBATCH --gpus-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH --ntasks-per-node=1
#SBATCH --mem=480G

# Phase 2 of run6 — fine-tune from Phase 1's consolidated checkpoint at lower LR.
# Mirrors run4_icl_ours.job 1:1 except for:
#   * uses configs/run6_noicl_standard_phase2.yaml (LR=1e-5, max_steps=5000)
#   * reads LOAD_FROM_CKPT env to set ++training.load_from_checkpoint=<hf_dir>
#
# REQUIRED env (pass via sbatch --export):
#   LOAD_FROM_CKPT=/projects/prjs1958/Qwen35_FT_phase1_consolidated/run4_step6500
#                  (HF-format dir produced by jobs/consolidate_phase1.job)
#
# Optional:
#   MAX_STEPS=N         → overrides the yaml's 5000
#   EXTRA="..."         → additional Hydra overrides
#   WEIGHTS_DIR=...     → checkpoint output root
#
# Usage:
#   sbatch --export=ALL,LOAD_FROM_CKPT=/path/to/phase1_hf jobs/run6_noicl_standard_phase2.job

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
QWEN35_DIR="${QWEN35_DIR:-$HERE}"
HF_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/scratch-shared/$USER/robometer_frames_hf_full_step2}"

if [[ -z "${LOAD_FROM_CKPT:-}" ]]; then
    echo "ERROR: must pass LOAD_FROM_CKPT via --export=ALL,LOAD_FROM_CKPT=/path/to/phase1_hf" >&2
    echo "  Phase 2 fine-tunes from Phase 1's consolidated HF checkpoint." >&2
    echo "  Produce one first: sbatch --export=ALL,CKPT_DIR=...,OUT_DIR=... jobs/consolidate_phase1.job" >&2
    exit 1
fi
if [[ ! -d "$LOAD_FROM_CKPT" ]]; then
    echo "ERROR: LOAD_FROM_CKPT directory does not exist: $LOAD_FROM_CKPT" >&2
    exit 1
fi

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1

ENV_PREFIX="${ENV_PREFIX:-/scratch-shared/$USER/envs/robometer_qwen35_gpu}"
if [[ ! -x "$ENV_PREFIX/bin/python" ]]; then
    echo "ERROR: ENV_PREFIX env not found at $ENV_PREFIX" >&2
    exit 1
fi
PYTHON="$ENV_PREFIX/bin/python"
ACCELERATE="$ENV_PREFIX/bin/accelerate"
export PATH="$ENV_PREFIX/bin:$PATH"

export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_DIR"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export WANDB_PROJECT="${WANDB_PROJECT:-Qwen35_FT}"
export WANDB_API_KEY="${WANDB_API_KEY:-}"
export WANDB_ENTITY="${WANDB_ENTITY:-nlp-squad}"

cd "$QWEN35_DIR"
export PYTHONPATH="$QWEN35_DIR:${PYTHONPATH:-}"

readarray -t OVERRIDES < <(
    grep -hv '^[[:space:]]*#' "$HERE/configs/train_base.yaml" "$HERE/configs/run6_noicl_standard_phase2.yaml" \
      | sed -e 's/[[:space:]]*#.*//' \
      | grep -v '^[[:space:]]*$' \
      | sed -e 's/: */=/' -e 's/^/++/'
)

# EXTRA collects final-stage overrides. LOAD_FROM_CKPT routes to training.load_from_checkpoint
# (WEIGHTS-only — fresh optimizer + LR schedule, NOT a HF Trainer resume).
EXTRA="${EXTRA:-}"
EXTRA="$EXTRA ++training.load_from_checkpoint=$LOAD_FROM_CKPT"
if [[ -n "${MAX_STEPS:-}" ]]; then
    EXTRA="$EXTRA ++training.max_steps=$MAX_STEPS"
fi
if [[ -n "${WANDB_ENTITY:-}" ]]; then
    EXTRA="$EXTRA logging.wandb_entity=$WANDB_ENTITY"
fi

WEIGHTS_DIR="${WEIGHTS_DIR:-/projects/prjs1958/Qwen35_FT_weights}"
mkdir -p "$WEIGHTS_DIR"

NUM_NODES="${SLURM_NNODES:-1}"
GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
TOTAL_PROCESSES=$(( NUM_NODES * GPUS_PER_NODE ))
RDZV_PORT=$(( 10000 + ${SLURM_JOB_ID:-0} % 50000 ))
NODE_LIST=( $(scontrol show hostnames "$SLURM_JOB_NODELIST") )
HEAD_NODE="${NODE_LIST[0]}"
HEAD_NODE_IP=$(srun --nodes=1 --ntasks=1 -w "$HEAD_NODE" hostname --ip-address | head -1)

export NCCL_ASYNC_ERROR_HANDLING=1
export FI_PROVIDER=efa
export OMP_NUM_THREADS=1

echo "================== PHASE 2 launch summary =================="
echo "LOAD_FROM_CKPT     : $LOAD_FROM_CKPT"
echo "Nodes              : $NUM_NODES  (${NODE_LIST[*]})"
echo "TOTAL_PROCESSES    : $TOTAL_PROCESSES"
echo "WEIGHTS_DIR        : $WEIGHTS_DIR"
echo "MAX_STEPS          : ${MAX_STEPS:-<from-yaml:5000>}"
echo "EXTRA              : $EXTRA"
echo "============================================================"

if [[ "$NUM_NODES" -le 1 ]]; then
    "$ACCELERATE" launch \
      --config_file configs/distributed/fsdp_qwen35.yaml \
      --num_machines=1 \
      --num_processes="$TOTAL_PROCESSES" \
      --machine_rank=0 \
      --main_process_ip="$HEAD_NODE_IP" \
      --main_process_port="$RDZV_PORT" \
      train.py "${OVERRIDES[@]}" $EXTRA \
      training.output_dir="$WEIGHTS_DIR/run6_noicl_standard_phase2_${SLURM_JOB_ID:-local}"
else
    srun --ntasks-per-node=1 --cpu-bind=none bash -c "
        export PYTHONPATH=$QWEN35_DIR:\${PYTHONPATH:-}
        cd $QWEN35_DIR
        \"$ACCELERATE\" launch \\
          --config_file configs/distributed/fsdp_qwen35.yaml \\
          --num_machines=$NUM_NODES \\
          --num_processes=$TOTAL_PROCESSES \\
          --machine_rank=\$SLURM_NODEID \\
          --main_process_ip=$HEAD_NODE_IP \\
          --main_process_port=$RDZV_PORT \\
          train.py ${OVERRIDES[*]} $EXTRA \\
          training.output_dir=$WEIGHTS_DIR/run6_noicl_standard_phase2_${SLURM_JOB_ID:-local}
    "
fi
