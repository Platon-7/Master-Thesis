#!/bin/bash
#SBATCH --job-name=qwen35_flash_install
#SBATCH --output=logs/install_flash_attn_%j.out
#SBATCH --error=logs/install_flash_attn_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:h100:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

# Compile causal-conv1d + flash-attn against the env's torch on a GPU node.
# Login nodes have no nvcc → both packages fail to compile from sdist there.
#
# Lessons baked in (from earlier failed runs 22405883, 22405935):
#   * Both pip installs MUST use --no-build-isolation. Without it, pip creates a
#     fresh build env with its own (cu13!) torch, then setup.py fails with a
#     "CUDA 12.6 vs 13.0 mismatch" error. With --no-build-isolation, builds use
#     the env's torch 2.6.0+cu124 directly.
#   * flash-attn's setup.py downloads a prebuilt wheel and renames it across
#     filesystems → "Invalid cross-device link". Fix by setting TMPDIR to
#     somewhere on the same filesystem as ~/.cache/pip.
#   * `set -e` so a build failure halts the script (and shows clearly in sacct
#     state), rather than silently printing FLASH_GPU_DONE.

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1

# CUDA toolkit discovery — Snellius module names vary across collections; try a few.
# Final fallback hardcodes /usr/local/cuda which is the conventional system path.
NVCC_FOUND=0
for cuda_module in \
    "2024 CUDA/12.4.0" \
    "2025 CUDA/12.4.0" \
    "2024 CUDA/12.4.1" \
    "2025 CUDA/12.4.1" \
    "2024 CUDA/12.6.0" \
    "2025 CUDA/12.6.0"; do
    module load $cuda_module 2>/dev/null && { NVCC_FOUND=1; echo "loaded module: $cuda_module"; break; }
done
if [[ "$NVCC_FOUND" -eq 0 ]]; then
    for cuda_root in /usr/local/cuda /sw/arch/RHEL9/EB_production/2024/software/CUDA/12.4.0 /opt/nvidia/cuda; do
        if [[ -x "$cuda_root/bin/nvcc" ]]; then
            export CUDA_HOME="$cuda_root"
            export PATH="$cuda_root/bin:$PATH"
            export LD_LIBRARY_PATH="$cuda_root/lib64:${LD_LIBRARY_PATH:-}"
            echo "fallback CUDA_HOME=$cuda_root"
            NVCC_FOUND=1
            break
        fi
    done
fi
if [[ "$NVCC_FOUND" -eq 0 ]]; then
    echo "ERROR: could not find a CUDA toolkit / nvcc" >&2
    exit 1
fi

# Keep TMPDIR on the same filesystem as ~/.cache so flash-attn's setup.py rename
# doesn't hit "Invalid cross-device link".
mkdir -p "$HOME/.cache/pip-tmp"
export TMPDIR="$HOME/.cache/pip-tmp"

PIP="/home/pkarageorgis1/.conda/envs/robometer_qwen35_gpu/bin/pip"
PY="/home/pkarageorgis1/.conda/envs/robometer_qwen35_gpu/bin/python"

echo "[$(date)] env check"
$PY -c "import torch; print('torch:', torch.__version__, 'cuda:', torch.version.cuda, 'available:', torch.cuda.is_available())"
nvcc --version | head -3
echo "CUDA_HOME=${CUDA_HOME:-<unset>}"
echo "TMPDIR=$TMPDIR"

# Build deps for the --no-build-isolation path: setuptools + wheel + ninja must be in env.
$PIP install --upgrade --no-deps setuptools wheel ninja packaging

echo "[$(date)] causal-conv1d (sdist compile, --no-build-isolation, ~3 min)"
MAX_JOBS=4 $PIP install --no-build-isolation -U 'causal-conv1d>=1.4'

# Determine the cxx11abi setting of our torch build, so flash-attn compiles with
# the matching ABI. Earlier attempts hit "undefined symbol" because the prebuilt
# wheel auto-selector picked cxx11abiFALSE while torch was built with TRUE.
TORCH_ABI=$($PY -c 'import torch; print(int(torch._C._GLIBCXX_USE_CXX11_ABI))')
echo "torch._C._GLIBCXX_USE_CXX11_ABI = $TORCH_ABI"

# Uninstall any stale flash-attn first — `pip install -U` is a no-op if the same
# version is already installed, even if FLASH_ATTENTION_FORCE_BUILD=TRUE is set.
$PIP uninstall -y flash-attn 2>&1 || true

echo "[$(date)] flash-attn (FORCE source build, ABI-matched, ~15-20 min)"
# FLASH_ATTENTION_FORCE_BUILD=TRUE bypasses the prebuilt-wheel auto-download path
# (which caused both the cross-device link failure AND the cxx11abi mismatch in
# earlier attempts).
FLASH_ATTENTION_FORCE_BUILD=TRUE \
FLASH_ATTENTION_FORCE_CXX11_ABI="$TORCH_ABI" \
MAX_JOBS=4 \
    $PIP install --no-build-isolation --no-cache-dir -v flash-attn

echo "[$(date)] verify"
$PY -c "
import flash_attn; print('flash_attn:', flash_attn.__version__)
import causal_conv1d; print('causal_conv1d: imported')
import fla; print('fla: imported')
"

echo "[$(date)] FLASH_GPU_DONE"
