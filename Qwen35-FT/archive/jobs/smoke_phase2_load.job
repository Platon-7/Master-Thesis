#!/bin/bash
#SBATCH --job-name=smoke_phase2_load
#SBATCH --output=logs/smoke_phase2_load_%j.out
#SBATCH --error=logs/smoke_phase2_load_%j.err
#SBATCH --time=00:30:00
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH --ntasks-per-node=1
#SBATCH --mem=240G

# Single-node 4-GPU smoke to verify Phase 2 load-from-checkpoint works end-to-end:
#   1. Loads the consolidated HF checkpoint via train.py's load_from_checkpoint path
#   2. Builds RBM with base + heads loaded from the consolidated safetensors
#   3. Runs 2 training steps to verify forward + backward pass
#
# Uses the consolidated dir produced by the consolidate_phase1 smoke 22779443.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
QWEN35_DIR="${QWEN35_DIR:-$HERE}"
HF_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/scratch-shared/$USER/robometer_frames_hf_full_step2}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1

ENV_PREFIX="${ENV_PREFIX:-/home/pkarageorgis1/.conda/envs/robometer_qwen35_gpu}"
PYTHON="$ENV_PREFIX/bin/python"
ACCELERATE="$ENV_PREFIX/bin/accelerate"
[[ -x "$PYTHON" && -x "$ACCELERATE" ]] || { echo "ERROR: env missing at $ENV_PREFIX"; exit 1; }
export PATH="$ENV_PREFIX/bin:$PATH"

export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_DIR"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
unset WANDB_PROJECT WANDB_API_KEY WANDB_ENTITY
export WANDB_MODE=disabled

cd "$QWEN35_DIR"
export PYTHONPATH="$QWEN35_DIR:${PYTHONPATH:-}"

LOAD_FROM_CKPT="${LOAD_FROM_CKPT:-/scratch-shared/$USER/Qwen35_FT_consolidated_test/run4_22776712_step1000}"
if [[ ! -d "$LOAD_FROM_CKPT" ]]; then
    echo "ERROR: LOAD_FROM_CKPT dir not found: $LOAD_FROM_CKPT" >&2
    exit 1
fi

readarray -t OVERRIDES < <(
    grep -hv '^[[:space:]]*#' "$HERE/configs/train_base.yaml" "$HERE/configs/run4_icl_ours_phase2.yaml" \
      | sed -e 's/[[:space:]]*#.*//' \
      | grep -v '^[[:space:]]*$' \
      | sed -e 's/: */=/' -e 's/^/++/'
)

# Smoke overrides on top: 2 steps, no eval, no save
SMOKE=$(cat <<EOF
++training.load_from_checkpoint=$LOAD_FROM_CKPT
++training.max_steps=2
++training.per_device_train_batch_size=2
++training.do_eval=false
++training.evaluation_strategy=no
++training.save_strategy=no
++training.logging_steps=1
++custom_eval.eval_types=[]
++custom_eval.policy_ranking_dual_icl=false
++logging.log_to=[]
EOF
)
SMOKE_ARGS=$(echo "$SMOKE" | tr '\n' ' ')

WEIGHTS_DIR="/scratch-shared/$USER/Qwen35_FT_phase2_smoke/${SLURM_JOB_ID:-local}"
mkdir -p "$WEIGHTS_DIR"

echo "==================== phase2 load smoke ===================="
echo "LOAD_FROM_CKPT  : $LOAD_FROM_CKPT"
echo "WEIGHTS_DIR     : $WEIGHTS_DIR"
echo "GPUs            : 4 (single node)"
echo "max_steps       : 2"
echo "============================================================"

"$ACCELERATE" launch \
  --config_file configs/distributed/fsdp_qwen35.yaml \
  --num_processes=4 \
  train.py "${OVERRIDES[@]}" $SMOKE_ARGS \
  training.output_dir="$WEIGHTS_DIR"
RC=$?

echo
echo "==================== smoke exit ===================="
echo "rc=$RC"
exit $RC
