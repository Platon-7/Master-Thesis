Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

%labels
    Author P.Karageorgis
    Version 12.0 (DSRL + RoboReward - pandas/scipy pinned for numpy 1.21.6)

%environment
    export PATH="/opt/conda/envs/dsrl_env/bin:/opt/conda/bin:$PATH"
    # CRITICAL: Same as complete_env.def - use glfw, NOT egl
    export MUJOCO_GL="glfw"
    export LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"
    
    # Prevent PyTorch from eating 100% VRAM so RoboReward has space
    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

%post
    # --- 1. SYSTEM DEPENDENCIES (SAME AS complete_env.def) ---
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        wget git gcc g++ make cmake vim \
        xvfb \
        libgl1-mesa-dev \
        libgl1-mesa-glx \
        libglew-dev \
        libosmesa6-dev \
        libglfw3 \
        libglfw3-dev \
        patchelf \
        python3 python3-pip \
        ffmpeg \
        unzip

    # --- 2. INSTALL MINIFORGE (SAME AS complete_env.def) ---
    wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O miniforge.sh
    bash miniforge.sh -b -p /opt/conda
    rm miniforge.sh
    export PATH="/opt/conda/bin:$PATH"

    # --- 3. CREATE ENVIRONMENT ---
    conda create -n dsrl_env python=3.9 -y
    . /opt/conda/etc/profile.d/conda.sh
    conda activate dsrl_env

    # -----------------------------------------------------------
    # A. BUILD TOOLS (SAME AS complete_env.def)
    # -----------------------------------------------------------
    pip install setuptools==69.5.1 wheel
    pip install cmake==3.26.4 pybind11==2.10.4 pybind11-global==2.10.4

    # -----------------------------------------------------------
    # B. CORE DEPS
    # -----------------------------------------------------------
    pip install "cython<3"
    pip install "numpy<1.25"  # Will be pinned with numba at the end
    pip install glfw==1.11.2

    # -----------------------------------------------------------
    # C. PYTORCH (For RoboReward 8B + DSRL)
    # -----------------------------------------------------------
    pip install torch==2.4.0 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

    # -----------------------------------------------------------
    # D. MUJOCO & RENDERING (SAME VERSIONS AS complete_env.def)
    # -----------------------------------------------------------
    pip install pyopengl==3.1.7 mujoco==3.1.1

    # -----------------------------------------------------------
    # E. GYM/GYMNASIUM (SAME AS complete_env.def)
    # -----------------------------------------------------------
    pip install gym==0.25.2 gymnasium==0.29.1

    # -----------------------------------------------------------
    # F. ROBOSUITE - USE OLDER VERSION (1.3.2) that works with glfw
    # Version 1.4.x forces EGL which doesn't work on this cluster
    # -----------------------------------------------------------
    pip install robosuite==1.3.2

    # -----------------------------------------------------------
    # G. ROBOMIMIC (for DSRL environments)
    # -----------------------------------------------------------
    pip install robomimic==0.2.0

    # -----------------------------------------------------------
    # H. D4RL - REMOVED: Not needed for train_dsrl_vlm.py (robomimic tasks)
    # Only train_dsrl.py uses d4rl for gym_mujoco envs
    # -----------------------------------------------------------

    # -----------------------------------------------------------
    # I. DPPO DEPENDENCIES (from pyproject.toml)
    # -----------------------------------------------------------
    pip install \
        av==12.3.0 \
        einops==0.8.0 \
        gdown==5.2.0 \
        hydra-core==1.3.2 \
        imageio==2.35.1 \
        matplotlib==3.7.5 \
        omegaconf==2.3.0 \
        pretty_errors==1.2.25 \
        tqdm==4.66.5 \
        wandb==0.17.7

    # -----------------------------------------------------------
    # J. STABLE-BASELINES3 DEPENDENCIES
    # Pin pandas and scipy to versions compatible with numpy 1.21.6
    # -----------------------------------------------------------
    pip install \
        cloudpickle \
        "pandas<2.0" \
        "scipy<1.10" \
        "opencv-python<4.8" \
        pygame \
        "tensorboard>=2.9.1" \
        psutil \
        rich \
        pillow

    # -----------------------------------------------------------
    # K. ROBOREWARD 8B EXTRAS (VLM dependencies)
    # -----------------------------------------------------------
    pip install transformers accelerate qwen_vl_utils bitsandbytes

    # -----------------------------------------------------------
    # L. ADDITIONAL UTILITIES
    # -----------------------------------------------------------
    pip install h5py scipy imageio-ffmpeg

    # -----------------------------------------------------------
    # M. VISUALIZATION (SAME AS complete_env.def)
    # -----------------------------------------------------------
    pip install tensorboard matplotlib
    pip install "moviepy<2.0" "imageio<3.0" imageio-ffmpeg "Pillow<10.0.0"

    # -----------------------------------------------------------
    # N. NUMBA - Install LAST to ensure binary compatibility with numpy
    # robosuite 1.3.2 requires numba<=0.53.1,>=0.52.0
    # -----------------------------------------------------------
    pip install --force-reinstall numpy==1.21.6 numba==0.53.1 llvmlite==0.36.0

    # -----------------------------------------------------------
    # O. CLEANUP
    # -----------------------------------------------------------
    conda clean -a -y
    pip cache purge
