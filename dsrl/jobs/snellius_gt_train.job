#!/bin/bash
#SBATCH --job-name=dsrl_gt_lift
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.out
#SBATCH --time=48:00:00
#SBATCH --partition=gpu_a100       # Change to gpu_h100 if preferred
#SBATCH --gpus=1                   # Single GPU sufficient for GT rewards
#SBATCH --mem=40G
#SBATCH --cpus-per-task=12

# =========================================================
# DSRL Training with Ground Truth Rewards (Snellius)
# =========================================================
# Standard DSRL pipeline without VLM rewards.
# Uses ground truth rewards from the Robomimic environment.
#
# CUSTOMIZE BEFORE RUNNING:
#   - Set WANDB_API_KEY in your environment (or ~/.bashrc)
#   - Update CONTAINER path if your .sif is elsewhere
#   - Update REPO_DIR if your repo is elsewhere
# =========================================================

echo "========================================"
echo "DSRL Training (Ground Truth Rewards, Snellius)"
echo "========================================"
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURM_NODELIST"
echo "Start time: $(date)"
echo "========================================"

# --- 1. HOST SETUP ---
module load 2024
module load CUDA/12.6.0

# Scratch setup (Snellius standard)
export HF_HOME="$SCRATCH/hf_cache"
export TMPDIR="$SCRATCH/tmp"
mkdir -p "$HF_HOME" "$TMPDIR"

# Output directories
mkdir -p "$SCRATCH/dsrl_logs/robomimic-dsrl"

# --- 2. CUSTOMIZE THESE PATHS ---
REPO_DIR="$HOME/master-thesis"
CONTAINER="$SCRATCH/dsrl_roboreward.sif"

# --- 3. CONTAINER ENVIRONMENT VARS ---
export APPTAINERENV_HF_HOME="$HF_HOME"
# Set WANDB_API_KEY in your environment before submitting
export APPTAINERENV_WANDB_API_KEY="$WANDB_API_KEY"
export APPTAINERENV_WANDB_ENTITY="nlp-squad"

# Check GPU visibility
echo "=== GPU Check (outside container) ==="
nvidia-smi
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

# --- 4. MUJOCO SETUP ---
MUJOCO_DIR="$SCRATCH/.mujoco"
CONTAINER_MUJOCO_PATH="$HOME/.mujoco/mujoco210/bin"
export APP_LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$CONTAINER_MUJOCO_PATH:/usr/lib/nvidia"

# Writable mujoco-py setup (for compilation)
WRITABLE_MUJOCO_PY="$TMPDIR/mujoco_py_writable_dsrl"
mkdir -p "$WRITABLE_MUJOCO_PY"

if [ -z "$(ls -A "$WRITABLE_MUJOCO_PY")" ]; then
    echo "Extracting mujoco-py to writable scratch space..."
    apptainer exec --bind "$WRITABLE_MUJOCO_PY:/tmp/extract_zone" "$CONTAINER" \
        bash -c "cp -a /opt/conda/envs/dsrl_env/lib/python3.9/site-packages/mujoco_py/* /tmp/extract_zone/"
fi

cd "$REPO_DIR"

# --- 5. RUN TRAINING ---
apptainer exec --nv \
    --env LD_LIBRARY_PATH="$APP_LD_LIBRARY_PATH" \
    --env PYTHONNOUSERSITE=1 \
    --bind "$SCRATCH" \
    --bind "$MUJOCO_DIR:$HOME/.mujoco" \
    --bind "$WRITABLE_MUJOCO_PY:/opt/conda/envs/dsrl_env/lib/python3.9/site-packages/mujoco_py" \
    "$CONTAINER" bash -c "

    echo '=== GPU Check (inside container) ===' && \
    nvidia-smi && \

    source /opt/conda/etc/profile.d/conda.sh && \
    conda activate dsrl_env && \

    # Xvfb for headless rendering
    DISP_NUM=\$(( (\$SLURM_JOB_ID % 50) + 100 ))
    export DISPLAY=:\$DISP_NUM
    Xvfb \$DISPLAY -screen 0 1024x768x24 +extension GLX +render -noreset > /tmp/xvfb_dsrl_gt.log 2>&1 &
    XVFB_PID=\$!
    sleep 3

    # MuJoCo environment variables
    export MUJOCO_PY_MUJOCO_PATH=$HOME/.mujoco/mujoco210
    export MUJOCO_PY_LOCK_PATH=$TMPDIR/mujoco_lock

    # Disable numba JIT to avoid numpy/numba version conflict
    export NUMBA_DISABLE_JIT=1

    # Add local packages to PYTHONPATH
    export PYTHONPATH=$REPO_DIR/dsrl/stable-baselines3:$REPO_DIR/dsrl/dppo:\$PYTHONPATH

    python -c 'import torch; print(f\"PyTorch CUDA available: {torch.cuda.is_available()}\"); print(f\"GPU count: {torch.cuda.device_count()}\"); [print(f\"GPU {i}: {torch.cuda.get_device_name(i)}\") for i in range(torch.cuda.device_count())]' && \

    cd $REPO_DIR/dsrl && \

    python train_dsrl.py \
        --config-path=cfg/robomimic \
        --config-name=dsrl_lift.yaml \
        log_dir=$SCRATCH/dsrl_logs \
        seed=1

    kill \$XVFB_PID
"

echo "========================================"
echo "Job finished: $(date)"
echo "========================================"
