#!/bin/bash
#SBATCH --job-name=rbm_ft_resume_test
#SBATCH --output=logs/resume_selftest_%j.out
#SBATCH --error=logs/resume_selftest_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=spot-p4d-8gpu-a100,spot-p5-8gpu-h100-h200
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=8
#SBATCH --cpus-per-task=96
#SBATCH --exclusive
#SBATCH --requeue

# ============================================================================
# RESUME SELF-TEST — proves the prod auto-resume actually works end-to-end on this
# cluster/env, on the real 8-GPU FSDP topology. Two accelerate launches in ONE job:
#   PHASE 1: train 3 steps, save_steps=2  -> writes a NATIVE checkpoint-2 (FSDP SHARDED
#            via DCP: model + optimizer + scheduler + RNG + trainer_state).
#   (verify) the prod auto-resume recursive glob finds it + the dir has optimizer/distcp shards.
#   PHASE 2: resume_from_checkpoint=<that ckpt>, max_steps=5 -> must LOAD step 2 and continue
#            to step 5 (NOT restart from 0). This is the exact prod scenario (both
#            load_from_checkpoint=base AND resume_from_checkpoint=ckpt are set).
# ICL is OFF here (resume mechanics don't need it) to keep it fast.
#
#   cd Robometer-FT && sbatch -M research-partner-cluster jobs/resume_selftest_aws.job
# ============================================================================

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
HF_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/shared/home/$USER/robometer_frames_hf_full_step2}"

ENV_PREFIX="${ENV_PREFIX:-/shared/home/PKA4388/miniconda3/envs/robometer_gpu_fa2}"
ACCELERATE="$ENV_PREFIX/bin/accelerate"
[[ -x "$ENV_PREFIX/bin/python" && -x "$ACCELERATE" ]] || { echo "ERROR: env missing at $ENV_PREFIX" >&2; exit 1; }
export PATH="$ENV_PREFIX/bin:$PATH"

export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_DIR"
export ROBOMETER_FRAME_DATASET_ROOT="${ROBOMETER_FRAME_DATASET_ROOT:-/shared/home/PKA4388/robometer_frame_dataset}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-0}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
unset WANDB_PROJECT WANDB_API_KEY WANDB_ENTITY; export WANDB_MODE=disabled

NUM_NODES="${SLURM_NNODES:-1}"; GPUS_PER_NODE="${GPUS_PER_NODE:-8}"
TOTAL_PROCESSES=$(( NUM_NODES * GPUS_PER_NODE ))
RDZV_PORT=$(( 10000 + ${SLURM_JOB_ID:-0} % 50000 ))
NODE_LIST=( $(scontrol show hostnames "$SLURM_JOB_NODELIST") )
HEAD_NODE="${NODE_LIST[0]}"
HEAD_NODE_IP=$(srun --nodes=1 --ntasks=1 -w "$HEAD_NODE" hostname --ip-address | head -1)
export NCCL_ASYNC_ERROR_HANDLING=1 FI_PROVIDER=efa OMP_NUM_THREADS=1

readarray -t OVERRIDES < <(
    cat "$HERE/configs/train_base.yaml" "$HERE/configs/run1_icl_ours.yaml" \
      | grep -v '^[[:space:]]*#' | sed -e 's/[[:space:]]*#.*//' | grep -v '^[[:space:]]*$' \
      | sed -e 's/: */=/' -e 's/^/++/'
)

LOAD_FROM_CKPT="${LOAD_FROM_CKPT:-/shared/home/PKA4388/checkpoints/Robometer-4B}"
[[ -f "$LOAD_FROM_CKPT/config.json" ]] || { echo "ERROR: base ckpt incomplete at $LOAD_FROM_CKPT" >&2; exit 3; }

TEST="/shared/home/$USER/Robometer_FT_resume_test/${SLURM_JOB_ID:-local}"
rm -rf "$TEST"; mkdir -p "$TEST"
EXP=resume_selftest

# common args shared by both phases (ICL off, 8 frames, no eval/wandb, tiny batch)
COMMON="++data.use_icl=false ++data.icl_prob=0.0 ++data.max_frames=8 \
  ++training.per_device_train_batch_size=2 ++training.do_eval=false \
  ++training.evaluation_strategy=no ++custom_eval.eval_types=[] \
  ++custom_eval.policy_ranking_dual_icl=false ++logging.log_to=[] \
  ++training.save_strategy=steps ++training.save_steps=2 \
  ++training.load_from_checkpoint=$LOAD_FROM_CKPT ++training.exp_name=$EXP"

launch () {  # $* = extra overrides
    cd "$ROBOMETER_DIR"; export PYTHONPATH="$ROBOMETER_DIR:${PYTHONPATH:-}" ROBOMETER_DIR
    "$ACCELERATE" launch --config_file "$HERE/configs/distributed/fsdp.yaml" \
      --num_machines=1 --num_processes="$TOTAL_PROCESSES" --machine_rank=0 \
      --main_process_ip="$HEAD_NODE_IP" --main_process_port="$RDZV_PORT" \
      train.py "${OVERRIDES[@]}" $COMMON "$@" training.output_dir="$TEST"
}

echo "############ PHASE 1: train to step 3, save every 2 ############"
launch ++training.max_steps=3
P1=$?
echo "phase1 rc=$P1"

# Find the latest native checkpoint using the EXACT prod auto-resume logic
LATEST_STEP=-1; CKPT=""
while IFS= read -r d; do
  s="${d##*/checkpoint-}"
  if [[ "$s" =~ ^[0-9]+$ ]] && (( s > LATEST_STEP )); then LATEST_STEP=$s; CKPT="$d"; fi
done < <(find "$TEST" -maxdepth 3 -type d -name 'checkpoint-*' 2>/dev/null)

echo "############ CHECKPOINT DISCOVERY ############"
echo "found checkpoint: ${CKPT:-<NONE>} (step $LATEST_STEP)"
if [[ -z "$CKPT" ]]; then echo ">>> RESUME TEST FAILED: no native checkpoint written by save_steps"; exit 10; fi
echo "checkpoint contents (looking for optimizer / distcp shards / trainer_state):"
find "$CKPT" -maxdepth 2 | sed "s#$CKPT/##" | sort

echo "############ PHASE 2: resume from $CKPT, train to step 5 ############"
launch ++training.max_steps=5 ++training.resume_from_checkpoint="$CKPT"
P2=$?
echo "phase2 rc=$P2"

echo "==================== RESUME SELF-TEST SUMMARY ===================="
echo "phase1 rc=$P1  phase2 rc=$P2  checkpoint=$CKPT (step $LATEST_STEP)"
if [[ $P1 -eq 0 && $P2 -eq 0 && -n "$CKPT" ]]; then
    echo "RESUME SELF-TEST PASSED — native checkpoint written, found by prod glob, and resumed."
else
    echo "RESUME SELF-TEST FAILED (p1=$P1 p2=$P2 ckpt=$CKPT)"
fi
echo "================================================================="
[[ $P1 -eq 0 && $P2 -eq 0 && -n "$CKPT" ]]
