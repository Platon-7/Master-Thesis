#!/bin/bash
#SBATCH --job-name=rbm_abl_cache
#SBATCH --output=../logs/abl_origdata_cache_%j.out
#SBATCH --error=../logs/abl_origdata_cache_%j.err
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --account=gisr102108
#SBATCH --partition=staging

# Builds the loss-vs-data ablation's "origdata" train cache (see
# ABLATION_HANDOFF.md sec 4): subsets the merged train_no_extras step-2 cache
# down to upstream's own data treatment (drops our metaworld/failsafe/droid-
# failure additions, keeps everything else including the original archives'
# failures). Writes robometer_origdata_train straight into the existing
# step2 root so training can reach both it and the eval short-name symlinks
# via a single ROBOMETER_PROCESSED_DATASETS_PATH.
#
# Usage: sbatch jobs/build_origdata_cache.job   (run from Robometer-FT/ablation_origdata/)

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
ENV_PREFIX="${ENV_PREFIX:-/home/pkarageorgis/.conda/envs/robometer_gpu}"
PYTHON="$ENV_PREFIX/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: $PYTHON not executable" >&2
    exit 1
fi

echo "============================================================"
echo "[abl-cache] building robometer_origdata_train"
echo "============================================================"
"$PYTHON" build_origdata_cache.py

echo "[abl-cache] DONE"
