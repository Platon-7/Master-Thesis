#!/bin/bash
#SBATCH --job-name=repro_canon
#SBATCH --output=logs/repro_canon_%j.out
#SBATCH --error=logs/repro_canon_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${EVAL_ENV:?}" 2>/dev/null || true
PY="$HOME/.conda/envs/${EVAL_ENV}/bin/python"
[ -x "$PY" ] || { echo "ERROR: $PY not found"; exit 3; }
export PYTHONPATH="$HERE/vlm_ibrl:$HERE/Robometer:${PYTHONPATH:-}"
export MUJOCO_GL=egl
[ -n "${FORCE_FP32:-}" ] && export ROBOMETER_FORCE_FP32=1
"$PY" -c "import imageio.v3, av, datasets" 2>/dev/null || "$PY" -m pip install -q "imageio[pyav]" datasets 2>&1 | tail -2
echo "model=$MODEL_PATH ds=$DS out=$OUT fp32=${FORCE_FP32:-0} frames_dir=${FRAMES_DIR:-} maxf=${MAXF:-cfg}"
nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1
"$PY" reward-model-study/scripts/repro_canonical_eval.py --ds "$DS" --model "$MODEL_PATH" --out "$OUT" \
  ${LIMIT:+--limit $LIMIT} ${FRAMES_DIR:+--frames_dir "$FRAMES_DIR"} ${MAXF:+--max_frames $MAXF}
