#!/bin/bash
#SBATCH --job-name=rms_eval
#SBATCH --output=logs/rms_eval_%j.out
#SBATCH --error=logs/rms_eval_%j.err
#SBATCH --time=00:40:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ENV_NAME="${EVAL_ENV:?must set EVAL_ENV (robometer_gpu_fa2 or robometer_qwen35_gpu)}"
ROBOMETER_DIR="$HERE/Robometer"
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"
export PYTHONPATH="$HERE/vlm_ibrl:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL=egl
[ -n "${FORCE_FP32:-}" ] && export ROBOMETER_FORCE_FP32=1
echo "env=$ENV_NAME model=$MODEL_PATH dataset=$DATASET icl=${ICL:-off} fp32=${FORCE_FP32:-no}"
nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1
ICLFLAG=""; [ "${ICL:-off}" = "on" ] && ICLFLAG="--icl"
MAXFLAG=""; [ -n "${MAX_PER_SOURCE:-}" ] && MAXFLAG="--max-per-source ${MAX_PER_SOURCE}"
python reward-model-study/scripts/eval_dump.py \
    --model-path "$MODEL_PATH" --dataset "$DATASET" $ICLFLAG $MAXFLAG --out "$OUT"
