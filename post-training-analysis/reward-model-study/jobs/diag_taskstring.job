#!/bin/bash
#SBATCH --job-name=diag_tstr
#SBATCH --output=logs/diag_tstr_%j.out
#SBATCH --error=logs/diag_tstr_%j.err
#SBATCH --time=01:30:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate robometer_gpu_fa2
PY="$HOME/.conda/envs/robometer_gpu_fa2/bin/python"
export PYTHONPATH="$PWD/vlm_ibrl:$PWD/Robometer:${PYTHONPATH:-}"
export MUJOCO_GL=egl
nvidia-smi --query-gpu=name --format=csv,noheader | head -1
"$PY" reward-model-study/scripts/diag_taskstring_icl.py
