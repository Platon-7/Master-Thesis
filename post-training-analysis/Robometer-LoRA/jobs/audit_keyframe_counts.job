#!/bin/bash
#SBATCH --job-name=rbm_audit
#SBATCH --output=logs/audit_%j.out
#SBATCH --error=logs/audit_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=staging
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G

# Deep-dive audit of /projects/prjs1958/robometer_frame_dataset/.
# Counts actual JPGs per episode in keyframes/ tar shards; cross-references
# against manifest's n_keyframes and len(frame_labels). Outputs flagged
# rows to /scratch-shared/$USER/dataset_audit_report.tsv.
#
# Expected runtime: 5-15 min (665k episodes, ~few hundred tar shards).

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: $PYTHON not executable" >&2
    exit 1
fi

mkdir -p logs

echo "[audit] starting at $(date)"
echo "[audit] node: $(hostname)"
echo "[audit] CPUs: $(nproc)"

"$PYTHON" scripts/audit_keyframe_counts.py

echo "[audit] done at $(date)"
echo ""
echo "=== summary preview ==="
cat "/scratch-shared/$USER/dataset_audit_summary.txt" 2>/dev/null || echo "(summary file not found)"
