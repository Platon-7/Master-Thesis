#!/bin/bash
#SBATCH --job-name=rbm_lora
#SBATCH --output=logs/train_%j_%x.out
#SBATCH --error=logs/train_%j_%x.err
#SBATCH --time=12:00:00
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
LOSS_ID="${LOSS_ID:?set LOSS_ID}" bash scripts/train_one.sh
