#!/bin/bash
#SBATCH --job-name=norm_droid
#SBATCH --output=logs/norm_droid_%j.out
#SBATCH --error=logs/norm_droid_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_mig
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G

# Repack droid layout in the scratch copy to match other families' format.
# Operates on /scratch-shared/$USER/robometer_frame_dataset_<TS>/droid only.
# Writes new per-archive tars + per-archive manifests; backs up old shards/
# as shards.bak_pre_norm/ for safety.
#
# Expected runtime: ~10-20 min (9GB across 6 keyframe dirs).

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"

mkdir -p logs

echo "[norm_droid] start: $(date)"
echo "[norm_droid] node: $(hostname)"

# Run dry-run first to print the plan, then live
echo ""
echo "============================ DRY RUN ============================"
"$PYTHON" scripts/normalize_droid.py --dry-run 2>&1 | head -100

echo ""
echo "============================ LIVE RUN ============================"
"$PYTHON" scripts/normalize_droid.py

echo "[norm_droid] done: $(date)"
