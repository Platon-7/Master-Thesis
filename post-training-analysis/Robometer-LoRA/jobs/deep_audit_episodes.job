#!/bin/bash
#SBATCH --job-name=rbm_deep_audit
#SBATCH --output=logs/deep_audit_%j.out
#SBATCH --error=logs/deep_audit_%j.err
#SBATCH --time=02:30:00
#SBATCH --account=gusei17535
#SBATCH --partition=staging
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G

# Deep per-episode audit. Opens every tar, counts JPGs per episode, decodes
# a sampled JPG to verify file integrity, cross-references with pairs_unified
# and per-row frame_labels. Expected runtime: 30-90 min for 671k episodes.
# Issues logged to /scratch-shared/$USER/dataset_deep_audit.tsv.

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"

mkdir -p logs

export AUDIT_ROOT="/scratch-shared/pkarageorgis1/robometer_frame_dataset_20260505_164035"

echo "[deep-audit] start: $(date)"
echo "[deep-audit] node: $(hostname)"
echo "[deep-audit] CPUs: $(nproc)"
echo "[deep-audit] AUDIT_ROOT=$AUDIT_ROOT"

"$PYTHON" scripts/deep_audit_episodes.py

echo "[deep-audit] done: $(date)"
echo ""
echo "=== summary preview ==="
cat "/scratch-shared/$USER/dataset_deep_audit_summary.txt" 2>/dev/null || echo "(summary not found)"
