#!/bin/bash
#SBATCH --job-name=inspect_all
#SBATCH --output=/home/pkarageo/master-thesis/Robo-Reward-FPS/logs/inspect_all_datasets_%j.txt
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=00:30:00

# Activate Conda
source $(conda info --base)/etc/profile.d/conda.sh
conda activate /var/scratch/pkarageo/conda_envs/roboreward

# Environment setup
export HF_HOME="/var/scratch/pkarageo/hf_cache"
export HF_HUB_OFFLINE=0

echo "============================================"
echo "RoboReward ALL Datasets Inspection"
echo "============================================"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "============================================"

# Run inspection
python -u /home/pkarageo/master-thesis/Robo-Reward-FPS/scripts/inspect_roboreward_dataset.py

echo "============================================"
echo "Inspection completed at: $(date)"
echo "============================================"
