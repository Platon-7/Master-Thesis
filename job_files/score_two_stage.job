#!/bin/bash
#SBATCH --job-name=score_2s
#SBATCH --output=/home/pkarageo/master-thesis/Robo-Reward-FPS/logs/score_two_stage_%j.txt
#SBATCH --partition=defq
#SBATCH --constraint=TitanRTX
#SBATCH --gres=gpu:2
#SBATCH --mem=64G
#SBATCH --cpus-per-task=4
#SBATCH --time=120:00:00

module load cuda12.6/toolkit/12.6

source $(conda info --base)/etc/profile.d/conda.sh
conda activate /var/scratch/pkarageo/conda_envs/roboreward

export HF_HOME="/var/scratch/pkarageo/hf_cache"
export TORCH_HOME="/var/scratch/pkarageo/torch_cache"
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export FORCE_QWENVL_VIDEO_READER=decord

echo "============================================"
echo "Two-stage scoring: VLM + LLM"
echo "  GPU 0: Qwen3-VL-8B (bf16, no quantization)"
echo "  GPU 1: Qwen3-32B (NF4 4-bit)"
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "============================================"

nvidia-smi

python /home/pkarageo/master-thesis/Robo-Reward-FPS/droid_failures/score_two_stage.py --sample 500

echo "============================================"
echo "Done at: $(date)"
echo "============================================"
