#!/bin/bash
#SBATCH --job-name=vid_vs_frames
#SBATCH --output=/home/pkarageo/master-thesis/Robo-Reward-FPS/logs/investigate_video_vs_frames_%j.txt
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00

# Load CUDA
module load cuda12.6/toolkit/12.6

# Activate Conda
source $(conda info --base)/etc/profile.d/conda.sh
conda activate /var/scratch/pkarageo/conda_envs/roboreward

# Environment setup
export HF_HOME="/var/scratch/pkarageo/hf_cache"
export TORCH_HOME="/var/scratch/pkarageo/torch_cache"
export FORCE_QWENVL_VIDEO_READER=torchvision

# Debug Info
echo "============================================"
echo "Investigate: Video (MP4) vs List of Frames"
echo "============================================"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "============================================"

# Run investigation
python -u /home/pkarageo/master-thesis/Robo-Reward-FPS/scripts/investigate_video_vs_frames.py

echo "============================================"
echo "Investigation completed at: $(date)"
echo "============================================"
