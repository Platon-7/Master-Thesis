#!/bin/bash
#SBATCH --job-name=score_eps
#SBATCH --output=/home/pkarageo/master-thesis/Robo-Reward-FPS/logs/score_episodes_%j.txt
#SBATCH --partition=defq
#SBATCH --constraint=TitanRTX
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#SBATCH --cpus-per-task=4
#SBATCH --time=120:00:00

module load cuda12.6/toolkit/12.6

source $(conda info --base)/etc/profile.d/conda.sh
conda activate /var/scratch/pkarageo/conda_envs/roboreward

export HF_HOME="/var/scratch/pkarageo/hf_cache"
export TORCH_HOME="/var/scratch/pkarageo/torch_cache"
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export FORCE_QWENVL_VIDEO_READER=decord

echo "============================================"
echo "Score DROID episodes with RoboReward-8B"
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "Skip verify: ${SKIP_VERIFY:-no}"
echo "============================================"

nvidia-smi

EXTRA_ARGS=""
if [ "${SKIP_VERIFY}" = "yes" ]; then
    EXTRA_ARGS="--skip-verify"
fi

python /home/pkarageo/master-thesis/Robo-Reward-FPS/droid_failures/score_episodes.py \
    --device cuda:0 \
    ${EXTRA_ARGS}

echo "============================================"
echo "Done at: $(date)"
echo "============================================"
