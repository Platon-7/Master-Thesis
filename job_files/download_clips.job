#!/bin/bash
#SBATCH --job-name=download_clips
#SBATCH --output=/home/pkarageo/master-thesis/Robo-Reward-FPS/logs/download_clips_%j.txt
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=08:00:00

# Activate Conda
source $(conda info --base)/etc/profile.d/conda.sh
conda activate /var/scratch/pkarageo/conda_envs/roboreward

# Environment setup
export HF_HOME="/var/scratch/pkarageo/hf_cache"

# Debug Info
echo "============================================"
echo "RoboReward Temporal Clip Downloader"
echo "============================================"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "============================================"

# Create output directories
mkdir -p /var/scratch/pkarageo/roboreward_video_completion
mkdir -p /home/pkarageo/master-thesis/Robo-Reward-FPS/logs

# Run downloader (resume-capable)
python -u /home/pkarageo/master-thesis/Robo-Reward-FPS/scripts/download_temporal_clips.py \
    --output-dir /var/scratch/pkarageo/roboreward_video_completion \
    --metadata-dir /var/scratch/pkarageo/roboreward_dataset \
    --workers 4

echo "============================================"
echo "Download completed at: $(date)"
echo "============================================"
