#!/bin/bash
#SBATCH --job-name=download_robometer_full
#SBATCH --output=/home/pkarageorgis/DAS-5/Master-Thesis/Real-World-Failures/robometer_failures/download_robometer_full_%a_%j.out
#SBATCH --partition=rome
#SBATCH --mem=24G
#SBATCH --cpus-per-task=4
#SBATCH --time=24:00:00
#SBATCH --array=0-3

set -euo pipefail

source $(conda info --base)/etc/profile.d/conda.sh
conda activate qwen_host

export PYTHONUNBUFFERED=1

# Prefer pre-exported HF_TOKEN. Fallback to local Hugging Face CLI token file.
if [[ -z "${HF_TOKEN:-}" && -f "$HOME/.cache/huggingface/token" ]]; then
  export HF_TOKEN="$(cat "$HOME/.cache/huggingface/token")"
fi

if [[ -z "${HF_TOKEN:-}" ]]; then
  echo "ERROR: HF_TOKEN is not set and no $HOME/.cache/huggingface/token was found"
  exit 1
fi

SCRIPT="/home/pkarageorgis/DAS-5/Master-Thesis/Real-World-Failures/robometer_failures/download_full_robometer_dataset.py"
DEST="/scratch-shared/pkarageorgis/robometer_full_dataset"
NUM_SHARDS=4
SHARD_INDEX=${SLURM_ARRAY_TASK_ID:-0}

echo "============================================"
echo "RoboMeter full dataset download"
echo "  Script: $SCRIPT"
echo "  Dest:   $DEST"
echo "  Shard:  $((SHARD_INDEX + 1))/$NUM_SHARDS"
echo "  Node:   $(hostname)"
echo "  Job:    $SLURM_JOB_ID"
echo "  Date:   $(date)"
echo "============================================"

python "$SCRIPT" \
  --dest "$DEST" \
  --adopt-from /scratch-shared/pkarageorgis \
  --adopt-mode hardlink \
  --workers 2 \
  --num-shards "$NUM_SHARDS" \
  --shard-index "$SHARD_INDEX" \
  --retries 8 \
  --timeout 180 \
  --chunk-mb 8

echo ""
echo "Done at: $(date)"
