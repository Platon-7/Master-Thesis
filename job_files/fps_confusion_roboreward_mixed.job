#!/bin/bash
#SBATCH --job-name=fps_rr_mixed
#SBATCH --output=/home/pkarageo/master-thesis/Robo-Reward-FPS/logs/fps_confusion_roboreward_mixed_%j.txt
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --constraint=TitanRTX
#SBATCH --time=08:00:00

# Load CUDA
module load cuda12.6/toolkit/12.6

# Activate Conda
source $(conda info --base)/etc/profile.d/conda.sh
conda activate /var/scratch/pkarageo/conda_envs/roboreward

# Environment setup
export HF_HOME="/var/scratch/pkarageo/hf_cache"
export TORCH_HOME="/var/scratch/pkarageo/torch_cache"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export FORCE_QWENVL_VIDEO_READER=torchvision

# Debug Info
echo "============================================"
echo "FPS Confusion Matrix - RoboReward (MIXED TASKS)"
echo "============================================"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)"
echo "Task Slug: ${TASK_SLUG:-droid_general}"
echo "Note: Using per-video task instructions from samples.json"
echo "============================================"

# Create results directory
mkdir -p /var/scratch/pkarageo/roboreward_results

# Run mixed-task experiment
# This version reads task instructions from samples.json for each video
# FPS values limited to 2, 5, 10 (valid for 10 FPS native videos)
python -u /home/pkarageo/master-thesis/Robo-Reward-FPS/scripts/fps_confusion_matrix_experiment_mixed.py \
    --task-slug "${TASK_SLUG:-droid_general}" \
    --fps-values 2.0 5.0 10.0

echo "============================================"
echo "Experiment completed at: $(date)"
echo "============================================"
