#!/bin/bash
#SBATCH --job-name=norm_droid_st
#SBATCH --output=logs/norm_droid_%j.out
#SBATCH --error=logs/norm_droid_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=staging
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"
mkdir -p logs
echo "[norm_droid-staging] start: $(date)"; echo "node: $(hostname)"
"$PYTHON" scripts/normalize_droid.py
echo "[norm_droid-staging] done: $(date)"
