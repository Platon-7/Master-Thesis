#!/bin/bash
#SBATCH --job-name=rbm_eval_test
#SBATCH --output=logs/eval_test_%j_%x.out
#SBATCH --error=logs/eval_test_%j_%x.err
#SBATCH --time=04:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:h100:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G

# Eval-only run on the held-out test set, for one of three models:
#   MODEL=baseline   → Robometer-4B published checkpoint, no LoRA
#   MODEL=loss1      → our LoRA + CORN asymmetric loss
#   MODEL=loss2      → our LoRA + Chris's asymmetric C51 + BCE loss
#
# Optional: LIMIT=4 (or any small int) for a dry-run that caps policy_ranking_max_tasks
# so we can verify head detection + JSON dumps in <10 min before queueing the full runs.
#
# Usage:
#   MODEL=baseline sbatch jobs/eval_test_set.job
#   MODEL=loss1    sbatch jobs/eval_test_set.job
#   MODEL=loss2    sbatch jobs/eval_test_set.job
#   MODEL=baseline LIMIT=4 sbatch jobs/eval_test_set.job   # dry run

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
HF_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/projects/prjs1958/robometer_frames_hf}"

MODEL="${MODEL:?set MODEL=baseline|loss1|loss2}"
LIMIT="${LIMIT:-}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: "$PYTHON" interpreter not executable at $PYTHON — likely an NFS-mount issue on this node" >&2
    exit 1
fi

export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_DIR"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export WANDB_MODE="${WANDB_MODE:-offline}"   # eval-only, don't pollute wandb
export WANDB_PROJECT="${WANDB_PROJECT:-Robometer_LoRA_test_eval}"

cd "$ROBOMETER_DIR"

# ICL_ON=1 → re-eval with a successful demo trajectory prepended to every paired sample
# (icl_prob=1.0, pairs_index_path → pairs_index_<ICL_SPLIT>.jsonl). Lands in a separate output
# tree so the existing ICL-off baseline numbers stay untouched. The progress_policy_ranking
# eval sampler now calls _maybe_attach_icl_context, so demos actually fire at eval time
# (it didn't before — eval samples were silently ICL-off even when the train sampler had ICL on).
#
# ICL_SPLIT picks which split to evaluate on (default: test). Use eval_robometer to get a
# pair index that contains both success→success and failure→success pairings — lets us
# test whether the demo correctly raises P on real successes (the only split where we can).
ICL_ON="${ICL_ON:-0}"
ICL_SPLIT="${ICL_SPLIT:-test}"
if [[ "$ICL_ON" == "1" ]]; then
    OUT_BASE="/projects/prjs1958/LoRA_weights/test_eval_icl_${ICL_SPLIT}"
    if [[ "$ICL_SPLIT" == "test" ]]; then
        # Backward-compat: keep the original "test" run in the legacy path
        OUT_BASE="/projects/prjs1958/LoRA_weights/test_eval_icl"
    fi
else
    OUT_BASE="/projects/prjs1958/LoRA_weights/test_eval"
fi
mkdir -p "$OUT_BASE"

# Per-model dispatcher: loss preset choice + checkpoint path + extra overrides
case "$MODEL" in
  baseline)
    PRESET="$HERE/configs/loss2_c51.yaml"   # baseline uses C51 head — same as Robometer-4B
    RESUME_OVERRIDE=""                      # no LoRA / no resume → published weights only
    EXTRA_MODEL=""                          # baseline keeps default head config
    ;;
  loss1)
    PRESET="$HERE/configs/loss1_corn.yaml"
    DEFAULT_CKPT="/projects/prjs1958/LoRA_weights/loss1_22244008/robometer_lora_loss1_corn_asymmetric/checkpoint-7500"
    CKPT_PATH="${CKPT_OVERRIDE:-$DEFAULT_CKPT}"
    RESUME_OVERRIDE="++training.resume_from_checkpoint=$CKPT_PATH"
    EXTRA_MODEL=""
    ;;
  loss2)
    PRESET="$HERE/configs/loss2_c51.yaml"
    DEFAULT_CKPT="/projects/prjs1958/LoRA_weights/loss2_22244009/robometer_lora_loss2_c51_asymmetric/checkpoint-7500"
    CKPT_PATH="${CKPT_OVERRIDE:-$DEFAULT_CKPT}"
    RESUME_OVERRIDE="++training.resume_from_checkpoint=$CKPT_PATH"
    EXTRA_MODEL=""
    ;;
  *)
    echo "ERROR: MODEL must be one of: baseline, loss1, loss2" >&2; exit 2;;
esac

# When CKPT_OVERRIDE is set, infer a step suffix from the checkpoint path so per-step
# evals don't overwrite each other. Default suffix '' = step-7500 final result.
CKPT_SUFFIX=""
if [[ -n "${CKPT_OVERRIDE:-}" ]]; then
    CKPT_SUFFIX="_$(basename $CKPT_OVERRIDE | grep -oE 'step[=-][0-9]+' | grep -oE '[0-9]+' || basename $CKPT_OVERRIDE | tr -dc '0-9')"
fi
OUTPUT_DIR="$OUT_BASE/${MODEL}${CKPT_SUFFIX}"
mkdir -p "$OUTPUT_DIR"

# Build base+preset overrides (same yaml→CLI converter as the training jobs).
readarray -t OVERRIDES < <(
    grep -hv '^[[:space:]]*#' "$HERE/configs/train_lora_base.yaml" "$PRESET" \
      | sed -e 's/[[:space:]]*#.*//' \
      | grep -v '^[[:space:]]*$' \
      | sed -e 's/: */=/' -e 's/^/++/'
)

# Add the held-out test split to BOTH the standard and custom-eval dataset lists. Inline
# brackets, no spaces — the converter splits on '=' once and passes the rest to Hydra as a
# list literal.
TEST_OVERRIDES=(
    "++data.eval_datasets=[robometer_frames_eval_droid,robometer_frames_eval_robometer,robometer_frames_eval_metaworld,robometer_frames_eval_failsafe,robometer_frames_test]"
    "++custom_eval.policy_ranking=[robometer_frames_eval_droid,robometer_frames_eval_robometer,robometer_frames_eval_metaworld,robometer_frames_eval_failsafe,robometer_frames_test]"
)

ICL_OVERRIDES=()
if [[ "$ICL_ON" == "1" ]]; then
    # icl_min_coverage=0.0 disables the drift sniff for this eval. The framework still
    # instantiates the *train* sampler at eval time (mode=evaluate doesn't skip dataset
    # build), and that sampler will see ~0% partner coverage when its HF train pool is
    # pointed at pairs_index_test.jsonl — a false positive. The drift check is a training-
    # time guard; we don't need it at eval. Train-time runs keep the default 0.40 floor.
    #
    # Restrict to a single split — ICL doubles sequence length (16 demo + 16 query)
    # which OOM-killed previous attempts at per_device_eval_batch_size=16. Also we point
    # the pair index at one split, so other splits would run ICL-off (no demos available)
    # and just burn compute. Drop them.
    ICL_DATASET_NAME="robometer_frames_${ICL_SPLIT}"
    ICL_OVERRIDES=(
        "++data.use_icl=true"
        "++data.icl_prob=1.0"
        "++data.pairs_index_path=/scratch-shared/pkarageorgis1/robometer_frames_splits/pairs_index_${ICL_SPLIT}.jsonl"
        "++data.icl_min_coverage=0.0"
        "++data.eval_datasets=[${ICL_DATASET_NAME}]"
        "++custom_eval.policy_ranking=[${ICL_DATASET_NAME}]"
        "++training.per_device_eval_batch_size=4"
    )
    echo "[eval] ICL_ON=1  ICL_SPLIT=${ICL_SPLIT}  →  every paired sample gets a demo; eval batch=4"
fi

DRY_RUN_OVERRIDES=()
if [[ -n "$LIMIT" ]]; then
    # Dry-run: cap policy_ranking_max_tasks so a full pass takes <10 min per dataset
    DRY_RUN_OVERRIDES=(
        "++custom_eval.policy_ranking_max_tasks=$LIMIT"
        "++custom_eval.num_examples_per_quality_pr=2"
    )
    echo "[dry-run] LIMIT=$LIMIT — capping policy_ranking_max_tasks and num_examples_per_quality_pr"
fi

# Mode override + output dir per model
COMMON_OVERRIDES=(
    "++mode=evaluate"
    "training.output_dir=$OUTPUT_DIR"
    "++training.overwrite_output_dir=true"
    "logging.wandb_entity=nlp-squad"
)

echo "[eval] MODEL=$MODEL  output=$OUTPUT_DIR"
echo "[eval] resume override: ${RESUME_OVERRIDE:-<none, baseline>}"

"$PYTHON" train.py "${OVERRIDES[@]}" "${TEST_OVERRIDES[@]}" "${COMMON_OVERRIDES[@]}" \
    ${RESUME_OVERRIDE:+"$RESUME_OVERRIDE"} \
    ${ICL_OVERRIDES[@]+"${ICL_OVERRIDES[@]}"} \
    ${DRY_RUN_OVERRIDES[@]+"${DRY_RUN_OVERRIDES[@]}"} \
    $EXTRA_MODEL
