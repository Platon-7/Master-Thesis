#!/bin/bash
#SBATCH --job-name=rbm_concat
#SBATCH --output=logs/concat_%j.out
#SBATCH --error=logs/concat_%j.err
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --account=gisr102108
#SBATCH --partition=staging

# Concat-only stage of step 2 (train split). Merges the per-shard train _raw
# outputs into $STEP1_DIR/train_raw/. Both step 2 train preprocess and step 2
# no_extras depend on this, then run in parallel.
#
# Usage:
#   STEP1_DIR=...  N_SHARDS=16  ENV_PREFIX=...
#   sbatch --dependency=afterok:<train_array_jid> jobs/step2_concat_only.job

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"

STEP1_DIR="${STEP1_DIR:?set STEP1_DIR}"
N_SHARDS="${N_SHARDS:-16}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
ENV_PREFIX="${ENV_PREFIX:-/home/pkarageorgis/.conda/envs/robometer_gpu}"
PYTHON="$ENV_PREFIX/bin/python"

echo "============================================================"
echo "concat-only: merging $N_SHARDS train shards into $STEP1_DIR/train_raw/"
echo "============================================================"

"$PYTHON" "$HERE/scripts/concat_split_shards.py" \
    --hf-out-dir "$STEP1_DIR" \
    --split train \
    --n-shards "$N_SHARDS"

echo "[concat] DONE"
