#!/bin/bash
#SBATCH --job-name=rbm_step2_train
#SBATCH --output=logs/step2_train_%j.out
#SBATCH --error=logs/step2_train_%j.err
#SBATCH --time=15:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --account=gisr102108
#SBATCH --partition=staging

# Step 2 preprocess for the TRAIN split (no concat — that lives in
# step2_concat_only.job, which this job depends on). Runs preprocess_datasets,
# then creates the short-name symlink. Designed to run in parallel with
# step2_no_extras after the concat finishes.

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"

SPLITS_DIR="${SPLITS_DIR:?set SPLITS_DIR}"
STEP1_DIR="${STEP1_DIR:?set STEP1_DIR}"
HF_OUT_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:?set ROBOMETER_PROCESSED_DATASETS_PATH}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
ENV_PREFIX="${ENV_PREFIX:-/home/pkarageorgis/.conda/envs/robometer_gpu}"
PYTHON="$ENV_PREFIX/bin/python"

export ROBOMETER_DATASET_PATH="${ROBOMETER_DATASET_PATH:-/projects/prjs1958/robometer_frame_dataset}"
export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_OUT_DIR"
export HF_DIR="$STEP1_DIR"
export SPLIT="train"

echo "============================================================"
echo "step 2 preprocess (train)"
echo "  STEP1_DIR  : $STEP1_DIR"
echo "  HF_OUT_DIR : $HF_OUT_DIR"
echo "============================================================"

TMP_PP_YAML="$(mktemp --suffix=.yaml)"
trap 'rm -f "$TMP_PP_YAML"' EXIT
sed -e "s|\${oc.env:HF_DIR}|$STEP1_DIR|g" \
    -e "s|\${oc.env:SPLIT}|train|g" \
    -e "s|\${oc.env:ROBOMETER_PROCESSED_DATASETS_PATH}|$HF_OUT_DIR|g" \
    "$HERE/configs/preprocess_split.yaml" > "$TMP_PP_YAML"
cat "$TMP_PP_YAML"

cd "$ROBOMETER_DIR"
"$PYTHON" -m robometer.data.scripts.preprocess_datasets \
    --config "$TMP_PP_YAML" \
    --cache_dir "$HF_OUT_DIR"

# Short-name symlink the loader expects
HASHED="${STEP1_DIR//\//_}_train_raw_robometer_frames_train"
SHORT="robometer_frames_train"
if [[ -d "$HF_OUT_DIR/$HASHED" ]]; then
    ln -sfn "$HASHED" "$HF_OUT_DIR/$SHORT"
    echo "linked $HF_OUT_DIR/$SHORT -> $HASHED"
else
    echo "WARN: expected hashed cache dir not found at $HF_OUT_DIR/$HASHED"
fi

echo "[step 2 train] DONE"
