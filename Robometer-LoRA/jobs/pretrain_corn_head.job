#!/bin/bash
#SBATCH --job-name=corn_pretrain
#SBATCH --output=logs/corn_pretrain_%j.out
#SBATCH --error=logs/corn_pretrain_%j.err
#SBATCH --time=04:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:h100:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G

# CORN head pretraining (Apr-30). Trains a fresh 4-logit CORN head on the same data
# the LoRA bake-off uses, with the backbone fully frozen and LoRA disabled. The
# resulting head.state_dict gets loaded by loss1_corn.yaml ablations so they don't
# start from random init. See configs/corn_head_pretrain.yaml for full rationale.
#
# Usage: sbatch jobs/pretrain_corn_head.job

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
HF_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/projects/prjs1958/robometer_frames_hf}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: "$PYTHON" interpreter not executable at $PYTHON — likely an NFS-mount issue on this node" >&2
    exit 1
fi

export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_DIR"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export WANDB_PROJECT="${WANDB_PROJECT:-Robometer_LoRA_pretrain}"
export WANDB_API_KEY="${WANDB_API_KEY:-}"
export WANDB_ENTITY="${WANDB_ENTITY:-nlp-squad}"

cd "$ROBOMETER_DIR"

# Build hydra overrides from base + corn_head_pretrain configs (same converter the
# train jobs use). The pretrain config already overrides all the relevant LoRA-
# specific settings from the base.
readarray -t OVERRIDES < <(
    grep -hv '^[[:space:]]*#' "$HERE/configs/train_lora_base.yaml" "$HERE/configs/corn_head_pretrain.yaml" \
      | sed -e 's/[[:space:]]*#.*//' \
      | grep -v '^[[:space:]]*$' \
      | sed -e 's/: */=/' -e 's/^/++/'
)

WEIGHTS_DIR="${WEIGHTS_DIR:-/projects/prjs1958/LoRA_weights}"
OUT_DIR="$WEIGHTS_DIR/corn_head_pretrain_${SLURM_JOB_ID:-local}"
mkdir -p "$OUT_DIR"

ENTITY_OVERRIDE=""
if [[ -n "$WANDB_ENTITY" ]]; then
    ENTITY_OVERRIDE="logging.wandb_entity=$WANDB_ENTITY"
fi

EXTRA="${EXTRA:-}"

echo "[corn_pretrain] output: $OUT_DIR"
"$PYTHON" train.py "${OVERRIDES[@]}" $ENTITY_OVERRIDE $EXTRA \
  training.output_dir="$OUT_DIR"
