#!/bin/bash
#SBATCH --job-name=rbm_audit_st
#SBATCH --output=logs/audit_%j.out
#SBATCH --error=logs/audit_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=staging
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G

# Audit JPG counts vs manifest claims on the SCRATCH COPY (not /projects/).
# Reads scripts/audit_keyframe_counts.py with AUDIT_ROOT pointing at the
# normalized scratch copy. Read-only — does not modify any data.

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"

mkdir -p logs

export AUDIT_ROOT="/scratch-shared/pkarageorgis1/robometer_frame_dataset_20260505_164035"

echo "[audit-staging] starting at $(date)"
echo "[audit-staging] node: $(hostname)"
echo "[audit-staging] CPUs: $(nproc)"
echo "[audit-staging] AUDIT_ROOT=$AUDIT_ROOT"

"$PYTHON" scripts/audit_keyframe_counts.py

echo "[audit-staging] done at $(date)"
echo ""
echo "=== summary preview ==="
cat "/scratch-shared/$USER/dataset_audit_summary.txt" 2>/dev/null || echo "(summary file not found)"
