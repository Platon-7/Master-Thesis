#!/bin/bash
#SBATCH --job-name=rbm_loss1
#SBATCH --output=logs/train_loss1_%j.out
#SBATCH --error=logs/train_loss1_%j.err
#SBATCH --time=72:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:h100:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G

# Loss 1 training run (Chris-disjoint variant: asymmetric CORN ordinal loss).
#
# Apply both Hydra config files: the shared base + the loss1 preset.
# Pass `MAX_STEPS=10` env to do a smoke run; default is what's in train_lora_base.yaml.
#
# Usage:
#   sbatch jobs/train_loss1.job
#   MAX_STEPS=10 sbatch jobs/train_loss1.job   # smoke
#   EXTRA="data.icl_prob=0.0" sbatch jobs/train_loss1.job   # ablate ICL

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
HF_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/projects/prjs1958/robometer_frames_hf}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: "$PYTHON" interpreter not executable at $PYTHON — likely an NFS-mount issue on this node" >&2
    exit 1
fi

export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_DIR"
# expandable_segments handles fragmentation that builds up across eval passes (each eval
# allocates and frees big attention buffers; without expandable segments, training-side
# allocs of similar size can't slot back into the freed-but-fragmented chunks → OOM).
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export WANDB_PROJECT="${WANDB_PROJECT:-Robometer_LoRA}"
# Forward wandb credentials and entity from the submitting shell. SLURM's --export=ALL
# (the default) carries them into the job; if WANDB_ENTITY isn't set, Robometer's config
# default (clvr) wins and the run will fail unless you have access to that team.
export WANDB_API_KEY="${WANDB_API_KEY:-}"
export WANDB_ENTITY="${WANDB_ENTITY:-nlp-squad}"

cd "$ROBOMETER_DIR"

# Build the override list from the two preset files. Hydra accepts files via --config-name,
# but this codebase reads them as a flat override stream — we cat the two YAMLs and feed.
# Convert our two preset YAMLs into an array of Hydra CLI overrides. Using readarray keeps
# each line as one argv entry (important when values contain brackets or commas — they must
# not be word-split by the shell).
readarray -t OVERRIDES < <(
    grep -hv '^[[:space:]]*#' "$HERE/configs/train_lora_base.yaml" "$HERE/configs/loss1_corn.yaml" \
      | sed -e 's/[[:space:]]*#.*//' \
      | grep -v '^[[:space:]]*$' \
      | sed -e 's/: */=/' -e 's/^/++/'
)

EXTRA="${EXTRA:-}"
MAX_STEPS_OVERRIDE=""
if [[ -n "${MAX_STEPS:-}" ]]; then
    # ++ forces the override to win against the base-yaml's own ++training.max_steps line
    # (the yaml→CLI converter above prefixes every line with ++, so a plain override loses).
    MAX_STEPS_OVERRIDE="++training.max_steps=$MAX_STEPS"
fi

# Propagate WANDB_ENTITY into the Hydra config if set (overrides the upstream default of clvr).
ENTITY_OVERRIDE=""
if [[ -n "$WANDB_ENTITY" ]]; then
    ENTITY_OVERRIDE="logging.wandb_entity=$WANDB_ENTITY"
fi

# Checkpoints land in /projects/prjs1958/LoRA_weights/loss1_<jobid>/. Plenty of space there
# vs the home repo, and persistent across the home filesystem's quotas.
WEIGHTS_DIR="${WEIGHTS_DIR:-/projects/prjs1958/LoRA_weights}"
mkdir -p "$WEIGHTS_DIR"

"$PYTHON" train.py "${OVERRIDES[@]}" $MAX_STEPS_OVERRIDE $ENTITY_OVERRIDE $EXTRA \
  training.output_dir="$WEIGHTS_DIR/loss1_${SLURM_JOB_ID:-local}"
