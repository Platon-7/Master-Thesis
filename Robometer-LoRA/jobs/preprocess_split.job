#!/bin/bash
#SBATCH --job-name=rbm_pp_split
#SBATCH --output=logs/preprocess_split_%j_%x.out
#SBATCH --error=logs/preprocess_split_%j_%x.err
#SBATCH --time=08:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --account=gusei17535
#SBATCH --partition=staging

# Materialise one of build_splits.py's splits into a Robometer HF dataset cache.
# Usage:
#   SPLIT=train         sbatch jobs/preprocess_split.job
#   SPLIT=eval_droid    sbatch jobs/preprocess_split.job
#   SPLIT=eval_robometer sbatch jobs/preprocess_split.job
#   SPLIT=eval_metaworld sbatch jobs/preprocess_split.job
#   SPLIT=eval_failsafe sbatch jobs/preprocess_split.job
#
# Five jobs total can run in parallel — they don't share state.

set -euo pipefail
SPLIT="${SPLIT:?set SPLIT=train|eval_droid|eval_robometer|eval_metaworld|eval_failsafe}"

cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
SPLITS_DIR="${SPLITS_DIR:-/scratch-shared/$USER/robometer_frames_splits}"
# HF cache lands on /projects/prjs1958 alongside the source dataset and the LoRA weights —
# project-shared filesystem with the inode/disk headroom for the bake-off (~22k MP4 files).
# /scratch-shared is closer to its filesystem-level inode cap (67% used at last check).
HF_OUT_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/projects/prjs1958/robometer_frames_hf}"

PAIRS_INDEX="$SPLITS_DIR/pairs_index_${SPLIT}.jsonl"
if [[ ! -f "$PAIRS_INDEX" ]]; then
    echo "ERROR: pairs_index not found at $PAIRS_INDEX" >&2
    echo "Run: "$PYTHON" scripts/build_splits.py --output-dir $SPLITS_DIR" >&2
    exit 2
fi

# Activate the GPU env (preprocess is CPU-only but the env has the right "$PYTHON" deps)
# and load the system FFmpeg — Robometer's create_trajectory_video_optimized shells out to it
# for the JPG → H.264 MP4 transcode.
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
module load 2025 FFmpeg/7.1.1-GCCcore-14.2.0
PYTHON="/home/pkarageorgis1/.conda/envs/robometer_gpu/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: "$PYTHON" interpreter not executable at $PYTHON — likely an NFS-mount issue on this node" >&2
    exit 1
fi

export ROBOMETER_DATASET_PATH="/projects/prjs1958/robometer_frame_dataset"
export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_OUT_DIR"
export HF_DIR="$HF_OUT_DIR"
export SPLIT  # exported so the preprocess YAML can interpolate ${oc.env:SPLIT}

mkdir -p "$HF_OUT_DIR"
cd "$ROBOMETER_DIR"

echo "[preprocess_split] SPLIT=$SPLIT  pairs_index=$PAIRS_INDEX  out=$HF_OUT_DIR/${SPLIT}_raw"

# Step 1: convert the raw shards into a HuggingFace dataset.
"$PYTHON" -m dataset_upload.generate_hf_dataset \
  --config_path "$HERE/configs/dataset_frames.yaml" \
  --dataset.dataset_name "robometer_frames_${SPLIT}" \
  --dataset.pairs_index_path "$PAIRS_INDEX" \
  --output.output_dir "$HF_OUT_DIR/${SPLIT}_raw"

# Step 2: run Robometer's preprocess script to build the training-ready cache.
# preprocess_datasets uses pyrallis (not Hydra), so ${oc.env:...} interpolation in the YAML
# is NOT expanded automatically — sed-substitute SPLIT + HF_DIR into a temp file first.
TMP_PP_YAML="$(mktemp --suffix=.yaml)"
trap 'rm -f "$TMP_PP_YAML"' EXIT
sed -e "s|\${oc.env:HF_DIR}|$HF_OUT_DIR|g" \
    -e "s|\${oc.env:SPLIT}|$SPLIT|g" \
    -e "s|\${oc.env:ROBOMETER_PROCESSED_DATASETS_PATH}|$HF_OUT_DIR|g" \
    "$HERE/configs/preprocess_split.yaml" > "$TMP_PP_YAML"
echo "[preprocess_split] resolved preprocess config:"
cat "$TMP_PP_YAML"

"$PYTHON" -m robometer.data.scripts.preprocess_datasets \
  --config "$TMP_PP_YAML" \
  --cache_dir "$HF_OUT_DIR"

echo "[preprocess_split] DONE for $SPLIT"
