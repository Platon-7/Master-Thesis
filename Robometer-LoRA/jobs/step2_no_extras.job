#!/bin/bash
#SBATCH --job-name=rbm_step2_noextras
#SBATCH --output=logs/step2_noextras_%j.out
#SBATCH --error=logs/step2_noextras_%j.err
#SBATCH --time=15:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --account=gusei17535
#SBATCH --partition=staging

# Build the `train_no_extras` cache used by Robometer FT (humanoid +
# human_hand families excluded). Reads the merged train _raw produced by
# step2_after_array.job, filters out 8 humanoid+hand families, runs
# preprocess_datasets to emit processed_dataset/.
#
# Submit AFTER the train step2 (22609521) completes:
#   sbatch --dependency=afterok:22609521 jobs/step2_no_extras.job

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"

STEP1_DIR="${STEP1_DIR:?set STEP1_DIR (where the merged train_raw lives, /projects/prjs1958/...)}"
HF_OUT_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:?set ROBOMETER_PROCESSED_DATASETS_PATH (cache_dir for step 2 — /scratch-shared/...)}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
ENV_PREFIX="${ENV_PREFIX:-/home/pkarageorgis1/.conda/envs/robometer_gpu}"
PYTHON="$ENV_PREFIX/bin/python"

export ROBOMETER_DATASET_PATH="/projects/prjs1958/robometer_frame_dataset"
export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_OUT_DIR"
export HF_DIR="$STEP1_DIR"
export SPLIT="train_no_extras"

echo "============================================================"
echo "[no_extras] step 2a — filter merged train_raw (drop humanoid + human_hand)"
echo "  reading from STEP1_DIR (/projects), writing filtered _raw under STEP1_DIR"
echo "============================================================"
"$PYTHON" "$HERE/scripts/filter_train_no_extras.py" --hf-out-dir "$STEP1_DIR"

echo ""
echo "============================================================"
echo "[no_extras] step 2b — preprocess_datasets on the filtered _raw"
echo "============================================================"
TMP_PP_YAML="$(mktemp --suffix=.yaml)"
trap 'rm -f "$TMP_PP_YAML"' EXIT
sed -e "s|\${oc.env:HF_DIR}|$STEP1_DIR|g" \
    -e "s|\${oc.env:SPLIT}|train_no_extras|g" \
    -e "s|\${oc.env:ROBOMETER_PROCESSED_DATASETS_PATH}|$HF_OUT_DIR|g" \
    "$HERE/configs/preprocess_split.yaml" > "$TMP_PP_YAML"
cat "$TMP_PP_YAML"

cd "$ROBOMETER_DIR"
"$PYTHON" -m robometer.data.scripts.preprocess_datasets \
    --config "$TMP_PP_YAML" \
    --cache_dir "$HF_OUT_DIR"

# Create short-name symlink the dataset loader expects (see step2_after_array.job
# for the rationale). For no_extras we know the split is "train_no_extras".
HASHED="${STEP1_DIR//\//_}_train_no_extras_raw_robometer_frames_train_no_extras"
SHORT="robometer_frames_train_no_extras"
if [[ -d "$HF_OUT_DIR/$HASHED" ]]; then
    ln -sfn "$HASHED" "$HF_OUT_DIR/$SHORT"
    echo "[no_extras] linked $HF_OUT_DIR/$SHORT -> $HASHED"
else
    echo "[no_extras] WARN: expected hashed cache dir not found at $HF_OUT_DIR/$HASHED — skipping symlink"
fi

echo "[no_extras] DONE"
