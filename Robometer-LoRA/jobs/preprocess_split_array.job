#!/bin/bash
#SBATCH --job-name=rbm_pp_array
#SBATCH --output=logs/preprocess_array_%A_%a.out
#SBATCH --error=logs/preprocess_array_%A_%a.err
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --account=gusei17535
#SBATCH --partition=staging

# Parallel HF-cache builder for the full-pool training data.
#
# Usage:
#   1. Pre-shard the train pairs_index (one-time, ~5 sec):
#        SPLITS_DIR=/scratch-shared/$USER/robometer_frames_splits_full
#        $PYTHON Robometer-LoRA/scripts/shard_pairs_index.py \
#            --splits-dir $SPLITS_DIR --split train --n-shards 16
#
#   2. Submit the array (one task per shard):
#        SPLITS_DIR=$SPLITS_DIR \
#        SPLIT=train \
#        N_SHARDS=16 \
#        ROBOMETER_PROCESSED_DATASETS_PATH=/projects/prjs1958/robometer_frames_hf_full \
#        sbatch --array=0-15 Robometer-LoRA/jobs/preprocess_split_array.job
#
#   3. After all 16 finish, run concat_split_shards.py to merge the parts.
#
# For eval splits (small), set N_SHARDS=1 and submit array=0-0:
#        SPLIT=eval_droid sbatch --array=0-0 Robometer-LoRA/jobs/preprocess_split_array.job

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"

SPLIT="${SPLIT:?set SPLIT=train|eval_droid|eval_robometer|eval_metaworld|eval_failsafe}"
N_SHARDS="${N_SHARDS:-1}"
SHARD_ID="${SLURM_ARRAY_TASK_ID:-0}"
SPLITS_DIR="${SPLITS_DIR:?set SPLITS_DIR (parent of pairs_index_<split>.jsonl)}"
HF_OUT_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:?set ROBOMETER_PROCESSED_DATASETS_PATH}"

# Pick the right pairs_index for this task
if [[ "$N_SHARDS" -gt 1 ]]; then
    PAIRS_INDEX="$SPLITS_DIR/shards/pairs_index_${SPLIT}_part$(printf '%02d' $SHARD_ID).jsonl"
    OUTPUT_NAME="${SPLIT}_part$(printf '%02d' $SHARD_ID)"
else
    PAIRS_INDEX="$SPLITS_DIR/pairs_index_${SPLIT}.jsonl"
    OUTPUT_NAME="${SPLIT}"
fi
if [[ ! -f "$PAIRS_INDEX" ]]; then
    echo "ERROR: pairs_index not found at $PAIRS_INDEX" >&2
    exit 2
fi

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
module load 2025 FFmpeg/7.1.1-GCCcore-14.2.0
ENV_PREFIX="${ENV_PREFIX:-/home/pkarageorgis1/.conda/envs/robometer_gpu}"
PYTHON="$ENV_PREFIX/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: $PYTHON not executable" >&2
    exit 1
fi

export ROBOMETER_DATASET_PATH="/projects/prjs1958/robometer_frame_dataset"
export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_OUT_DIR"
export HF_DIR="$HF_OUT_DIR"
export SPLIT  # for the preprocess YAML's ${oc.env:SPLIT}

mkdir -p "$HF_OUT_DIR"
cd "$ROBOMETER_DIR"

echo "==================== shard ${SHARD_ID}/${N_SHARDS} ===================="
echo "  SPLIT          : $SPLIT"
echo "  PAIRS_INDEX    : $PAIRS_INDEX"
echo "  HF_OUT_DIR     : $HF_OUT_DIR"
echo "  OUTPUT_NAME    : $OUTPUT_NAME"
echo "  ROW_COUNT      : $(wc -l < "$PAIRS_INDEX")"
echo "==================================================================="

# Step 1: convert raw shards into a HuggingFace dataset (per-shard).
"$PYTHON" -m dataset_upload.generate_hf_dataset \
  --config_path "$HERE/configs/dataset_frames.yaml" \
  --dataset.dataset_name "robometer_frames_${OUTPUT_NAME}" \
  --dataset.pairs_index_path "$PAIRS_INDEX" \
  --output.output_dir "$HF_OUT_DIR/${OUTPUT_NAME}_raw" \
  --output.num_workers 16

# Step 2: only run on the FINAL merged cache, NOT per-shard. Skipped here.
# After all array tasks complete, run concat_split_shards.py to merge
# the per-shard _raw outputs, then run preprocess_datasets.py once on the
# merged cache to produce the training-ready processed_dataset/.

echo "[shard $SHARD_ID] DONE"
