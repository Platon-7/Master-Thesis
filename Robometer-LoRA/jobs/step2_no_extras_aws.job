#!/bin/bash
#SBATCH --job-name=rbm_step2_noextras
#SBATCH --output=logs/step2_noextras_%j.out
#SBATCH --error=logs/step2_noextras_%j.err
#SBATCH --time=24:00:00
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=spot-g6-4gpu-l4,spot-g6-8gpu-l4,spot-g6e-4gpu-l40s,spot-g6e-8gpu-l40s
#SBATCH --requeue

# Step 2, second job (AWS port of step2_no_extras.job): build the
# `train_no_extras` cache used by Robometer-FT (humanoid + human_hand families
# excluded). Reads the merged train_raw produced by step2_after_array_aws.job,
# filters the extra families, runs preprocess_datasets to emit the NPZ cache.
#
# MUST run AFTER step2_after_array_aws.job's concat (it needs $STEP1_DIR/train_raw).
# Submit with a dependency on the full-train step 2 job:
#   sbatch --dependency=afterok:<step2_full_jobid> jobs/step2_no_extras_aws.job
#
# Path split matches step 2 job 1:
#   STEP1_DIR (read merged train_raw + MP4s) -> /fsx
#   cache_dir (write NPZs)                   -> /shared

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"

STEP1_DIR="${STEP1_DIR:-/fsx/$USER/robometer_frames_hf_full}"
HF_OUT_DIR="${ROBOMETER_PROCESSED_DATASETS_PATH:-/shared/home/$USER/robometer_frames_hf_full_step2}"

ENV_PREFIX="${ENV_PREFIX:-/shared/home/PKA4388/miniconda3/envs/robometer_gpu_fa2}"
PYTHON="$ENV_PREFIX/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    echo "ERROR: $PYTHON not executable" >&2
    exit 1
fi

export ROBOMETER_DATASET_PATH="/shared/home/PKA4388/robometer_frame_dataset"
export ROBOMETER_PROCESSED_DATASETS_PATH="$HF_OUT_DIR"
export HF_DIR="$STEP1_DIR"
export SPLIT="train_no_extras"

mkdir -p "$HF_OUT_DIR"

echo "============================================================"
echo "[no_extras] HOST=$(hostname)  PARTITION=${SLURM_JOB_PARTITION:-?}"
echo "[no_extras] step 2a — filter merged train_raw (drop humanoid + human_hand)"
echo "  reading from STEP1_DIR ($STEP1_DIR), writing filtered _raw under STEP1_DIR"
echo "============================================================"
"$PYTHON" "$HERE/scripts/filter_train_no_extras.py" --hf-out-dir "$STEP1_DIR"

echo ""
echo "============================================================"
echo "[no_extras] step 2b — preprocess_datasets on the filtered _raw"
echo "============================================================"
TMP_PP_YAML="$(mktemp --suffix=.yaml)"
trap 'rm -f "$TMP_PP_YAML"' EXIT
sed -e "s|\${oc.env:HF_DIR}|$STEP1_DIR|g" \
    -e "s|\${oc.env:SPLIT}|train_no_extras|g" \
    -e "s|\${oc.env:ROBOMETER_PROCESSED_DATASETS_PATH}|$HF_OUT_DIR|g" \
    "$HERE/configs/preprocess_split.yaml" > "$TMP_PP_YAML"
cat "$TMP_PP_YAML"

cd "$ROBOMETER_DIR"
"$PYTHON" -m robometer.data.scripts.preprocess_datasets \
    --config "$TMP_PP_YAML" \
    --cache_dir "$HF_OUT_DIR"

# Short-name symlink the loader expects.
HASHED="${STEP1_DIR//\//_}_train_no_extras_raw_robometer_frames_train_no_extras"
SHORT="robometer_frames_train_no_extras"
if [[ -d "$HF_OUT_DIR/$HASHED" ]]; then
    ln -sfn "$HASHED" "$HF_OUT_DIR/$SHORT"
    echo "[no_extras] linked $HF_OUT_DIR/$SHORT -> $HASHED"
else
    echo "[no_extras] WARN: expected hashed cache dir not found at $HF_OUT_DIR/$HASHED — skipping symlink"
fi

echo "[no_extras] DONE"
