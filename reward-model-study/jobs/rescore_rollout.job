#!/bin/bash
#SBATCH --job-name=rescore_roll
#SBATCH --output=logs/rescore_roll_%j.out
#SBATCH --error=logs/rescore_roll_%j.err
#SBATCH --time=00:40:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${EVAL_ENV:?}" 2>/dev/null || true
PY="$HOME/.conda/envs/${EVAL_ENV}/bin/python"
[ -x "$PY" ] || { echo "ERROR: $PY not found"; exit 3; }
export PYTHONPATH="$HERE/vlm_ibrl:$HERE/Robometer:${PYTHONPATH:-}"
export MUJOCO_GL=egl
# Robometer-FT needs its ICL demo context (run1 was ICL-trained)
[ -n "${ROBOMETER_ICL_DEMO_PATH:-}" ] && export ROBOMETER_ICL_DEMO_PATH ROBOMETER_ICL_DEMO_IDX="${ROBOMETER_ICL_DEMO_IDX:-0}" ROBOMETER_ICL_FRAMES="${ROBOMETER_ICL_FRAMES:-16}"
echo "frames=$FRAMES_DIR model=$MODEL_PATH out=$OUT"
nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1
"$PY" reward-model-study/scripts/rescore_rollout_frames.py \
  --frames-dir "$FRAMES_DIR" --model "$MODEL_PATH" --out "$OUT" ${LIMIT:+--limit $LIMIT}
