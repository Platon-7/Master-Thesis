#!/bin/bash
#SBATCH --job-name=regen_v3
#SBATCH --output=/gpfs/home3/pkarageorgis1/Master-Thesis/reward-model-study/logs/regen_v3_%j.out
#SBATCH --error=/gpfs/home3/pkarageorgis1/Master-Thesis/reward-model-study/logs/regen_v3_%j.err
#SBATCH --time=02:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
set -uo pipefail
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 2>/dev/null || true
module load Anaconda3/2025.06-1 2>/dev/null || true
source "$(conda info --base)/etc/profile.d/conda.sh"
# v3 env: clone of demo2reward + Farama MetaWorld v3 (gymnasium 0.29.1, mujoco 3.1.1,
# metaworld pin 58e32b4d). transformers 4.57.2 inherited from demo2reward scores the
# Qwen3-VL-based Robometer-FT in the SAME process that renders v3.
conda activate /gpfs/scratch1/shared/pkarageorgis1/envs/demo2reward_v3
export PYTHONNOUSERSITE=1
export MUJOCO_GL=egl                       # new-mujoco EGL offscreen render (needs GPU)
export PYTHONPATH="/gpfs/home3/pkarageorgis1/Master-Thesis/MetaWorld:/gpfs/home3/pkarageorgis1/Master-Thesis/vlm_ibrl_v3:/gpfs/home3/pkarageorgis1/Master-Thesis/Robometer:${PYTHONPATH:-}"
nvidia-smi --query-gpu=name --format=csv,noheader | head -1
python -u /gpfs/home3/pkarageorgis1/Master-Thesis/reward-model-study/scripts/regen_v3_pipeline.py
