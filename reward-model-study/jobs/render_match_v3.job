#!/bin/bash
#SBATCH --job-name=rmatch_v3
#SBATCH --output=/gpfs/home3/pkarageorgis1/Master-Thesis/reward-model-study/logs/render_match_v3_%j.out
#SBATCH --error=/gpfs/home3/pkarageorgis1/Master-Thesis/reward-model-study/logs/render_match_v3_%j.err
#SBATCH --time=00:20:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=40G
set -uo pipefail
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 2>/dev/null || true
module load Anaconda3/2025.06-1 2>/dev/null || true
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /gpfs/scratch1/shared/pkarageorgis1/envs/demo2reward_v3
export PYTHONNOUSERSITE=1
export MUJOCO_GL=egl
export PYTHONPATH="/gpfs/home3/pkarageorgis1/Master-Thesis/vlm_ibrl_v3:${PYTHONPATH:-}"
nvidia-smi --query-gpu=name --format=csv,noheader | head -1
python -u /gpfs/home3/pkarageorgis1/Master-Thesis/reward-model-study/scripts/render_match_v3.py
