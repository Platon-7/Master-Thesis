#!/bin/bash
#SBATCH --job-name=diag_v2cam
#SBATCH --output=logs/diag_v2cam_%j.out
#SBATCH --error=logs/diag_v2cam_%j.err
#SBATCH --time=02:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR/vlm_ibrl"
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"; conda activate demo2reward
source set_env.sh 2>/dev/null || true
export MUJOCO_GL=egl MUJOCO_PATH="$HOME/.mujoco/mujoco210"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$HOME/.mujoco/mujoco210/bin"
export PYTHONPATH="$PWD:$PWD/../Robometer:${PYTHONPATH:-}"
nvidia-smi --query-gpu=name --format=csv,noheader | head -1
python ../reward-model-study/scripts/diag_v2_cameras.py
