#!/bin/bash
#SBATCH --job-name=diag_v2v3
#SBATCH --output=logs/diag_v2v3_%j.out
#SBATCH --error=logs/diag_v2v3_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"; conda activate robometer_gpu_fa2
export PYTHONPATH="$PWD/vlm_ibrl:$PWD/Robometer:${PYTHONPATH:-}"; export MUJOCO_GL=egl
"$HOME/.conda/envs/robometer_gpu_fa2/bin/python" reward-model-study/scripts/diag_v2_vs_v3_sanity.py
