#!/bin/bash
#SBATCH --job-name=plot_fig4
#SBATCH --output=/home/pkarageo/master-thesis/RL-VLM-F/logs/plot_fig4_out_%j.txt
#SBATCH --error=/home/pkarageo/master-thesis/RL-VLM-F/logs/plot_fig4_err_%j.txt
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=00:20:00

set -euo pipefail

cd /home/pkarageo/master-thesis/RL-VLM-F
mkdir -p logs

# Update these paths if you run a different experiment.
EXP_ROOT="/home/pkarageo/master-thesis/RL-VLM-F/exp/qwen_local_test/metaworld_soccer-v2/2026-01-25-23-30-37/vlm_1gemini_free_form_rewardlearn_from_preference_H256_L3_lr0.0003/teacher_b-1_g1_m0_s0_e0/label_smooth_0.0/schedule_0/PEBBLE_init1000_unsup9000_inter4000_maxfeed20000_seg1_acttanh_Rlr0.0001_Rbatch40_Rupdate5_en3_sample0_large_batch10_seed0"
EVAL_CSV="$EXP_ROOT/eval.csv"
OUTPUT_PNG="/home/pkarageo/master-thesis/RL-VLM-F/figures/soccer_figure4_new.png"
SMOOTH_WINDOW=5
PLOT_TITLE="Soccer – Success Rate"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate rlvlmf

python scripts/plot_figure4.py "$EVAL_CSV" \
    --output "$OUTPUT_PNG" \
    --smooth-window "$SMOOTH_WINDOW" \
    --title "$PLOT_TITLE"

echo "Figure 4 saved to $OUTPUT_PNG"
