#!/bin/bash
#SBATCH --job-name=ms_verify_hipster
#SBATCH --output=logs/hipster_verify_%j.out
#SBATCH --error=logs/hipster_verify_%j.err
#SBATCH --time=00:40:00
#SBATCH --partition=capacity
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#
# Hipster-cluster adaptation of maniskill_verify.job (that one targets Snellius
# partitions/paths). Verifies the freshly-built (not transferred-tarball) venv.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
mkdir -p logs

# SLURM does not reliably propagate $USER into the batch environment on this
# cluster (observed: unset, causing ENV_PREFIX etc. to resolve under /scratch/).
export USER="${USER:-$(whoami)}"

ENV_PREFIX="${ENV_PREFIX:-/scratch/$USER/envs/maniskill_rl}"
PYTHON="$ENV_PREFIX/bin/python"
[[ -x "$PYTHON" ]] || { echo "ERROR: no python at $PYTHON" >&2; exit 1; }

# Python 3.11's cwd-shadowing guard: without this, `python -c`/`-` prepends ''
# (cwd) to sys.path, and since $SLURM_SUBMIT_DIR (repo root) contains a stale
# `robometer/` submodule (missing robometer.data), it shadows the real
# `robometer` fork installed from ~/Master-Thesis/Robometer -- regardless of
# pip install order or PYTHONPATH. Confirmed necessary on this cluster.
export PYTHONSAFEPATH=1

# SAPIEN needs a working Vulkan ICD; this compute-node image ships CUDA-only
# NVIDIA driver libs (no Vulkan/GLX userspace, no /usr/share/vulkan/icd.d) and
# no system Mesa. Fix: an NVIDIA driver .run extracted (not installed) to
# /scratch, giving the actual ICD, PLUS a modern conda-forge libvulkan.so.1 --
# SAPIEN's own bundled loader (1.3.224) cannot negotiate with this driver's ICD
# interface (fails with "Could not get vkCreateInstance via
# vk_icdGetInstanceProcAddr"); the newer loader (1.4.357) can. Confirmed
# working: torch.Size([1, 512, 512, 3]) real Vulkan render on hipster-cn009.
export LD_LIBRARY_PATH="/scratch/$USER/vulkan_loader/extracted/lib:/scratch/$USER/nvidia_driver/extracted:${LD_LIBRARY_PATH:-}"
export VK_ICD_FILENAMES="/scratch/$USER/nvidia_driver/nvidia_icd_abs.json"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="${MS_ASSET_DIR:-/scratch/$USER/maniskill_assets}"
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export TORCH_HOME="${TORCH_HOME:-/scratch/$USER/torch_cache}"
export SAPIEN_CACHE_DIR="${SAPIEN_CACHE_DIR:-/scratch/$USER/sapien_cache}"
export ROBOMETER_DISABLE_UNSLOTH=1
export TOKENIZERS_PARALLELISM=false

echo "=========== node ==========="
hostname
nvidia-smi --query-gpu=name,driver_version,compute_cap --format=csv,noheader 2>&1
echo "============================"

echo ""
echo "=========== import timings ==========="
timeout 900 "$PYTHON" -u - <<'PY'
import time
for mod in ("numpy", "torch", "transformers", "mani_skill.envs", "robometer.data.dataset_types"):
    t = time.time()
    try:
        __import__(mod)
        print(f"  {mod:34s} {time.time()-t:7.1f}s")
    except Exception as e:
        print(f"  {mod:34s} FAILED: {type(e).__name__}: {e}")
PY
echo "import stage rc=$?"

echo ""
echo "=========== torch CUDA check ==========="
"$PYTHON" -c "import torch; print('cuda available:', torch.cuda.is_available()); print('device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NONE')"

echo ""
echo "=========== full environment verification (no ICL) ==========="
timeout 1200 "$PYTHON" -u scripts/verify_maniskill_env.py --task PullCube-v1
RC=$?

echo ""
echo "VERIFY_RC=$RC"
exit $RC
