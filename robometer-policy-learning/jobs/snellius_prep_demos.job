#!/bin/bash
#SBATCH --job-name=prepdemo
#SBATCH --output=/scratch-shared/pkarageorgis1/roboref_results/prepdemo_%j.out
#SBATCH --error=/scratch-shared/pkarageorgis1/roboref_results/prepdemo_%j.err
#SBATCH --time=08:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
#
# Rebuild the offline demo set for an IQL/BC warm start, on Snellius.
#
# The transferred maniskill_assets tarball was packed 2026-08-16, BEFORE the
# demo work of 2026-09-01, so it carries only the raw ManiSkill PPO
# trajectories. Everything downstream of them has to be regenerated here.
#
# Three stages, in this order (both later scripts edit their h5 IN PLACE, so the
# copy must happen before the clip, not after):
#
#   1. convert  raw PPO trajectory  -> ${TASK}_bc.h5     (replays in the sim)
#   2. clip     copy to _clip.h5, then squash actions to +-0.99. 23-27% of demo
#               action components sit at |a| = 1-1e-6, which needs a pre-tanh
#               mean of atanh(0.999999) = 7.25 -- unreachable for a tanh-Gaussian
#               actor, so NLL-based BC/IQL structurally underfits (0-8% / ~20%,
#               where an MSE clone reaches 55-60%). atanh(0.99) = 2.65 is fine.
#   3. relabel  overwrite the rewards with the reward model's progress head, so
#               the offline phase is trained on the SAME signal as the online one.
#
#   sbatch --export=ALL,TASK=LiftPegUpright-v1,NUM_DEMOS=100 jobs/snellius_prep_demos.job
#   sbatch --export=ALL,TASK=PullCube-v1,NUM_DEMOS=100       jobs/snellius_prep_demos.job
#
# STAGES=convert,clip,relabel  (subset to re-run part of the chain)

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; mkdir -p logs

TASK="${TASK:-LiftPegUpright-v1}"
NUM_DEMOS="${NUM_DEMOS:-100}"
STAGES="${STAGES:-convert,clip,relabel}"
CLIP="${CLIP:-0.99}"
RUN2_PATH="/projects/prjs1958/Robometer_FT_consolidated/run2_noicl_ours_step4000"
MODEL="${MODEL:-$RUN2_PATH}"

# /scratch-shared purges files not accessed for ~2 weeks and ATE this venv on
# 2026-09-07 (numpy/tqdm/wandb lost their .py files mid-campaign). The venv now
# lives on /projects, which is permanent.
ENV_PREFIX="${ENV_PREFIX:-/projects/prjs1958/$USER/envs/maniskill_rl}"
PY="$ENV_PREFIX/bin/python"
export PATH="$ENV_PREFIX/bin:$PATH"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export HF_HOME="/scratch-shared/$USER/hf_cache"
export TORCH_HOME="/scratch-shared/$USER/torch_cache"
export SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
export TOKENIZERS_PARALLELISM=false ROBOMETER_DISABLE_UNSLOTH=1

DEMOS="$MS_ASSET_DIR/demos"
OUTDIR="$MS_ASSET_DIR/demos_converted"
mkdir -p "$OUTDIR"
BC="$OUTDIR/${TASK}_bc.h5"
CLIPPED="$OUTDIR/${TASK}_bc_clip.h5"

echo "TASK=$TASK NUM_DEMOS=$NUM_DEMOS STAGES=$STAGES CLIP=$CLIP"
echo "MODEL=$MODEL"
echo "node=$(hostname)"

CM=$("$PY" -c "import sys;sys.path.insert(0,'.');from robometer_policy_learning.envs.maniskill_utils import get_task_spec;print(get_task_spec('$TASK').control_mode)") || exit 3
echo "control_mode=$CM"

if [[ ",$STAGES," == *",convert,"* ]]; then
    SRC=$(ls "$DEMOS/$TASK"/*/trajectory.none.${CM}.*.h5 2>/dev/null | head -1)
    [[ -f "$SRC" ]] || { echo "ERROR: no demo h5 for $TASK ($CM) under $DEMOS/$TASK" >&2; exit 4; }
    echo "=== [1/3] convert  <- $SRC"
    "$PY" -u scripts/convert_maniskill_demos.py --task "$TASK" --demo-h5 "$SRC" \
        --out "$BC" --num-demos "$NUM_DEMOS" || { echo "ERROR: convert failed" >&2; exit 5; }
fi

if [[ ",$STAGES," == *",clip,"* ]]; then
    [[ -f "$BC" ]] || { echo "ERROR: missing $BC -- run the convert stage first" >&2; exit 6; }
    echo "=== [2/3] clip -> $CLIPPED"
    cp -f "$BC" "$CLIPPED" || exit 6
    "$PY" -u scripts/clip_demo_actions.py --h5 "$CLIPPED" --clip "$CLIP" \
        || { echo "ERROR: clip failed" >&2; exit 6; }
fi

if [[ ",$STAGES," == *",relabel,"* ]]; then
    [[ -f "$CLIPPED" ]] || { echo "ERROR: missing $CLIPPED -- run the clip stage first" >&2; exit 7; }
    echo "=== [3/3] relabel $CLIPPED with $MODEL"
    "$PY" -u scripts/relabel_demo_rewards.py --demo-h5 "$CLIPPED" --model "$MODEL" --task "$TASK" \
        || { echo "ERROR: relabel failed" >&2; exit 7; }
fi

echo "=== result ==="
ls -la "$OUTDIR"
"$PY" - <<PY
import h5py, numpy as np
f = h5py.File("$CLIPPED", "r")
d = f["data"]; ks = list(d.keys())
acts = np.concatenate([np.array(d[k]["actions"]).reshape(-1) for k in ks])
print(f"episodes={len(ks)}  action components={acts.size}")
print(f"  |a|>=0.999 : {(np.abs(acts)>=0.999).mean():.2%}   max|a| = {np.abs(acts).max():.6f}")
print(f"  attrs      : {dict(f.attrs)}")
if "rewards" in d[ks[0]]:
    r = np.concatenate([np.array(d[k]["rewards"]).reshape(-1) for k in ks])
    print(f"  rewards    : n={r.size} min={r.min():.4f} mean={r.mean():.4f} max={r.max():.4f}")
f.close()
PY
echo "PREP_DONE"
