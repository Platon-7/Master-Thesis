#!/bin/bash
#SBATCH --job-name=ms_sanity
#SBATCH --output=/scratch-shared/pkarageorgis1/roboref_results/ms_sanity_%j.out
#SBATCH --error=/scratch-shared/pkarageorgis1/roboref_results/ms_sanity_%j.err
#SBATCH --time=00:30:00
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=90G
# Small check only -- h100 for fast turnaround. The real sweeps run on gpu_a100.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
ENV_PREFIX=/projects/prjs1958/$USER/envs/maniskill_rl
export PATH="$ENV_PREFIX/bin:$PATH"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR=/scratch-shared/$USER/maniskill_assets
export HF_HOME=/scratch-shared/$USER/hf_cache
export TORCH_HOME=/scratch-shared/$USER/torch_cache
export ROBOMETER_DISABLE_UNSLOTH=1 TOKENIZERS_PARALLELISM=false
echo "== $(hostname) $(nvidia-smi --query-gpu=name --format=csv,noheader | head -1) =="
for M in ${MODELS:-lrm robodopamine}; do
  echo "############ $M ############"
  "$ENV_PREFIX/bin/python" -u scripts/sanity_baseline_adapters.py --model "$M"
  echo "rc=$?"
done
