#!/bin/bash
#SBATCH --job-name=convdemo
#SBATCH --output=logs/convdemo_%j.out
#SBATCH --error=logs/convdemo_%j.err
#SBATCH --time=06:00:00
#SBATCH --partition=capacity
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=47G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; mkdir -p logs
export USER="${USER:-$(whoami)}" PYTHONSAFEPATH=1
export CPATH="/cvmfs/software.eessi.io/versions/2025.06/software/linux/x86_64/amd/zen4/software/Python/3.12.3-GCCcore-13.3.0/include/python3.12:${CPATH:-}"
export LD_LIBRARY_PATH="/scratch/$USER/vulkan_loader/extracted/lib:/scratch/$USER/nvidia_driver/extracted:${LD_LIBRARY_PATH:-}"
export VK_ICD_FILENAMES="/scratch/$USER/nvidia_driver/nvidia_icd_abs.json"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch/$USER/maniskill_assets" HF_HOME="/scratch/$USER/hf_cache"
export TORCH_HOME="/scratch/$USER/torch_cache" SAPIEN_CACHE_DIR="/scratch/$USER/sapien_cache"
export TOKENIZERS_PARALLELISM=false ROBOMETER_DISABLE_UNSLOTH=1
PY=/scratch/$USER/envs/maniskill_rl/bin/python
DEMOS=/scratch/$USER/maniskill_assets/demos
OUTDIR=/scratch/$USER/maniskill_assets/demos_converted
mkdir -p "$OUTDIR"
N="${NUM_DEMOS:-100}"
for T in ${TASKS:-PokeCube-v1}; do
  CM=$("$PY" -c "import sys;sys.path.insert(0,'.');from robometer_policy_learning.envs.maniskill_utils import get_task_spec;print(get_task_spec('$T').control_mode)")
  SRC=$(ls $DEMOS/$T/*/trajectory.none.${CM}.*.h5 2>/dev/null | head -1)
  [[ -f "$SRC" ]] || { echo "ERROR: no demo h5 for $T ($CM)" >&2; continue; }
  echo "################ $T  control=$CM ################"
  "$PY" -u scripts/convert_maniskill_demos.py --task "$T" --demo-h5 "$SRC" \
      --out "$OUTDIR/${T}_bc.h5" --num-demos "$N"
done
echo "CONVERT_DONE"
