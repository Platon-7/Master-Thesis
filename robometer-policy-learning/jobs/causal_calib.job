#!/bin/bash
#SBATCH --job-name=ccalib
#SBATCH --output=/scratch-shared/pkarageorgis/roboref_results/ccalib_%j.out
#SBATCH --error=/scratch-shared/pkarageorgis/roboref_results/ccalib_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
#
# Causal threshold + gate calibration, ported from vlm_ibrl/jobs/diag_causal_calib.py.
# Rollouts come from a LADDER of SAC checkpoints spanning the training arc (the
# deployment distribution), frames render at 480 (training format), and the
# statistic is per-episode MAX success_prob with Youden-J selection + gate guidance.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export MUJOCO_GL=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export HF_HOME="/scratch-shared/$USER/hf_cache" SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
export TOKENIZERS_PARALLELISM=false ROBOMETER_DISABLE_UNSLOTH=1
PY=/scratch-shared/$USER/envs/maniskill_rl/bin/python
CK=/scratch-shared/$USER/roboref_checkpoints
RUNS=/scratch-shared/$USER/roboref_runs
for T in PullCube-v1 LiftPegUpright-v1; do
  AD=$(ls -d $RUNS/ms_${T}_gtshift_gt_s0_*/checkpoints 2>/dev/null | head -1)
  [ -d "$AD" ] || { echo "no actor dir for $T"; continue; }
  for M in "run2=$CK/run2_noicl_ours_step4000" "run3=$CK/run3_noicl_standard_step5000" "base=robometer/Robometer-4B"; do
    tag="${M%%=*}"; path="${M#*=}"
    echo ""; echo "################ $T / $tag ################"
    timeout 10800 $PY -u scripts/causal_calib_maniskill.py \
      --task "$T" --model "$path" --tag "$tag" --actor-dir "$AD" \
      --episodes 32 --n-checkpoints 8 --image-size 224
    echo "rc=$?"
  done
done
echo "CAUSAL_CALIB_DONE"
