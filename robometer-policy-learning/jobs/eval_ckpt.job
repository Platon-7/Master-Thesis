#!/bin/bash
#SBATCH --job-name=evalck
#SBATCH --output=/scratch-shared/pkarageorgis/roboref_results/evalck_%j.out
#SBATCH --error=/scratch-shared/pkarageorgis/roboref_results/evalck_%j.err
#SBATCH --time=01:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=60G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export MUJOCO_GL=egl SAPIEN_HEADLESS=1 TOKENIZERS_PARALLELISM=false
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets" HF_HOME="/scratch-shared/$USER/hf_cache"
export SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
PY=/scratch-shared/$USER/envs/maniskill_rl/bin/python
D=$(ls -dt /scratch-shared/$USER/roboref_runs/ms_PullCube-v1_run2disc_dense_s0_*/checkpoints 2>/dev/null | head -1)
for s in 125000 150000; do
  [ -d "$D/$s" ] && timeout 1500 $PY -u scripts/eval_actor_ckpt.py "$D/$s" PullCube-v1 50 2>&1 | grep -E "RESULT|Error|Traceback"
done
echo EVAL_CKPT_DONE
