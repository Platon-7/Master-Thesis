#!/bin/bash
#SBATCH --job-name=gpu_diag
#SBATCH --output=logs/gpu_diag_%j.out
#SBATCH --error=logs/gpu_diag_%j.err
#SBATCH --time=00:30:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export HF_HOME="/scratch-shared/$USER/hf_cache" SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
timeout 1200 /scratch-shared/$USER/envs/maniskill_rl/bin/python -u scripts/diag_gpu_env.py "${TASK:-PullCube-v1}"
