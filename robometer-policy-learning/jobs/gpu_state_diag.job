#!/bin/bash
#SBATCH --job-name=gpu_sdiag
#SBATCH --output=logs/gpu_sdiag_%j.out
#SBATCH --error=logs/gpu_sdiag_%j.err
#SBATCH --time=00:40:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export HF_HOME="/scratch-shared/$USER/hf_cache" SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
PY=/scratch-shared/$USER/envs/maniskill_rl/bin/python
D=/scratch-shared/$USER/gpu_state_diag; mkdir -p $D
for T in PokeCube-v1 PullCube-v1; do
  timeout 900 $PY -u scripts/diag_gpu_vs_cpu_state.py "$T" physx_cpu  "$D/${T}_cpu.npz"
  timeout 900 $PY -u scripts/diag_gpu_vs_cpu_state.py "$T" physx_cuda "$D/${T}_gpu.npz"
done
timeout 300 $PY -u - <<'PYEOF'
import numpy as np, os
D=os.path.expandvars("/scratch-shared/$USER/gpu_state_diag")
for T in ("PokeCube-v1","PullCube-v1"):
    try:
        c=np.load(f"{D}/{T}_cpu.npz")["states"]; g=np.load(f"{D}/{T}_gpu.npz")["states"]
    except Exception as e:
        print(T,"missing:",e); continue
    print(f"\n=== {T} ===  cpu{c.shape} gpu{g.shape}")
    if c.shape!=g.shape: print("  SHAPE MISMATCH"); continue
    d=np.abs(c-g)
    print(f"  reset  max|diff|={d[0].max():.4f}  mean={d[0].mean():.4f}")
    print(f"  step5  max|diff|={d[-1].max():.4f}  mean={d[-1].mean():.4f}")
    bad=np.argsort(-d[0])[:6]
    print(f"  worst dims at reset: {[(int(i), round(float(c[0][i]),3), round(float(g[0][i]),3)) for i in bad]}")
PYEOF
