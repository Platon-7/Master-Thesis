#!/bin/bash
#SBATCH --job-name=ccalib
#SBATCH --output=logs/hipster_ccalib_%j.out
#SBATCH --error=logs/hipster_ccalib_%j.err
#SBATCH --time=08:00:00
#SBATCH --partition=capacity
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
#
# M1 in WAKEUP_PLAN.md. Hipster port of jobs/causal_calib.job.
#
# Scores run2's heads on rollouts from a LADDER of GT-SAC checkpoints spanning
# 25k..300k -- i.e. policies ranging from useless to 100% GT success. Answers two
# questions in one job:
#
#   (a) CANARY. On the GT policy's own SUCCESSFUL episodes, does the head reach
#       its documented 0.7-0.9 per-episode max success_prob on THIS cluster's
#       rebuilt graphics stack (extracted NVIDIA ICD + conda-forge Vulkan loader,
#       no FlashAttention)? If it reads ~0.1 instead, the renderer is feeding the
#       VLM different pixels than Snellius did and no RL tuning matters.
#
#   (b) The off-policy -> on-policy degradation curve: head discrimination as a
#       FUNCTION of policy quality. That is the thesis' central claim, measured.
#
# --random-policy adds the bottom of the curve: the checkpoint ladder starts at
# 25k, already past the flailing phase a from-scratch reward-model run lives in.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
mkdir -p logs
export USER="${USER:-$(whoami)}"
export PYTHONSAFEPATH=1

export CPATH="/cvmfs/software.eessi.io/versions/2025.06/software/linux/x86_64/amd/zen4/software/Python/3.12.3-GCCcore-13.3.0/include/python3.12:${CPATH:-}"
export LD_LIBRARY_PATH="/scratch/$USER/vulkan_loader/extracted/lib:/scratch/$USER/nvidia_driver/extracted:${LD_LIBRARY_PATH:-}"
export VK_ICD_FILENAMES="/scratch/$USER/nvidia_driver/nvidia_icd_abs.json"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="${MS_ASSET_DIR:-/scratch/$USER/maniskill_assets}"
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export TORCH_HOME="${TORCH_HOME:-/scratch/$USER/torch_cache}"
export SAPIEN_CACHE_DIR="${SAPIEN_CACHE_DIR:-/scratch/$USER/sapien_cache}"
export TOKENIZERS_PARALLELISM=false ROBOMETER_DISABLE_UNSLOTH=1

PY=/scratch/$USER/envs/maniskill_rl/bin/python
[[ -x "$PY" ]] || { echo "ERROR: no python at $PY" >&2; exit 1; }

TASK="${TASK:-PullCube-v1}"
MODEL="${MODEL:-$HOME/Master-Thesis-transfer/checkpoints/Robometer_FT_consolidated/run2_noicl_ours_step4000}"
TAG="${TAG:-run2}"
EPISODES="${EPISODES:-32}"
NCK="${NCK:-8}"

AD=$(ls -d /scratch/$USER/roboref_runs/ms_${TASK}_gt_gt_sanity_s0_*/checkpoints 2>/dev/null | head -1)
[[ -d "$AD" ]] || { echo "ERROR: no GT actor checkpoints dir for $TASK" >&2; exit 2; }

echo "==================== M1 causal calib ===================="
echo "node      : $(hostname)"
echo "task      : $TASK"
echo "model     : $MODEL ($TAG)"
echo "actor-dir : $AD"
echo "ladder    : $NCK checkpoints x $EPISODES episodes"
ls "$AD"
echo "========================================================="

echo ""; echo "################ ladder: GT checkpoints 25k..300k ################"
timeout 21600 "$PY" -u scripts/causal_calib_maniskill.py \
  --task "$TASK" --model "$MODEL" --tag "$TAG" --actor-dir "$AD" \
  --episodes "$EPISODES" --n-checkpoints "$NCK" --image-size 224
echo "ladder rc=$?"

echo ""; echo "################ bottom of curve: random policy ################"
timeout 7200 "$PY" -u scripts/causal_calib_maniskill.py \
  --task "$TASK" --model "$MODEL" --tag "${TAG}_random" --actor-dir "$AD" \
  --episodes "$EPISODES" --n-checkpoints 1 --image-size 224 --random-policy
echo "random rc=$?"

echo "CAUSAL_CALIB_DONE"
