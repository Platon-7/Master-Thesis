#!/bin/bash
#SBATCH --job-name=sphead
#SBATCH --output=/scratch-shared/pkarageorgis/roboref_results/sphead_%j.out
#SBATCH --error=/scratch-shared/pkarageorgis/roboref_results/sphead_%j.err
#SBATCH --time=02:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export MUJOCO_GL=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export HF_HOME="/scratch-shared/$USER/hf_cache" SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
export TOKENIZERS_PARALLELISM=false ROBOMETER_DISABLE_UNSLOTH=1
PY=/scratch-shared/$USER/envs/maniskill_rl/bin/python
CK=/scratch-shared/$USER/roboref_checkpoints
for M in "$CK/run2_noicl_ours_step4000" "$CK/run3_noicl_standard_step5000" "robometer/Robometer-4B"; do
  for MODE in default pad16 pad16res480; do
    timeout 1800 $PY -u scripts/diag_success_head.py $MODE "$M" PullCube-v1 2>&1 | grep -E "RESULT|values|Error|Traceback"
  done
done
echo DIAG_DONE
