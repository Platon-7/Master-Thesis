#!/bin/bash
#SBATCH --job-name=ms_sac
#SBATCH --output=/scratch-shared/pkarageorgis1/roboref_results/ms_sac_%j.out
#SBATCH --error=/scratch-shared/pkarageorgis1/roboref_results/ms_sac_%j.err
#SBATCH --time=24:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
#
# ManiSkill3 + SAC on Snellius, account pkarageorgis1.
#
# This is jobs/maniskill_sac.job with the three things REBUILD.md says every
# caller had to remember, made unforgettable:
#
#   1. The canonical recipe is BAKED IN (RECIPE_ARGS below). The yaml still
#      inherits algorithm/sac.yaml's LIBERO-tuned gamma=0.99/tau=0.005/
#      batch=128/learning_starts=5000; every published ManiSkill result used
#      CLI overrides that were never written into the config. Passing them here
#      means you cannot silently run a different algorithm by forgetting them.
#   2. RPL_EPISODE_LOG is exported, so episodes.jsonl is always written.
#   3. Paths point at THIS account (pkarageorgis1), not the old one
#      (pkarageorgis), whose /scratch-shared is not readable from here.
#
# Submit from robometer-policy-learning/ (inline VAR=val does NOT propagate on
# Snellius -- use --export):
#
#   sbatch --export=ALL,ARM=dense,MODEL=run2,SEED=0,STEPS=300000 jobs/snellius_maniskill_sac.job
#   sbatch --export=ALL,ARM=dense,MODEL=base,SEED=0,STEPS=300000 jobs/snellius_maniskill_sac.job
#   sbatch --export=ALL,ARM=gt,SEED=0,STEPS=300000               jobs/snellius_maniskill_sac.job
#
# Set RECIPE=0 to opt out of the baked recipe (then you own every knob).

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
mkdir -p logs

TASK="${TASK:-PullCube-v1}"
ARM="${ARM:-dense}"
SEED="${SEED:-0}"
STEPS="${STEPS:-300000}"

# --- which reward model -----------------------------------------------------
# MODEL is the short name; REWARD_CKPT can still be given directly to override.
CKPT_ROOT="/projects/prjs1958/Robometer_FT_consolidated"
MODEL="${MODEL:-run2}"
if [[ -z "${REWARD_CKPT:-}" ]]; then
    case "$MODEL" in
      run2) REWARD_CKPT="$CKPT_ROOT/run2_noicl_ours_step4000" ;;     # RoboRef-Asym
      run3) REWARD_CKPT="$CKPT_ROOT/run3_noicl_standard_step5000" ;; # RoboRef-Std
      base) REWARD_CKPT="robometer/Robometer-4B" ;;
      # Published baselines. roboreward goes through process_batch_helper like the
      # Robometer family; robodopamine and lrm are served by the adapters in
      # utils/baseline_reward_adapters.py. All three are dense, no success head.
      roboreward)   REWARD_CKPT="teetone/RoboReward-4B" ;;
      robodopamine) REWARD_CKPT="tanhuajie2001/Robo-Dopamine-GRM-2.0-4B-Preview" ;;
      lrm)          REWARD_CKPT="USC-PSI-Lab/LRM-models" ;;
      *)    echo "ERROR: MODEL must be run2|run3|base|roboreward|robodopamine|lrm, got '$MODEL'" >&2; exit 2 ;;
    esac
fi
# Which reward_model config group to compose. The three baselines each have their own.
case "$MODEL" in
  roboreward)   REWARD_GROUP=roboreward ;;
  robodopamine) REWARD_GROUP=robodopamine ;;
  lrm)          REWARD_GROUP=lrm ;;
  *)            REWARD_GROUP=robometer ;;
esac
MODEL_TAG="${MODEL_TAG:-$MODEL}"

# --- environment ------------------------------------------------------------
# /scratch-shared purges files not accessed for ~2 weeks and ATE this venv on
# 2026-09-07 (numpy/tqdm/wandb lost their .py files mid-campaign). The venv now
# lives on /projects, which is permanent.
ENV_PREFIX="${ENV_PREFIX:-/projects/prjs1958/$USER/envs/maniskill_rl}"
if [[ ! -x "$ENV_PREFIX/bin/python" ]]; then
    echo "ERROR: no python at $ENV_PREFIX/bin/python" >&2
    echo "Restore it: tar --zstd -xf /projects/prjs1958/pkarageorgis1/maniskill_transfer/env/maniskill_rl.tar.zst -C /scratch-shared/$USER/envs" >&2
    exit 1
fi
export PATH="$ENV_PREFIX/bin:$PATH"
PYTHON="$ENV_PREFIX/bin/python"

export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="${MS_ASSET_DIR:-/scratch-shared/$USER/maniskill_assets}"
export HF_HOME="${HF_HOME:-/scratch-shared/$USER/hf_cache}"
export TORCH_HOME="${TORCH_HOME:-/scratch-shared/$USER/torch_cache}"
export SAPIEN_CACHE_DIR="${SAPIEN_CACHE_DIR:-/scratch-shared/$USER/sapien_cache}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
# Every RoboRef checkpoint bakes use_unsloth:true into config.yaml; we only ever
# run the reward model in inference, which plain from_pretrained serves.
export ROBOMETER_DISABLE_UNSLOTH=1
export WANDB_PROJECT="${WANDB_PROJECT:-roboref_maniskill}"
export WANDB_ENTITY="${WANDB_ENTITY:-nlp-squad}"
if [[ -z "${WANDB_MODE:-}" ]]; then
    grep -q 'api.wandb.ai' "$HOME/.netrc" 2>/dev/null && export WANDB_MODE=online || export WANDB_MODE=offline
fi

# --- per-arm overrides ------------------------------------------------------
# add_estimated_reward=false -> the model REPLACES the env reward (pure regime).
case "$ARM" in
  gt)
    MODEL_TAG="gt"
    ARM_ARGS=(
      "env.use_gt_rewards=true"
      "env.env_kwargs.reward_mode=normalized_dense"
    )
    ;;
  dense)
    ARM_ARGS=(
      "reward_model=$REWARD_GROUP"
      "reward_model.model_path=$REWARD_CKPT"
      "reward_model.add_estimated_reward=false"
      "reward_model.use_success_detection=false"   # no VLM termination
      "env.use_gt_rewards=false"
      "env.env_kwargs.reward_mode=sparse"
    )
    ;;
  *)
    echo "ERROR: ARM must be gt|dense, got '$ARM'" >&2; exit 2 ;;
esac

# --- the canonical recipe (REBUILD.md "What actually works") ----------------
# gamma=0.95 (NOT the yaml's 0.99, NOT the older 0.8); reward_shift=0.0 because
# with terminate_on_success=false the episode is a fixed horizon, so the -1.0
# shift buys nothing and only depresses the dense signal.
RECIPE_ARGS=()
if [[ "${RECIPE:-1}" == "1" ]]; then
    RECIPE_ARGS=(
      "online_algorithm.gamma=0.95"
      "online_algorithm.tau=0.01"
      "online_algorithm.batch_size=1024"
      "online_algorithm.learning_starts=4000"
      "env.terminate_on_success=false"   # no GT leak through `done`
      "env.reward_shift=0.0"
      "training.num_envs=4"
    )
fi

read -r -a EXTRA_ARR <<< "${EXTRA_ARGS:-}"

# Resume from a checkpoint dir (<run>/checkpoints/<env_step>). The step counter
# restarts at 0 and the replay buffer is NOT restored (it refills from
# learning_starts), so STEPS must be the REMAINING budget, and eval curves need
# offsetting by the checkpoint step when plotted.
RESUME_ARGS=()
if [[ -n "${RESUME_FROM:-}" ]]; then
    [[ -f "$RESUME_FROM/actor.pt" ]] || { echo "ERROR: no actor.pt in $RESUME_FROM" >&2; exit 5; }
    RESUME_ARGS=("training.load_dir=$RESUME_FROM")
    echo "RESUMING from $RESUME_FROM (STEPS=$STEPS is the REMAINING budget)"
fi

RUN_DIR="${RUN_DIR:-/scratch-shared/$USER/roboref_runs/ms_${TASK}_${MODEL_TAG}_${ARM}_s${SEED}_$(date +%Y%m%d_%H%M%S)}"
mkdir -p "$RUN_DIR"
# Per-episode instrumentation -> $RUN_DIR/episodes.jsonl (REBUILD.md).
export RPL_EPISODE_LOG="$RUN_DIR"

echo "==================== launch ===================="
echo "JOB         : ${SLURM_JOB_ID:-<none>} on $(hostname)"
echo "TASK        : $TASK"
echo "ARM         : $ARM"
echo "MODEL_TAG   : $MODEL_TAG"
echo "REWARD_CKPT : $REWARD_CKPT   (config group: $REWARD_GROUP)"
echo "SEED        : $SEED"
echo "STEPS       : $STEPS"
echo "RECIPE      : ${RECIPE:-1}  -> ${RECIPE_ARGS[*]:-<off>}"
echo "EXTRA_ARGS  : ${EXTRA_ARGS:-<none>}"
echo "RUN_DIR     : $RUN_DIR"
echo "ENV_PREFIX  : $ENV_PREFIX"
echo "WANDB_MODE  : $WANDB_MODE"
echo "==============================================="

echo "[preflight] importing the training stack"
"$PYTHON" -c "
from robometer_policy_learning.runners.serial_runner import SerialRunner
from robometer_policy_learning.buffers.robometer_replay_buffer import RobometerReplayBuffer
from robometer_policy_learning.algorithms.sac import SAC
from robometer_policy_learning.utils.training_utils import setup_training, create_buffer
print('training stack imports OK')
" || { echo "ERROR: training stack failed to import." >&2; exit 3; }

echo "[preflight] verifying environment"
"$PYTHON" scripts/verify_maniskill_env.py --task "$TASK" || {
    echo "ERROR: environment verification failed." >&2; exit 3; }

"$PYTHON" scripts/train.py \
  --config-path=../robometer_policy_learning/configs \
  --config-name=maniskill_online_rl \
  "env.env_name=maniskill/$TASK" \
  algorithm@online_algorithm=sac \
  alg.online_alg_name=sac \
  training.num_rollouts="$STEPS" \
  training.seed="$SEED" \
  logging.wandb_name="ms_${TASK}_${MODEL_TAG}_${ARM}_s${SEED}" \
  logging.wandb_entity="$WANDB_ENTITY" \
  "hydra.run.dir=$RUN_DIR" \
  "logging.wandb_log_dir_base=$RUN_DIR/wandb" \
  "${ARM_ARGS[@]}" \
  "${RECIPE_ARGS[@]}" \
  "${RESUME_ARGS[@]}" \
  "${EXTRA_ARR[@]}"
RC=$?
echo "EXIT=$RC"
exit $RC
