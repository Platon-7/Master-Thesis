#!/bin/bash
#SBATCH --job-name=sdict
#SBATCH --output=logs/sdict_%j.out
#SBATCH --error=logs/sdict_%j.err
#SBATCH --time=00:40:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
PY=/scratch-shared/$USER/envs/maniskill_rl/bin/python
D=/scratch-shared/$USER/gpu_state_diag; mkdir -p $D
T=${TASK:-PokeCube-v1}
timeout 900 $PY -u scripts/diag_state_dict.py "$T" physx_cpu  "$D/${T}_cpu.json"
timeout 900 $PY -u scripts/diag_state_dict.py "$T" physx_cuda "$D/${T}_gpu.json"
timeout 300 $PY -u - <<PYEOF
import json, numpy as np
D="$D"; T="$T"
c=json.load(open(f"{D}/{T}_cpu.json")); g=json.load(open(f"{D}/{T}_gpu.json"))
print(f"\n=== {T}: fields that differ (CPU vs GPU) ===")
for k in sorted(set(c)|set(g)):
    a,b=np.array(c.get(k,[])),np.array(g.get(k,[]))
    if a.shape!=b.shape: print(f"  {k:34s} SHAPE {a.shape} vs {b.shape}"); continue
    d=np.abs(a-b).max() if a.size else 0
    if d>1e-4: print(f"  {k:34s} max|diff|={d:.4f}\n      cpu={np.round(a,4)}\n      gpu={np.round(b,4)}")
PYEOF
