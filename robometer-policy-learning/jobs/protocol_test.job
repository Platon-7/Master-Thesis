#!/bin/bash
#SBATCH --job-name=proto
#SBATCH --output=logs/proto_%j.out
#SBATCH --error=logs/proto_%j.err
#SBATCH --time=01:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
PY=/scratch-shared/$USER/envs/maniskill_rl/bin/python
# Same loop, same episode count, both backends -- isolates protocol from backend.
# One process per backend: PhysX cannot switch inside an interpreter.
for BK in physx_cpu physx_cuda; do
  for NE in 1 16; do
    timeout 2400 $PY -u - <<PYEOF
import sys, glob, os, torch
sys.path.insert(0, ".")
from scripts.verify_with_maniskill_ppo import build_actor, run_ours_gpu
from robometer_policy_learning.envs.maniskill_utils import get_task_spec
T="${TASK:-PokeCube-v1}"; spec=get_task_spec(T)
ck=glob.glob(os.path.join(os.environ["MS_ASSET_DIR"],"demos",T,"**",f"ppo_{spec.control_mode}_ckpt.pt"),recursive=True)
sd=torch.load(ck[0],map_location="cpu",weights_only=False)
actor=build_actor(sd, sd["actor_mean.0.weight"].shape[1], sd["actor_mean.6.weight"].shape[0])
s,n = run_ours_gpu(T, actor, spec.control_mode, 64, spec.max_episode_steps, num_envs=$NE, backend="$BK")
print(f"PROTO {T} backend=$BK num_envs=$NE  {s}/{n} = {100*s/max(1,n):.0f}%")
PYEOF
  done
done
