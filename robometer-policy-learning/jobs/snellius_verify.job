#!/bin/bash
#SBATCH --job-name=ms_verify
#SBATCH --output=/scratch-shared/pkarageorgis1/roboref_results/ms_verify_%j.out
#SBATCH --error=/scratch-shared/pkarageorgis1/roboref_results/ms_verify_%j.err
#SBATCH --time=00:20:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=60G
#
# Post-transfer sanity check of the maniskill_rl venv on THIS account
# (pkarageorgis1). Runs the repo's own verifier, which needs a GPU because
# SAPIEN's rasterizer does.
#
#   sbatch --export=ALL,TASK=PullCube-v1 jobs/snellius_verify.job

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"

TASK="${TASK:-PullCube-v1}"
# /scratch-shared purges files not accessed for ~2 weeks and ATE this venv on
# 2026-09-07 (numpy/tqdm/wandb lost their .py files mid-campaign). The venv now
# lives on /projects, which is permanent.
ENV_PREFIX="${ENV_PREFIX:-/projects/prjs1958/$USER/envs/maniskill_rl}"
PYTHON="$ENV_PREFIX/bin/python"
export PATH="$ENV_PREFIX/bin:$PATH"

export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export HF_HOME="/scratch-shared/$USER/hf_cache"
export TORCH_HOME="/scratch-shared/$USER/torch_cache"
export SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
export ROBOMETER_DISABLE_UNSLOTH=1

echo "== node: $(hostname)  gpu: $(nvidia-smi --query-gpu=name --format=csv,noheader) =="
echo "== python: $($PYTHON -V 2>&1) =="

echo "[1/3] robometer resolves to the real fork (TRAP 3)"
$PYTHON -c "
import robometer, robometer.data.dataset_types
assert 'Master-Thesis/Robometer' in robometer.__file__, robometer.__file__
print('  OK', robometer.__file__)
" || exit 3

echo "[2/3] training stack imports"
$PYTHON -c "
from robometer_policy_learning.runners.serial_runner import SerialRunner
from robometer_policy_learning.buffers.robometer_replay_buffer import RobometerReplayBuffer
from robometer_policy_learning.algorithms.sac import SAC
from robometer_policy_learning.algorithms.sac.configuration_sac import SACConfig
from robometer_policy_learning.utils.training_utils import setup_training, create_buffer
assert hasattr(SACConfig, 'kl_ref_refresh_interval'), 'KL trust-region fix missing'
print('  OK (incl. kl_ref_refresh_interval)')
" || exit 3

echo "[3/3] verify_maniskill_env.py --task $TASK"
$PYTHON scripts/verify_maniskill_env.py --task "$TASK"
RC=$?
echo "EXIT=$RC"
exit $RC
