#!/bin/bash
#SBATCH --job-name=calib
#SBATCH --output=logs/calib_%j.out
#SBATCH --error=logs/calib_%j.err
#SBATCH --time=08:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
#
# Full calibration: collect labelled trajectories, score them with each model's
# SUCCESS head, then pick per-(model,task) thresholds at a matched false-positive
# rate. Required before the stop-on-detection regime: the threshold IS the
# termination trigger, and bce_asymmetric moves each model's operating point.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export HF_HOME="/scratch-shared/$USER/hf_cache" SAPIEN_CACHE_DIR="/scratch-shared/$USER/sapien_cache"
export TOKENIZERS_PARALLELISM=false ROBOMETER_DISABLE_UNSLOTH=1
PY=/scratch-shared/$USER/envs/maniskill_rl/bin/python
S=scripts/calibrate_success_threshold.py
CK=/scratch-shared/$USER/roboref_checkpoints
for T in PullCube-v1 LiftPegUpright-v1; do
  echo "########## collect $T ##########"
  timeout 3000 $PY -u $S collect --task "$T" --episodes 60 --random-episodes 30
  for M in "run2=$CK/run2_noicl_ours_step4000" "run3=$CK/run3_noicl_standard_step5000" "base=robometer/Robometer-4B"; do
    tag="${M%%=*}"; path="${M#*=}"
    echo "########## score $T / $tag ##########"
    timeout 5400 $PY -u $S score --task "$T" --model "$path" --tag "$tag" --step-stride 2
  done
  echo "########## fit $T ##########"
  timeout 900 $PY -u $S fit --task "$T" --target-fpr 0.02
done
echo "CALIBRATION_DONE"
