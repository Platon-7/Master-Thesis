#!/bin/bash
#SBATCH --job-name=ms_sac
#SBATCH --output=logs/hipster_sac_%j.out
#SBATCH --error=logs/hipster_sac_%j.err
#SBATCH --time=48:00:00
#SBATCH --partition=capacity
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=47G
# HPC policy (Faculty HPC Community Council 2025-06-02): claim resources
# FRACTIONALLY to GPUs -- l4: 16 cores/47GB per GPU; performance: 32 cores/96GB;
# fp64: 48 cores/128GB. capacity: <=256 cores over <=2 servers. Measured peak RSS
# of these runs is ~21GB, so 47G is ample; the previous 120G silently forced a
# 42-core allocation and capped us at 6 concurrent jobs instead of 16.
#
# Hipster-cluster adaptation of maniskill_sac.job (Snellius original). Same
# ARM/TASK/SEED/STEPS/REWARD_CKPT/TERMINATE/EXTRA_ARGS/STATE_ONLY interface;
# only paths, partition, and $USER handling changed.
#
# Submit with:
#   sbatch --export=ALL,ARM=dense,TASK=PullCube-v1,VARIANT=my_variant,EXTRA_ARGS='...' jobs/hipster_maniskill_sac.job

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
mkdir -p logs

# SLURM does not reliably propagate $USER into the batch environment on this
# cluster (observed empty, breaking every /scratch/$USER/... path below).
export USER="${USER:-$(whoami)}"

# Python 3.11's cwd-shadowing guard: without this, `python -c`/script-mode
# prepends '' (cwd == repo root) to sys.path, and repo root contains a stale
# `robometer/` submodule (missing robometer.data) that shadows the real
# `robometer` fork installed from ~/Master-Thesis/Robometer, regardless of
# pip install order or PYTHONPATH. Confirmed necessary on this cluster.
export PYTHONSAFEPATH=1

TASK="${TASK:-PullCube-v1}"
ARM="${ARM:-gt}"
SEED="${SEED:-0}"
STEPS="${STEPS:-300000}"
VARIANT="${VARIANT:-default}"
REWARD_CKPT="${REWARD_CKPT:-$HOME/Master-Thesis-transfer/checkpoints/Robometer_FT_consolidated/run2_noicl_ours_step4000}"
MODEL_TAG="${MODEL_TAG:-run2}"

# --- environment ------------------------------------------------------------
ENV_PREFIX="${ENV_PREFIX:-/scratch/$USER/envs/maniskill_rl}"
if [[ ! -x "$ENV_PREFIX/bin/python" ]]; then
    echo "ERROR: no python at $ENV_PREFIX/bin/python" >&2
    exit 1
fi
export PATH="$ENV_PREFIX/bin:$PATH"
PYTHON="$ENV_PREFIX/bin/python"

# The system python3.12 has no dev headers (Python.h), so Triton's JIT-compiled
# CUDA-utils extension (triggered by torch's native-triton ops, e.g. Qwen3-VL's
# rope forward -> bmm_outer_product) fails with "fatal error: Python.h: No such
# file or directory" the first time any triton kernel compiles -- i.e. partway
# into training, not at preflight. gcc reads CPATH as an extra include dir
# regardless of the explicit -I flags triton's build.py passes, so borrowing
# EESSI's Python 3.12.3 headers (patch-version differences don't affect the
# stable C header ABI) fixes it without touching triton's code.
export CPATH="/cvmfs/software.eessi.io/versions/2025.06/software/linux/x86_64/amd/zen4/software/Python/3.12.3-GCCcore-13.3.0/include/python3.12:${CPATH:-}"

# SAPIEN Vulkan fix -- see jobs/hipster_verify.job for the full explanation.
# Extracted NVIDIA driver ICD + modern conda-forge vulkan loader (SAPIEN's own
# bundled 1.3.224 loader cannot negotiate with this driver's ICD interface).
export LD_LIBRARY_PATH="/scratch/$USER/vulkan_loader/extracted/lib:/scratch/$USER/nvidia_driver/extracted:${LD_LIBRARY_PATH:-}"
export VK_ICD_FILENAMES="/scratch/$USER/nvidia_driver/nvidia_icd_abs.json"
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export SAPIEN_HEADLESS=1
export MS_ASSET_DIR="${MS_ASSET_DIR:-/scratch/$USER/maniskill_assets}"
export HF_HOME="${HF_HOME:-/scratch/$USER/hf_cache}"
export TORCH_HOME="${TORCH_HOME:-/scratch/$USER/torch_cache}"
export SAPIEN_CACHE_DIR="${SAPIEN_CACHE_DIR:-/scratch/$USER/sapien_cache}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export ROBOMETER_DISABLE_UNSLOTH=1
export WANDB_PROJECT="${WANDB_PROJECT:-roboref_maniskill}"
export WANDB_ENTITY="${WANDB_ENTITY:-nlp-squad}"
if [[ -z "${WANDB_MODE:-}" ]]; then
    grep -q 'api.wandb.ai' "$HOME/.netrc" 2>/dev/null && export WANDB_MODE=online || export WANDB_MODE=offline
fi

# --- per-arm overrides (identical semantics to maniskill_sac.job) ----------
case "$ARM" in
  gt)
    ARM_ARGS=(
      "env.use_gt_rewards=true"
      "env.env_kwargs.reward_mode=normalized_dense"
      "env.terminate_on_success=true"
    )
    ;;
  dense)
    ARM_ARGS=(
      "reward_model=robometer"
      "reward_model.model_path=$REWARD_CKPT"
      "reward_model.add_estimated_reward=false"
      "env.use_gt_rewards=false"
      "env.env_kwargs.reward_mode=sparse"
      # MANISKILL_HANDOFF.md: reward-model arms MUST run with GT termination off,
      # or `done` leaks ground-truth success into the value function even though
      # the reward itself comes from the VLM. maniskill_sac.job (Snellius) left
      # this to the yaml default / manual EXTRA_ARGS; set it explicitly instead.
      "env.terminate_on_success=false"
    )
    ;;
  icl)
    ICL_BANK="${ICL_BANK:-/scratch/$USER/maniskill_assets/icl_demos/${TASK}.npz}"
    if [[ ! -f "$ICL_BANK" ]]; then
        echo "ERROR: ICL demo bank not found: $ICL_BANK" >&2
        exit 4
    fi
    ARM_ARGS=(
      "reward_model=robometer"
      "reward_model.model_path=$REWARD_CKPT"
      "reward_model.add_estimated_reward=false"
      "reward_model.icl_demo_path=$ICL_BANK"
      "env.use_gt_rewards=false"
      "env.env_kwargs.reward_mode=sparse"
      "env.terminate_on_success=false"
    )
    ;;
  *)
    echo "ERROR: ARM must be gt|dense|icl, got '$ARM'" >&2
    exit 2
    ;;
esac

if [[ "$ARM" != "gt" ]]; then
    if [[ "${TERMINATE:-1}" == "1" ]]; then
        ARM_ARGS+=("reward_model.use_success_detection=true")
    else
        ARM_ARGS+=("reward_model.use_success_detection=false")
    fi
fi

# MANISKILL_HANDOFF.md "Canonical recipe": the values that actually produced the
# published run2/run3/base numbers in NEXT_EXPERIMENTS.md. The now-pulled
# maniskill_online_rl.yaml does NOT bake these in (it still carries sac.yaml's
# LIBERO-tuned gamma=0.99/tau=0.005/batch_size=128/learning_starts=5000), so the
# historical runs must have passed these as CLI overrides at submit time.
# Baked in here so every hipster run reproduces that recipe by default.
ARM_ARGS+=(
  "online_algorithm.gamma=${GAMMA:-0.8}"
  "online_algorithm.tau=${TAU:-0.01}"
  "online_algorithm.batch_size=${BATCH_SIZE:-1024}"
  "online_algorithm.learning_starts=${LEARNING_STARTS:-4000}"
)

# --- offline -> online (the codebase's own recipe) --------------------------
# configs/libero_online_rl.yaml is this repo's reference for offline->online RL:
#   offline_alg_name: iql | bc      num_offline_steps: 100_000
#   buffer.sample_ratio: 0.5        env.h5_dataset_path: <demos>
# IQL is the default there, and the reason matters: its component_names include
# critic and critic_target, so SAC inherits a TRAINED critic. BC transfers only the
# actor, leaving SAC to optimise a cloned policy against a random critic -- which
# destroys it (measured on LiftPeg: 30% warm start -> 0/704 episodes). IQL also
# carries its own conservatism (policy_extraction=awr, ddpg_bc_weight=0.1).
OFFLINE_ALG="${OFFLINE_ALG:-iql}"
if [[ -n "${DEMO_H5:-}" ]]; then
    if [[ ! -f "$DEMO_H5" ]]; then
        echo "ERROR: DEMO_H5 not found: $DEMO_H5" >&2; exit 6
    fi
    ARM_ARGS+=(
      "algorithm@offline_algorithm=${OFFLINE_ALG}"
      "alg.offline_alg_name=${OFFLINE_ALG}"
      "+env.h5_dataset_path=$DEMO_H5"
      "training.num_offline_steps=${OFFLINE_STEPS:-100000}"
      "buffer.sample_ratio=${SAMPLE_RATIO:-0.5}"
    )
    echo "OFFLINE->ONLINE: ${OFFLINE_ALG}, ${OFFLINE_STEPS:-100000} steps, "\
         "sample_ratio ${SAMPLE_RATIO:-0.5}, demos $(basename "$DEMO_H5")"
fi

# --- checkpointing / resume -------------------------------------------------
# Checkpoints hold actor+critic+critic_target+optimizers+log_ent_coef (~98 MB each).
# The REPLAY BUFFER is deliberately NOT saved: obs include the raw 224x224x3 image
# (the actor has a Linear(150528,384) on it, so it cannot be dropped without
# changing the architecture), which puts a 300k-capacity dump at tens of GB per
# job -- untenable on a /scratch that is 92% full and shared. A resume therefore
# restores the POLICY and CRITIC but refills the buffer from scratch.
SAVE_INTERVAL="${SAVE_INTERVAL:-50000}"     # 1.5M/50k = 30 ckpts ~ 2.9 GB per run
ARM_ARGS+=("training.save_interval=${SAVE_INTERVAL}")
# RESUME_FROM=/path/to/run/checkpoints/<env_step>   (dir name IS the env step)
if [[ -n "${RESUME_FROM:-}" ]]; then
    if [[ ! -f "$RESUME_FROM/actor.pt" ]]; then
        echo "ERROR: RESUME_FROM has no actor.pt: $RESUME_FROM" >&2; exit 5
    fi
    ARM_ARGS+=("training.load_dir=$RESUME_FROM")
    echo "RESUMING from $RESUME_FROM (buffer NOT restored; STEPS should be the REMAINING budget)"
fi

# Match SAC's entropy target to that sigma, otherwise the tuner inflates the noise
# straight back up (auto = -dim(A) implies sigma ~0.09 only after a long collapse).
# H = d*(ln(sigma) + 0.5*ln(2*pi*e)); sigma=0.15 -> -1.91 (4-D), -3.35 (7-D).
if [[ -n "${TARGET_ENTROPY:-}" ]]; then
    ARM_ARGS+=("online_algorithm.target_entropy=${TARGET_ENTROPY}")
    echo "TARGET_ENTROPY: ${TARGET_ENTROPY}"
fi

read -r -a EXTRA_ARR <<< "${EXTRA_ARGS:-}"

if [[ "${STATE_ONLY:-0}" == "1" ]]; then
    EXTRA_ARR+=("model.dinov2_model=null" "env.extra_keys_to_drop=[language,image]")
fi

RUN_DIR="${RUN_DIR:-/scratch/$USER/roboref_runs/ms_${TASK}_${MODEL_TAG}_${VARIANT}_s${SEED}_$(date +%Y%m%d_%H%M%S)}"
mkdir -p "$RUN_DIR"

# On-policy episode instrumentation -> $RUN_DIR/episodes.jsonl (one record per
# training episode). Runs in every regime including dense no-termination, which
# is where the overoptimisation metrics (d'_onpolicy, farm_ratio, rho) live.
# Set RPL_EPISODE_LOG=0 to disable.
if [[ "${RPL_EPISODE_LOG:-1}" != "0" ]]; then
    export RPL_EPISODE_LOG="$RUN_DIR"
    # Provenance must describe the threshold ACTUALLY in force, not one we happen
    # to know about: the same model reads false_rate 1.00 at thr=0.10 and 0.00 at
    # thr=0.6875, so a mislabelled record is worse than an unlabelled one. Left to
    # the buffer's own default (the config key) unless a caller overrides it with
    # a real calibration reference at the same time it overrides the threshold.
    export RPL_THRESHOLD_SOURCE="${RPL_THRESHOLD_SOURCE:-config:reward_model.success_detection_threshold}"
fi

echo "==================== launch ===================="
echo "VARIANT     : $VARIANT"
echo "EXTRA_ARGS  : ${EXTRA_ARGS:-<none>}"
echo "RUN_DIR     : $RUN_DIR"
echo "TASK        : $TASK"
echo "ARM         : $ARM"
echo "MODEL_TAG   : $MODEL_TAG"
echo "REWARD_CKPT : $REWARD_CKPT"
echo "SEED        : $SEED"
echo "STEPS       : $STEPS"
echo "SAVE_INTERVAL: $SAVE_INTERVAL"
echo "RESUME_FROM : ${RESUME_FROM:-<none>}"
echo "DEMO_H5     : ${DEMO_H5:-<none, from scratch>}"
echo "TERMINATE   : ${TERMINATE:-1}"
echo "ENV_PREFIX  : $ENV_PREFIX"
echo "WANDB_MODE  : $WANDB_MODE"
echo "Node        : $(hostname)"
echo "==============================================="

echo "[preflight] importing the training stack"
"$PYTHON" -c "
from robometer_policy_learning.runners.serial_runner import SerialRunner
from robometer_policy_learning.buffers.robometer_replay_buffer import RobometerReplayBuffer
from robometer_policy_learning.algorithms.sac import SAC
from robometer_policy_learning.utils.training_utils import setup_training, create_buffer
print('training stack imports OK')
" || {
    echo "ERROR: training stack failed to import; not starting training." >&2
    exit 3
}

echo "[preflight] verifying environment"
"$PYTHON" scripts/verify_maniskill_env.py --task "$TASK" || {
    echo "ERROR: environment verification failed; not starting training." >&2
    exit 3
}

"$PYTHON" scripts/train.py \
  --config-path=../robometer_policy_learning/configs \
  --config-name=maniskill_online_rl \
  "env.env_name=maniskill/$TASK" \
  algorithm@online_algorithm=sac \
  alg.online_alg_name=sac \
  training.num_rollouts="$STEPS" \
  training.seed="$SEED" \
  logging.wandb_name="ms_${TASK}_${MODEL_TAG}_${VARIANT}_s${SEED}" \
  logging.wandb_entity="$WANDB_ENTITY" \
  "hydra.run.dir=$RUN_DIR" \
  "logging.wandb_log_dir_base=$RUN_DIR/wandb" \
  "${ARM_ARGS[@]}" \
  "${EXTRA_ARR[@]}"
RC=$?

echo "EXIT=$RC"
exit $RC
