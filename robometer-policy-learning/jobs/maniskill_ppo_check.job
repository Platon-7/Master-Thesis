#!/bin/bash
#SBATCH --job-name=ms_ppochk
#SBATCH --output=logs/ms_ppochk_%j.out
#SBATCH --error=logs/ms_ppochk_%j.err
#SBATCH --time=00:40:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
PYTHON="/scratch-shared/$USER/envs/maniskill_rl/bin/python"
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl SAPIEN_HEADLESS=1
export MS_ASSET_DIR="/scratch-shared/$USER/maniskill_assets"
export HF_HOME="/scratch-shared/$USER/hf_cache"
export ROBOMETER_DISABLE_UNSLOTH=1
for T in ${TASKS:-PullCube-v1}; do
  echo ""; echo "########## $T ##########"
  timeout 1800 "$PYTHON" -u scripts/verify_with_maniskill_ppo.py --task "$T" --episodes 20
  echo "RC_$T=$?"
done
