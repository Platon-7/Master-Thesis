#!/bin/bash
#SBATCH --job-name=test_sampling
#SBATCH --output=/gpfs/home3/pkarageorgis1/Master-Thesis/logs/test_sampling_%j.out
#SBATCH --error=/gpfs/home3/pkarageorgis1/Master-Thesis/logs/test_sampling_%j.err
#SBATCH --time=00:20:00
#SBATCH --partition=staging
#SBATCH --cpus-per-task=8
