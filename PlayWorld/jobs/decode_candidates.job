#!/bin/bash
#SBATCH --job-name=pw_decode
#SBATCH --output=/home/pkarageorgis/DAS-5/Master-Thesis/PlayWorld/logs/decode_candidates_%j.out
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --cpus-per-task=4
#SBATCH --time=00:15:00

source $(conda info --base)/etc/profile.d/conda.sh
conda activate ctrl-world

export HF_HOME="/scratch-shared/pkarageorgis/hf_cache"
export PYTHONUNBUFFERED=1

python3 << 'PYEOF'
import torch, json, numpy as np
from pathlib import Path
from PIL import Image
import sys

sys.path.insert(0, "/home/pkarageorgis/DAS-5/Master-Thesis/Ctrl-World")

data_dir = Path("/scratch-shared/pkarageorgis/playworld_data/v0_2025_12_28_2000")
out_dir = Path("/home/pkarageorgis/DAS-5/Master-Thesis/PlayWorld/verification/candidates")

from diffusers import AutoencoderKLTemporalDecoder
vae = AutoencoderKLTemporalDecoder.from_pretrained(
    "/scratch-shared/pkarageorgis/hf_cache/stable-video-diffusion-img2vid",
    subfolder="vae"
).to("cuda").to(torch.bfloat16)

def decode_frames(vae, latents, indices):
    selected = latents[indices].to("cuda").to(torch.bfloat16)
    selected = selected / vae.config.scaling_factor
    with torch.no_grad():
        decoded = vae.decode(selected, num_frames=selected.shape[0]).sample
    video = ((decoded / 2.0 + 0.5).clamp(0, 1) * 255)
    video = video.detach().float().cpu().numpy().transpose(0, 2, 3, 1).astype(np.uint8)
    return [video[i] for i in range(video.shape[0])]

for tid in ["105", "110", "1128", "100", "111"]:
    print(f"\nDecoding trajectory {tid}...")
    lat_path = data_dir / "latent_videos" / "train" / tid / "0.pt"
    latents = torch.load(str(lat_path), map_location="cpu")
    n = latents.shape[0]
    indices = [0, n // 4, n // 2, 3 * n // 4, n - 1]
    frames = decode_frames(vae, latents, indices)

    tdir = out_dir / tid
    tdir.mkdir(parents=True, exist_ok=True)
    for i, (idx, frame) in enumerate(zip(indices, frames)):
        Image.fromarray(frame).save(str(tdir / f"frame_{idx:03d}.jpg"), quality=95)

    # Also save annotation summary
    ann_path = data_dir / "annotation" / "train" / f"{tid}.json"
    with open(ann_path) as f:
        ann = json.load(f)
    states = np.array(ann["states"])
    print(f"  {n} frames, {len(states)} states")
    print(f"  X: [{states[:,0].min():.3f}, {states[:,0].max():.3f}]")
    print(f"  Y: [{states[:,1].min():.3f}, {states[:,1].max():.3f}]")
    print(f"  Z: [{states[:,2].min():.3f}, {states[:,2].max():.3f}]")
    print(f"  Gripper (dim6): [{states[:,6].min():.3f}, {states[:,6].max():.3f}]")
    print(f"  Saved to {tdir}")

print("\nDone!")
PYEOF
