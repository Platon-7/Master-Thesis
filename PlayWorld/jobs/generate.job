#!/bin/bash
#SBATCH --job-name=pw_generate
#SBATCH --output=/home/pkarageorgis/DAS-5/Master-Thesis/PlayWorld/logs/generate_%j.out
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --mem=48G
#SBATCH --cpus-per-task=4
#SBATCH --time=06:00:00

source $(conda info --base)/etc/profile.d/conda.sh
conda activate ctrl-world

export HF_HOME="/scratch-shared/pkarageorgis/hf_cache"
export HF_TOKEN="hf_YOUR_TOKEN_HERE"
export CTRLWORLD_DIR="/home/pkarageorgis/DAS-5/Master-Thesis/Ctrl-World"
export PYTHONUNBUFFERED=1

SCRIPT="/home/pkarageorgis/DAS-5/Master-Thesis/PlayWorld/generate_failures.py"

echo "============================================"
echo "PlayWorld Failure Generation"
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "============================================"

nvidia-smi

python $SCRIPT \
    --num-episodes 100 \
    --noise-scale 0.5 \
    --n-interact 10 \
    --strategy all

echo "============================================"
echo "Done at: $(date)"
echo "============================================"
