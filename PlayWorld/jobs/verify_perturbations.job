#!/bin/bash
#SBATCH --job-name=pw_verify
#SBATCH --output=/home/pkarageorgis/DAS-5/Master-Thesis/PlayWorld/logs/verify_perturbations_%j.out
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --mem=48G
#SBATCH --cpus-per-task=4
#SBATCH --time=01:00:00

source $(conda info --base)/etc/profile.d/conda.sh
conda activate ctrl-world

export HF_HOME="/scratch-shared/pkarageorgis/hf_cache"
export CTRLWORLD_DIR="/home/pkarageorgis/DAS-5/Master-Thesis/Ctrl-World"
export PYTHONUNBUFFERED=1

echo "============================================"
echo "PlayWorld Perturbation Verification"
echo "Job ID: $SLURM_JOB_ID"
echo "Date: $(date)"
echo "============================================"

nvidia-smi

OUTDIR="/home/pkarageorgis/DAS-5/Master-Thesis/PlayWorld/verification_traj1"
rm -rf "$OUTDIR"

python /home/pkarageorgis/DAS-5/Master-Thesis/PlayWorld/verify_perturbations.py \
    --traj-id 1 \
    --n-interact 10 \
    --output-dir "$OUTDIR"

# Convert each experiment's frames to MP4 for easy viewing
echo ""
echo "Converting frames to MP4s..."
for d in "$OUTDIR"/*/; do
    name=$(basename "$d")
    n_frames=$(ls "$d"/frame_*.jpg 2>/dev/null | wc -l)
    if [ "$n_frames" -gt 0 ]; then
        ffmpeg -y -framerate 5 -i "$d/frame_%03d.jpg" \
            -c:v libx264 -pix_fmt yuv420p -crf 18 \
            "$OUTDIR/${name}.mp4" 2>/dev/null
        echo "  $name.mp4 ($n_frames frames)"
    fi
done

echo "============================================"
echo "Done at: $(date)"
echo "============================================"
