#!/bin/bash
#SBATCH --job-name=ft_inputfmt
#SBATCH --output=logs/diag_ft_inputformat_%j.out
#SBATCH --error=logs/diag_ft_inputformat_%j.err
#SBATCH --time=00:30:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

# Hypothesis: the IBRL "flat output" failure is a pipeline-mismatch bug
# (224x224 + 5 frames) vs training-format (480x480 + 16 frames). This job
# runs the scorer on actual training frames in all 4 combinations and
# reports outputs.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ENV_NAME="${IBRL_CONDA_ENV:-demo2reward}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
export IBRL_CONDA_ENV="$ENV_NAME"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"
source set_env.sh
export PYTHONPATH="$PYTHONPATH:$HERE/../Robometer"
unset WANDB_PROJECT WANDB_ENTITY
export WANDB_MODE=disabled

echo "==================== ft input-format diag ===================="
nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1
python tools/diag_ft_on_training_frames.py
echo "==============================================================="
