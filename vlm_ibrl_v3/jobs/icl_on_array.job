#!/bin/bash
#SBATCH --job-name=icl_on
#SBATCH --output=logs/icl_on_%A_%a.out
#SBATCH --error=logs/icl_on_%A_%a.err
#SBATCH --time=11:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=28G
# Model A (run1) WITH CORRECT-VIEW in-context demos (un-zoomed eval-keyframe success
# clips), CoffeePush + BoxClose, gate on/off, 3 seeds. Fills slide-2 ICL columns.
# config cols: TASK THR SEED GATEFRAC
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
CFG_FILE="${CFG_FILE:-/shared/home/PKA4388/vlm_ibrl_runs/icl_on_configs.tsv}"
LINE=$(( SLURM_ARRAY_TASK_ID + 1 ))
read BC_POLICY ROBOMETER_SUCCESS_THRESHOLD SEED GATEFRAC < <(sed -n "${LINE}p" "$CFG_FILE")
if [[ -z "${BC_POLICY:-}" ]]; then echo "no config at line $LINE"; exit 1; fi
VLM_NAME=robometer_ft
CKPT_NAME=run1_icl_ours_step4000

unset PYTHONPATH CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL 2>/dev/null || true
ENV_NAME="/shared/home/PKA4388/miniconda3/envs/demo2reward_v3"; export IBRL_CONDA_ENV="$ENV_NAME"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true; conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1; source set_env.sh
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"; export MUJOCO_GL=egl
# wandb -> nlp-squad. Key read from a home-dir file (NOT in the repo, never pushed).
export WANDB_API_KEY="$(cat /shared/home/PKA4388/.config/wandb_key 2>/dev/null)"
export WANDB_ENTITY=nlp-squad
export WANDB_PROJECT="${WANDB_PROJECT:-ibrl_v3_icl}"
[[ -n "$WANDB_API_KEY" ]] && USE_WB=1 || { echo "[wandb] no key file -> running offline"; USE_WB=0; }
python -c "import gymnasium, metaworld; print('[env] OK')" || { echo "[env] FAIL"; exit 1; }
export ROBOMETER_FT_PATH="/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/${CKPT_NAME}"

export AUTONOMOUS_SUCCESS=1 V3_CORNER2_ZOOM=1
export ROBOMETER_REWARD_CAMERA=corner2_default ROBOMETER_DETECT_HEAD=success
export ROBOMETER_BETA=0.0 ROBOMETER_SUCCESS_CONSECUTIVE=1 ROBOMETER_THRESHOLD=0.0 ROBOMETER_REWARD_SCALE=1.0
export ROBOMETER_SUCCESS_THRESHOLD
export ROBOMETER_MIN_EP_FRAC="$GATEFRAC"     # 0.8 = gate on, 0.0 = no gate
export ROBOMETER_CONFIRM_K=0 ROBOMETER_REWARD_SAMPLE=0 ROBOMETER_OTSU=0 ROBOMETER_DEMO_ANCHOR=0

# CORRECT-VIEW ICL (un-zoomed eval-keyframe success clips), per task
case "$BC_POLICY" in
    coffeepush) export ROBOMETER_ICL_DEMO_PATH="/shared/home/PKA4388/icl_correct_view/coffeepush" ;;
    boxclose)   export ROBOMETER_ICL_DEMO_PATH="/shared/home/PKA4388/icl_correct_view/boxclose" ;;
    *) echo "no ICL dir for $BC_POLICY"; exit 1 ;;
esac
export ROBOMETER_ICL_DEMO_IDX=0 ROBOMETER_ICL_FRAMES=16
[[ -d "$ROBOMETER_ICL_DEMO_PATH" ]] || { echo "ICL dir missing"; exit 1; }

REWARD_AT_TRUNC=1; EPISODE_LENGTH=200
NUM_TRAIN_STEP="${NUM_TRAIN_STEP:-40000}"; TRAIN_TIMEOUT="${TRAIN_TIMEOUT:-37800}"
GTAG=$([ "$GATEFRAC" = "0.0" ] && echo nogate || echo gate)
SAVE_BASE="${SAVE_BASE:-/shared/home/$USER/vlm_ibrl_runs}"
SAVE_DIR="${SAVE_BASE}/iclon_${CKPT_NAME}_${BC_POLICY}_${GTAG}_s${SEED}_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$SAVE_DIR"
export WANDB_NAME="iclon_A_${BC_POLICY}_${GTAG}_s${SEED}"
echo "ICL-ON A TASK=$BC_POLICY THR=$ROBOMETER_SUCCESS_THRESHOLD SEED=$SEED gate=$GATEFRAC wandb=$USE_WB($WANDB_ENTITY)"
echo "ICL=$ROBOMETER_ICL_DEMO_PATH  SAVE=$SAVE_DIR"; echo "==============="

timeout --kill-after=30s --signal=TERM "$TRAIN_TIMEOUT" \
    python mw_main/train_rl_vlm_mw.py \
        --config_path release/cfgs/metaworld/ibrl_long.yaml \
        --episode_length "$EPISODE_LENGTH" --bc_policy "$BC_POLICY" --vlm "$VLM_NAME" \
        --train_end_on_success 0 --reward_at_truncation "$REWARD_AT_TRUNC" \
        --num_train_step "$NUM_TRAIN_STEP" --seed "$SEED" --use_wb "$USE_WB" \
        --robometer_beta "$ROBOMETER_BETA" --robometer_threshold "$ROBOMETER_THRESHOLD" \
        --robometer_reward_scale "$ROBOMETER_REWARD_SCALE" --save_dir "$SAVE_DIR"
RC=$?
if [[ $RC -eq 124 || $RC -eq 137 ]]; then
    grep -q "^${NUM_TRAIN_STEP}: " "$SAVE_DIR/train.log" 2>/dev/null && { echo "[wrapper] timeout-but-reached PASS"; RC=0; } || echo "[wrapper] timeout early"
fi
echo "return code: $RC"
