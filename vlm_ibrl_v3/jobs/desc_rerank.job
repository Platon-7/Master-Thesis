#!/bin/bash
#SBATCH --job-name=desc_rerank
#SBATCH --output=logs/desc_rerank_%j.out
#SBATCH --error=logs/desc_rerank_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6-1gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
unset PYTHONPATH CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL 2>/dev/null || true
ENV_NAME="/shared/home/PKA4388/miniconda3/envs/demo2reward_v3"
export IBRL_CONDA_ENV="$ENV_NAME"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1
source set_env.sh
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
python -c "import torch,transformers; print('[env] torch',torch.__version__,'tf',transformers.__version__)" || { echo "[env] FAIL"; exit 1; }
export ROBOMETER_FT_PATH="${ROBOMETER_FT_PATH:-/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run1_icl_ours_step4000}"
echo "[desc] ckpt=$ROBOMETER_FT_PATH"
python ../reward-model-study/scripts/desc_rerank.py
echo "=== done (exit $?) ==="
