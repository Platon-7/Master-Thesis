#!/bin/bash
#SBATCH --job-name=merge_lora_run5
#SBATCH --output=logs/merge_lora_run5_%j.out
#SBATCH --error=logs/merge_lora_run5_%j.err
#SBATCH --time=00:30:00
#SBATCH --account=gusei17535
#SBATCH --partition=staging
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

# Merge run5_l2_lambda03 LoRA checkpoints (step 4500 and step 7500) into clean
# full safetensors that vlm_ibrl's `robometer_ft` scorer can load. CPU-only.
#
# Source: /scratch-shared/$USER/LoRA_step_curves_v3/loss2_step{4500,7500}_run5_l2_lambda03_iclon/...
# Target: /scratch-shared/$USER/Robometer_FT_consolidated/run5_lora_l2_lambda03_step{4500,7500}_merged

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ENV_NAME="${IBRL_CONDA_ENV:-demo2reward}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"

SCRIPT="$HERE/../loss-debug/merge_lora_to_safetensors.py"

for STEP in 4500 7500; do
    IN_DIR="/scratch-shared/$USER/LoRA_step_curves_v3/loss2_step${STEP}_run5_l2_lambda03_iclon/robometer_lora_loss2_c51_asymmetric/ckpt-avg-5metrics=0.0000_step=0"
    OUT_DIR="/scratch-shared/$USER/Robometer_FT_consolidated/run5_lora_l2_lambda03_step${STEP}_merged"
    echo "==================== merging step=$STEP ===================="
    echo "IN  = $IN_DIR"
    echo "OUT = $OUT_DIR"
    python "$SCRIPT" --in-dir "$IN_DIR" --out-dir "$OUT_DIR" --lora-alpha 64 --lora-r 32
    RC=$?
    if [[ $RC -ne 0 ]]; then
        echo "[merge_lora_run5] FAILED on step=$STEP rc=$RC"
        exit $RC
    fi
done

echo "[merge_lora_run5] DONE both"
