#!/bin/bash
#SBATCH --job-name=base4b_gate
#SBATCH --output=logs/base4b_gate_%A_%a.out
#SBATCH --error=logs/base4b_gate_%A_%a.err
#SBATCH --time=07:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6-1gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
# Off-the-shelf 4B baseline + gate (0.8x demo) at its own calibrated threshold.
# config cols: TASK THR SEED
set -uo pipefail; cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
CFG_FILE="${CFG_FILE:-/shared/home/PKA4388/vlm_ibrl_runs/base4b_gate_configs.tsv}"
LINE=$(( SLURM_ARRAY_TASK_ID + 1 ))
read BC_POLICY ROBOMETER_SUCCESS_THRESHOLD SEED < <(sed -n "${LINE}p" "$CFG_FILE")
[[ -z "${BC_POLICY:-}" ]] && { echo "no config line $LINE"; exit 1; }
VLM_NAME=robometer_4b
unset PYTHONPATH CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward_v3"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true; conda activate "$IBRL_CONDA_ENV"
export PYTHONNOUSERSITE=1; source set_env.sh
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"; export MUJOCO_GL=egl
export WANDB_API_KEY="$(cat /shared/home/PKA4388/.config/wandb_key 2>/dev/null)"; export WANDB_ENTITY=nlp-squad
[[ -n "$WANDB_API_KEY" ]] && USE_WB=1 || USE_WB=0
python -c "import gymnasium, metaworld; print('[env] OK')" || { echo FAIL; exit 1; }
export AUTONOMOUS_SUCCESS=1 V3_CORNER2_ZOOM=1
export ROBOMETER_REWARD_CAMERA=corner2_default ROBOMETER_DETECT_HEAD=success
export ROBOMETER_BETA=0.0 ROBOMETER_SUCCESS_CONSECUTIVE=1 ROBOMETER_THRESHOLD=0.0 ROBOMETER_REWARD_SCALE=1.0
export ROBOMETER_SUCCESS_THRESHOLD
export ROBOMETER_MIN_EP_FRAC=0.8      # SAME gate rule (0.8 x demo length)
export ROBOMETER_CONFIRM_K=0 ROBOMETER_REWARD_SAMPLE=0 ROBOMETER_OTSU=0 ROBOMETER_DEMO_ANCHOR=0
REWARD_AT_TRUNC=1; EPISODE_LENGTH=200; NUM_TRAIN_STEP=40000; TRAIN_TIMEOUT=24000
SAVE_DIR="/shared/home/$USER/vlm_ibrl_runs/base4b_${BC_POLICY}_g0.8_s${SEED}_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$SAVE_DIR"; export WANDB_NAME="base4b_${BC_POLICY}_s${SEED}"
echo "4b BASELINE TASK=$BC_POLICY THR=$ROBOMETER_SUCCESS_THRESHOLD SEED=$SEED gate=0.8"
timeout --kill-after=30s --signal=TERM "$TRAIN_TIMEOUT" \
  python mw_main/train_rl_vlm_mw.py --config_path release/cfgs/metaworld/ibrl_long.yaml \
    --episode_length "$EPISODE_LENGTH" --bc_policy "$BC_POLICY" --vlm "$VLM_NAME" \
    --train_end_on_success 0 --reward_at_truncation "$REWARD_AT_TRUNC" \
    --num_train_step "$NUM_TRAIN_STEP" --seed "$SEED" --use_wb "$USE_WB" \
    --robometer_beta 0.0 --robometer_threshold 0.0 --robometer_reward_scale 1.0 --save_dir "$SAVE_DIR"
RC=$?; [[ $RC -eq 124 || $RC -eq 137 ]] && grep -q "^40000: " "$SAVE_DIR/train.log" 2>/dev/null && RC=0
echo "return code: $RC"
