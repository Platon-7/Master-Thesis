#!/bin/bash
#SBATCH --job-name=q35_stickpull
#SBATCH --output=logs/q35_stickpull_%A_%a.out
#SBATCH --error=logs/q35_stickpull_%A_%a.err
#SBATCH --time=05:30:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6e-4gpu-l40s,ondemand-g6-1gpu-l4,ondemand-g6-4gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
# Qwen3.5 run4 IBRL on StickPull — the ONLY task that passed run4's in-distribution
# calibration (thr 0.10, TPR 0.71, FPR 0.10). Winning recipe: success head, beta=0,
# sparse reward, debounce=1. Seed = SLURM array id + 1.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
SEED=$(( SLURM_ARRAY_TASK_ID + 1 ))
BC_POLICY=stickpull
VLM_NAME=qwen35_ft

# ---- environment: qwen35 env, Qwen35-FT path priority ----
unset PYTHONPATH CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL 2>/dev/null || true
ENV_NAME="/shared/home/PKA4388/miniconda3/envs/vlm_ibrl_qwen35"
export IBRL_CONDA_ENV="$ENV_NAME"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
QWEN35_FT_DIR="${QWEN35_FT_DIR:-$HERE/../Qwen35-FT}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1
source set_env.sh
# Qwen35-FT first (its setup_utils Qwen3.5 dispatch must win), then repo, then Robometer
export PYTHONPATH="$QWEN35_FT_DIR:$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
echo "[env] python=$(which python)"
python -c "import gymnasium, metaworld; print('[env] gymnasium+metaworld import OK')" || { echo "[env] import FAILED"; exit 1; }

export QWEN35_FT_PATH="${QWEN35_FT_PATH:-/shared/home/PKA4388/checkpoints/Qwen35_FT_phase1_consolidated/run4_step6500}"

# ---- winning recipe (success head, beta=0, sparse, debounce=1) + calibrated thr ----
export AUTONOMOUS_SUCCESS=1
export V3_CORNER2_ZOOM=1
export ROBOMETER_REWARD_CAMERA=corner2_default
export ROBOMETER_DETECT_HEAD=success
export ROBOMETER_BETA=0.0
export ROBOMETER_SUCCESS_CONSECUTIVE=1
export ROBOMETER_THRESHOLD=0.0
export ROBOMETER_REWARD_SCALE=1.0
export ROBOMETER_SUCCESS_THRESHOLD="${ROBOMETER_SUCCESS_THRESHOLD:-0.10}"
REWARD_AT_TRUNC=1
EPISODE_LENGTH=200
NUM_TRAIN_STEP="${NUM_TRAIN_STEP:-40000}"
TRAIN_TIMEOUT="${TRAIN_TIMEOUT:-18000}"

SAVE_BASE="${SAVE_BASE:-/shared/home/$USER/vlm_ibrl_runs}"
SAVE_DIR="${SAVE_BASE}/qwen35run4_${BC_POLICY}_dsucc${ROBOMETER_SUCCESS_THRESHOLD}_s${SEED}_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$SAVE_DIR"
echo "SEED=$SEED VLM=$VLM_NAME TASK=$BC_POLICY THR=$ROBOMETER_SUCCESS_THRESHOLD CKPT=$QWEN35_FT_PATH"
echo "SAVE=$SAVE_DIR  steps=$NUM_TRAIN_STEP"
echo "================================================"

timeout --kill-after=30s --signal=TERM "$TRAIN_TIMEOUT" \
    python mw_main/train_rl_vlm_mw.py \
        --config_path release/cfgs/metaworld/ibrl_long.yaml \
        --episode_length "$EPISODE_LENGTH" \
        --bc_policy "$BC_POLICY" \
        --vlm "$VLM_NAME" \
        --train_end_on_success 0 \
        --reward_at_truncation "$REWARD_AT_TRUNC" \
        --num_train_step "$NUM_TRAIN_STEP" \
        --seed "$SEED" \
        --use_wb 0 \
        --robometer_beta "$ROBOMETER_BETA" \
        --robometer_threshold "$ROBOMETER_THRESHOLD" \
        --robometer_reward_scale "$ROBOMETER_REWARD_SCALE" \
        --save_dir "$SAVE_DIR"
RC=$?
if [[ $RC -eq 124 || $RC -eq 137 ]]; then
    grep -q "^${NUM_TRAIN_STEP}: " "$SAVE_DIR/train.log" 2>/dev/null && { echo "[wrapper] timeout but reached ${NUM_TRAIN_STEP} — PASS"; RC=0; } \
        || echo "[wrapper] timeout before ${NUM_TRAIN_STEP}; last: $(grep -E '^[0-9]+: ' "$SAVE_DIR/train.log" 2>/dev/null | awk -F: '{print $1}' | sort -un | tail -1)"
fi
echo "return code: $RC"
