#!/bin/bash
#SBATCH --job-name=e1_resctl
#SBATCH --output=logs/e1_resctl_%j.out
#SBATCH --error=logs/e1_resctl_%j.err
#SBATCH --time=00:30:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

# E1 resolution control: score curated keyframe trajectories at native res vs
# resized-224, compute success-vs-failure AUC each way. Isolates whether the
# on-policy AUC collapse is resolution-driven or genuine content shift.
#
# Submit with:
#   sbatch --export=ALL,IBRL_CONDA_ENV=<env>,MODEL_PATH=<ckpt>[,ROBOMETER_FORCE_FP32=1] \
#          jobs/e1_resolution_control.job

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ENV_NAME="${IBRL_CONDA_ENV:-demo2reward}"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
MODEL_PATH="${MODEL_PATH:?must set MODEL_PATH}"
N_PER_CLASS="${N_PER_CLASS:-30}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"
source set_env.sh
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"
export MUJOCO_GL="${MUJOCO_GL:-egl}"

echo "==================== e1_resolution_control ===================="
echo "ENV_NAME    : $ENV_NAME"
echo "MODEL_PATH  : $MODEL_PATH"
echo "FORCE_FP32  : ${ROBOMETER_FORCE_FP32:-<unset>}"
echo "N_PER_CLASS : $N_PER_CLASS"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1
echo "==============================================================="

python tools/e1_resolution_control.py --model-path "$MODEL_PATH" --n-per-class "$N_PER_CLASS" --icl
