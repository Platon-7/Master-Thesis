#!/bin/bash
#SBATCH --job-name=diag_nan
#SBATCH --output=logs/diag_nan_%j.out
#SBATCH --error=logs/diag_nan_%j.err
#SBATCH --time=00:30:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
QWEN35_FT_DIR="${QWEN35_FT_DIR:-$HERE/../Qwen35-FT}"
ENV_NAME="${IBRL_CONDA_ENV:-vlm_ibrl_qwen35}"
MUJOCO_PATH="${MUJOCO_PATH:-$HOME/.mujoco/mujoco210}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
export IBRL_CONDA_ENV="$ENV_NAME"
export MUJOCO_PATH="$MUJOCO_PATH"
export MUJOCO_GL="${MUJOCO_GL:-egl}"

source "$(conda info --base)/etc/profile.d/conda.sh"
source set_env.sh   # activates env, sets LD_LIBRARY_PATH for mujoco_py

# Path priority: Qwen35-FT first so its scorer/setup_utils wins
export PYTHONPATH="$QWEN35_FT_DIR:$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
unset WANDB_PROJECT WANDB_ENTITY
export WANDB_MODE=disabled

echo "==================== diag summary ===================="
echo "ENV : $ENV_NAME"
echo "python: $(which python)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1
echo "======================================================"

python tools/diag_nan_qwen35.py "$@"
RC=$?
echo "return code: $RC"
exit $RC
