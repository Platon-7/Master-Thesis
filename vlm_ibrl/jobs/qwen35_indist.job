#!/bin/bash
#SBATCH --job-name=q35_indist
#SBATCH --output=logs/q35_indist_%j.out
#SBATCH --error=logs/q35_indist_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6e-4gpu-l40s,ondemand-g6-1gpu-l4,ondemand-g6-4gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
unset PYTHONPATH CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL 2>/dev/null || true
ENV_NAME="/shared/home/PKA4388/miniconda3/envs/vlm_ibrl_qwen35"
export IBRL_CONDA_ENV="$ENV_NAME"   # set_env.sh re-activates this — must be set
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1
source set_env.sh
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
echo "[env] python=$(which python)"
python -c "import torch, transformers; print('[env] imports OK; torch',torch.__version__,'tf',transformers.__version__)" || { echo "[env] import FAILED"; exit 1; }

export QWEN35_FT_PATH="${QWEN35_FT_PATH:-/shared/home/PKA4388/checkpoints/Qwen35_FT_phase1_consolidated/run4_step6500}"
echo "[probe] QWEN35_FT_PATH=$QWEN35_FT_PATH"
python ../reward-model-study/scripts/qwen35_indist_rank.py
echo "=== probe done (exit $?) ==="
