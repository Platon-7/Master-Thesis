#!/bin/bash
#SBATCH --job-name=rr_calib
#SBATCH --output=logs/rr_calib_%j.out
#SBATCH --error=logs/rr_calib_%j.err
#SBATCH --time=01:30:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=spot-g6-1gpu-l4,spot-p4d-8gpu-a100,ondemand-g6-4gpu-l4,ondemand-g6e-4gpu-l40s
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs
unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward_robomimic"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
source set_env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL=egl

export N_EP="${N_EP:-24}"

echo "[calib_sq] host=$(hostname) run2 on Square"
export DIAG_ENV=PickPlaceCan
export DIAG_BC=release/model/robomimic/can/model0.pt
export DIAG_EP_LEN=200
export N_EP="${N_EP:-20}"
echo "[rr_calib] RoboReward-4B on Can"
python jobs/diag_roboreward.py
echo "[calib_sq] done"
