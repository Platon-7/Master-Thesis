#!/bin/bash
#SBATCH --job-name=vlm_scorer
#SBATCH --output=logs/vlm_scorer_%j.out
#SBATCH --error=logs/vlm_scorer_%j.err
#SBATCH --time=2-00:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6-1gpu-l4,ondemand-g6e-4gpu-l40s,ondemand-g6-4gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
# Non-autonomous SCORER baseline (RoboReward / RoboDopamine / LRM): full episode, no GT
# termination, reward at truncation (RAT=1 sparse) or dense-delta (RAT=0). Only the reward
# model varies; everything else matches the fair protocol.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs

TASK="${TASK:-can}"
VLM="${VLM:-roboreward_4b}"
RAT="${RAT:-1}"                          # reward_at_truncation: 1=sparse, 0=dense(delta)
NUM_TRAIN_STEP="${NUM_TRAIN_STEP:-750000}"
WARMUP="${WARMUP:-30}"
EVAL_EP="${EVAL_EP:-20}"
SEED="${SEED:-1}"
SAVE_DIR="${SAVE_DIR:-/shared/home/$USER/vlm_ibrl_runs/scorer_${TASK}_${VLM}_${SLURM_JOB_ID}}"

unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward_robomimic"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
source set_env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL=egl
export AUTONOMOUS_SUCCESS=0               # scorer = non-autonomous, full episode

echo "[scorer] task=$TASK vlm=$VLM rat=$RAT steps=$NUM_TRAIN_STEP seed=$SEED host=$(hostname)"
RESUME_ARGS=""
if [ -f "$SAVE_DIR/latest.pt" ]; then RESUME_ARGS="--load_pretrained_agent $SAVE_DIR/latest.pt --load_policy_only 0"; fi

python train_vlm_rl.py \
    $RESUME_ARGS \
    --config_path "release/cfgs/robomimic_rl/${TASK}_ibrl.yaml" \
    --seed "$SEED" \
    --vlm "$VLM" \
    --train_end_on_success 0 \
    --robometer_beta 0.0 \
    --robometer_threshold 0.0 \
    --reward_at_truncation "$RAT" \
    --num_train_step "$NUM_TRAIN_STEP" \
    --num_warm_up_episode "$WARMUP" \
    --num_eval_episode "$EVAL_EP" \
    --mp_eval 0 \
    --use_wb 0 \
    --log_per_step "${LOG_PER_STEP:-5000}" \
    --save_dir "$SAVE_DIR"
echo "[scorer] done save_dir=$SAVE_DIR"
