#!/bin/bash
#SBATCH --job-name=rm_vlm_auto
#SBATCH --output=logs/rm_vlm_auto_%j.out
#SBATCH --error=logs/rm_vlm_auto_%j.err
#SBATCH --time=00:45:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6-1gpu-l4,ondemand-g6e-4gpu-l40s,ondemand-g6-4gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
# Rung-5: autonomous VLM-reward IBRL (FAIR: model detects success+terminates, eval_env=GT).
# Default = short throughput/wiring micro-run on Can w/ FT @ method-1 offline thr 0.82.
# Override NUM_TRAIN_STEP for a real run. See [[robomimic-eval-setup]].
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
mkdir -p logs

TASK="${TASK:-can}"
VLM="${VLM:-robometer_ft}"
THR="${THR:-0.82}"                       # method-1 offline-calibrated detection threshold
CONSEC="${CONSEC:-1}"
SEED="${SEED:-1}"                        # training seed (eval seeds are step-derived, stay comparable)
NUM_TRAIN_STEP="${NUM_TRAIN_STEP:-1000}" # micro by default
WARMUP="${WARMUP:-5}"
EVAL_EP="${EVAL_EP:-5}"
SAVE_DIR="${SAVE_DIR:-/shared/home/$USER/vlm_ibrl_runs/rung5_${TASK}_${VLM}_thr${THR}_${SLURM_JOB_ID}}"

# ---- environment ----
unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward_robomimic"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
source set_env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL=egl

# ---- FAIR autonomous protocol (proven core only; offline-fixed threshold) ----
export AUTONOMOUS_SUCCESS=1
export ROBOMETER_DETECT_HEAD=success
export ROBOMETER_SUCCESS_THRESHOLD="$THR"
export ROBOMETER_SUCCESS_CONSECUTIVE="$CONSEC"
export ROBOMETER_MIN_EP_STEPS="${MIN_EP_STEPS:-0}"   # min-episode-length gate (0=off)
export ROBOMETER_FT_PATH="${ROBOMETER_FT_PATH:-/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run1_icl_ours_step4000}"
echo "[rung5] task=$TASK vlm=$VLM thr=$THR consec=$CONSEC steps=$NUM_TRAIN_STEP host=$(hostname)"

# Auto-resume (for SPOT preemption + --requeue, or manual resubmit with same SAVE_DIR):
# warm-start from the last checkpoint. NOTE partial resume — global_step restarts at 0,
# replay rebuilt from warmup; agent (actor+critic) weights carry over (load_policy_only=0).
RESUME_ARGS=""
if [ -f "$SAVE_DIR/latest.pt" ]; then
    echo "[resume] found $SAVE_DIR/latest.pt → warm-start (load_policy_only=0)"
    RESUME_ARGS="--load_pretrained_agent $SAVE_DIR/latest.pt --load_policy_only 0"
fi

python train_vlm_rl.py \
    $RESUME_ARGS \
    --config_path "release/cfgs/robomimic_rl/${TASK}_ibrl.yaml" \
    --seed "$SEED" \
    --vlm "$VLM" \
    --robometer_beta 0.0 \
    --robometer_threshold 0.0 \
    --reward_at_truncation 1 \
    --num_train_step "$NUM_TRAIN_STEP" \
    --num_warm_up_episode "$WARMUP" \
    --num_eval_episode "$EVAL_EP" \
    --mp_eval 0 \
    --use_wb "${USE_WB:-0}" \
    --log_per_step "${LOG_PER_STEP:-250}" \
    --save_dir "$SAVE_DIR"
echo "[rung5] done save_dir=$SAVE_DIR"
