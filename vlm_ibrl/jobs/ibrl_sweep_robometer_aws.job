#!/bin/bash
#SBATCH --job-name=ibrl_sweep
#SBATCH --output=logs/ibrl_sweep_%j.out
#SBATCH --error=logs/ibrl_sweep_%j.err
#SBATCH --time=08:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=spot-g6e-1gpu-l40s
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G

# AWS port of ibrl_sweep_robometer.job. VLM-reward IBRL run (the dual-render +
# end_on_success fix). Overrides via --export=ALL,...:
#   VLM_NAME (robometer_ft|robometer_4b), BC_POLICY, ROBOMETER_BETA,
#   ROBOMETER_THRESHOLD, ROBOMETER_REWARD_SCALE, REWARD_AT_TRUNC,
#   TRAIN_END_ON_SUCCESS, V3_CORNER2_ZOOM, ROBOMETER_REWARD_CAMERA,
#   NUM_TRAIN_STEP, SEED, ROBOMETER_FT_PATH, TRAIN_TIMEOUT
# Smoke: pass NUM_TRAIN_STEP=5000 + a small TRAIN_TIMEOUT.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"

ENV_NAME="${IBRL_CONDA_ENV:-/shared/home/PKA4388/miniconda3/envs/demo2reward_v3}"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
export IBRL_CONDA_ENV="$ENV_NAME"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1
source set_env.sh
# Robometer/ on PYTHONPATH so `from robometer.evals.eval_server import ...` resolves.
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
export WANDB_DISABLE_ARTIFACTS=true
export WANDB_ENTITY=nlp-squad   # correct team for IBRL runs (was going to wrong team)

# FT checkpoint (s4000 = current reference on this cluster).
export ROBOMETER_FT_PATH="${ROBOMETER_FT_PATH:-/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run1_icl_ours_step4000}"

# Re-export ICL vars if set (so the python child sees them through conda activate).
if [[ -n "${ROBOMETER_ICL_DEMO_PATH:-}" ]]; then
    export ROBOMETER_ICL_DEMO_PATH
    export ROBOMETER_ICL_DEMO_IDX="${ROBOMETER_ICL_DEMO_IDX:-0}"
    export ROBOMETER_ICL_FRAMES="${ROBOMETER_ICL_FRAMES:-16}"
fi

VLM_NAME="${VLM_NAME:-robometer_ft}"
BC_POLICY="${BC_POLICY:-coffeepush}"
ROBOMETER_BETA="${ROBOMETER_BETA:-0.0}"
ROBOMETER_THRESHOLD="${ROBOMETER_THRESHOLD:-0.0}"
ROBOMETER_REWARD_SCALE="${ROBOMETER_REWARD_SCALE:-1.0}"
SEED="${SEED:-1}"
NUM_TRAIN_STEP="${NUM_TRAIN_STEP:-60000}"
TRAIN_TIMEOUT="${TRAIN_TIMEOUT:-28200}"   # 7h50m; full 60k alive ~90min, big margin
SAVE_BASE="${SAVE_BASE:-/shared/home/$USER/vlm_ibrl_runs}"
SAVE_DIR="${SAVE_BASE}/${BC_POLICY}_${VLM_NAME}_b${ROBOMETER_BETA}_t${ROBOMETER_THRESHOLD}_s${SEED}_${SLURM_JOB_ID:-local}"
mkdir -p "$SAVE_DIR"

echo "==================== ibrl sweep (AWS) ===================="
echo "HOST            : $(hostname)   PARTITION: ${SLURM_JOB_PARTITION:-?}"
echo "ENV_NAME        : $ENV_NAME"
echo "python          : $(which python)"
echo "VLM_NAME        : $VLM_NAME"
echo "BC_POLICY       : $BC_POLICY"
echo "BETA/THRESH/SCALE: $ROBOMETER_BETA / $ROBOMETER_THRESHOLD / $ROBOMETER_REWARD_SCALE"
echo "REWARD_AT_TRUNC : ${REWARD_AT_TRUNC:-1}   END_ON_SUCCESS: ${TRAIN_END_ON_SUCCESS:-0}"
echo "V3_CORNER2_ZOOM : ${V3_CORNER2_ZOOM:-<unset>}   REWARD_CAMERA: ${ROBOMETER_REWARD_CAMERA:-<unset>}"
echo "SEED/STEPS      : $SEED / $NUM_TRAIN_STEP"
echo "ROBOMETER_FT_PATH: $ROBOMETER_FT_PATH"
echo "SAVE_DIR        : $SAVE_DIR"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1
echo "=========================================================="

timeout --kill-after=30s --signal=TERM "$TRAIN_TIMEOUT" \
    python mw_main/train_rl_vlm_mw.py \
        --config_path release/cfgs/metaworld/ibrl_long.yaml \
        --episode_length "${EPISODE_LENGTH:-100}" \
        --bc_policy "$BC_POLICY" \
        --vlm "$VLM_NAME" \
        --train_end_on_success ${TRAIN_END_ON_SUCCESS:-0} \
        --reward_at_truncation ${REWARD_AT_TRUNC:-1} \
        --num_train_step "$NUM_TRAIN_STEP" \
        --seed "$SEED" \
        --use_wb ${USE_WB:-0} \
        --robometer_beta "$ROBOMETER_BETA" \
        --robometer_threshold "$ROBOMETER_THRESHOLD" \
        --robometer_reward_scale "$ROBOMETER_REWARD_SCALE" \
        --save_dir "$SAVE_DIR"
RC=$?

if [[ $RC -eq 124 || $RC -eq 137 ]]; then
    if grep -q "^${NUM_TRAIN_STEP}: " "$SAVE_DIR/train.log" 2>/dev/null; then
        echo "[wrapper] timeout fired but training reached step ${NUM_TRAIN_STEP} — PASS"; RC=0
    else
        LAST=$(grep -E "^[0-9]+: " "$SAVE_DIR/train.log" 2>/dev/null | awk -F: '{print $1}' | sort -un | tail -1)
        echo "[wrapper] timeout fired BEFORE ${NUM_TRAIN_STEP} — last step: ${LAST}"
    fi
fi
echo "return code: $RC"
exit $RC
