#!/bin/bash
#SBATCH --job-name=calib_sq
#SBATCH --output=logs/calib_sq_%j.out
#SBATCH --error=logs/calib_sq_%j.err
#SBATCH --time=01:30:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=spot-g6-1gpu-l4,spot-p4d-8gpu-a100,ondemand-g6-4gpu-l4,ondemand-g6e-4gpu-l40s
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs
unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward_robomimic"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
source set_env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL=egl

# Square calibration: run2 (no ICL), NutAssemblySquare, ep_len 300
export ROBOMETER_FT_PATH=/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run2_noicl_ours_step4000
export DIAG_ENV=NutAssemblySquare
export DIAG_BC=release/model/robomimic/square/model0.pt
export DIAG_EP_LEN=300
export N_EP="${N_EP:-24}"

echo "[calib_sq] host=$(hostname) run2 on Square"
python jobs/diag_causal_calib.py
echo "[calib_sq] done"
