#!/bin/bash
#SBATCH --job-name=rm_gt_smoke
#SBATCH --output=logs/rm_gt_smoke_%j.out
#SBATCH --error=logs/rm_gt_smoke_%j.err
#SBATCH --time=01:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6-1gpu-l4,ondemand-g6e-1gpu-l40s,ondemand-g6-4gpu-l4,ondemand-g6e-4gpu-l40s
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=50G
# Rung-4: short GT-reward IBRL on Can (~5k steps) to validate the RL training harness
# (replay buffer, BC bootstrap, agent updates, eval, os._exit teardown) before any VLM/RL.
# NOT a performance run. See [[robomimic-eval-setup]].
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
mkdir -p logs

TASK="${TASK:-can}"
NUM_TRAIN_STEP="${NUM_TRAIN_STEP:-5000}"
SAVE_DIR="${SAVE_DIR:-/shared/home/$USER/vlm_ibrl_runs/rung4_gt_${TASK}_smoke_${SLURM_JOB_ID}}"

# ---- environment ----
unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward_robomimic"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
source set_env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL=egl
echo "[env] python=$(which python) task=$TASK steps=$NUM_TRAIN_STEP host=$(hostname)"

python train_rl.py \
    --config_path "release/cfgs/robomimic_rl/${TASK}_ibrl.yaml" \
    --num_train_step "$NUM_TRAIN_STEP" \
    --num_warm_up_episode 10 \
    --num_eval_episode 10 \
    --mp_eval 0 \
    --use_wb 0 \
    --log_per_step 1000 \
    --save_dir "$SAVE_DIR"
echo "[rung4] done task=$TASK save_dir=$SAVE_DIR"
