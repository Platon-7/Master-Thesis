#!/bin/bash
#SBATCH --job-name=e2_livevscur
#SBATCH --output=logs/e2_livevscur_%j.out
#SBATCH --error=logs/e2_livevscur_%j.err
#SBATCH --time=00:35:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ENV_NAME="${IBRL_CONDA_ENV:-demo2reward}"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"
source set_env.sh
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1
python tools/e2_live_vs_curated.py --run-dir "$RUN_DIR" --n-episodes "${N_EP:-60}" --out-prefix "$OUT_PREFIX" --icl-source "${ICL_SOURCE:-curated}" --policy "${POLICY:-bc}"
