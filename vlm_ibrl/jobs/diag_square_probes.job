#!/bin/bash
#SBATCH --job-name=sq_probe
#SBATCH --output=logs/sq_probe_%j.out
#SBATCH --error=logs/sq_probe_%j.err
#SBATCH --time=01:30:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6-1gpu-l4,ondemand-g6e-4gpu-l40s,ondemand-g6-4gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs
unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward_robomimic"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
source set_env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL=egl

# reward model (default run2; override to run1_icl for the ICL probe). Used by the env
# AND, in bc mode, by the standalone scorer. ICL vars pass through from the submit env.
export ROBOMETER_FT_PATH="${ROBOMETER_FT_PATH:-/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run2_noicl_ours_step4000}"
export DIAG_ENV=NutAssemblySquare
export DIAG_BC=release/model/robomimic/square/model0.pt
export DIAG_EP_LEN=300
export N_EP="${N_EP:-24}"
export POLICY="${POLICY:-bc}"
# rl mode: hacked Square checkpoint (its dir holds cfg.yaml)
export AGENT_CKPT="${AGENT_CKPT:-/shared/home/PKA4388/vlm_ibrl_runs/square_run2_auto_thr0.85_gate120_consec5_gaplog_1.5M/latest.pt}"

echo "[sq_probe] host=$(hostname) POLICY=$POLICY"
python jobs/diag_square_probes.py
echo "[sq_probe] done"
