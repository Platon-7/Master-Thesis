#!/bin/bash
#SBATCH --job-name=robometer_smoke
#SBATCH --output=logs/robometer_smoke_%j.out
#SBATCH --error=logs/robometer_smoke_%j.err
#SBATCH --time=00:30:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

# Smoke-test the Robometer-4B integration in env/robometer_utils.py:
#   1. Load robometer/Robometer-4B from HF (with use_unsloth=False override)
#   2. Run a single forward pass on 5 random 224x224 RGB frames
#   3. Assert progress_reward, success_prob both in [0, 1]
#
# Defaults to the demo2reward env (Chris's IBRL stack + Robometer deps via
# the unsloth stub at vlm_ibrl/unsloth.py). Override via IBRL_CONDA_ENV to
# run in a different env (e.g. robometer_gpu for the all-real-deps path).

set -uo pipefail

cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ENV_NAME="${IBRL_CONDA_ENV:-demo2reward}"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
MUJOCO_PATH="${MUJOCO_PATH:-$HOME/.mujoco/mujoco210}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1

export PYTHONNOUSERSITE=1
export IBRL_CONDA_ENV="$ENV_NAME"
export MUJOCO_PATH="$MUJOCO_PATH"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
unset WANDB_PROJECT WANDB_API_KEY WANDB_ENTITY
export WANDB_MODE=disabled

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"
source set_env.sh

# Robometer/ must be on PYTHONPATH so `from robometer.*` resolves. set_env.sh
# put HERE first; append Robometer/ at the end so vlm_ibrl/unsloth.py wins
# over any (non-existent) real Unsloth.
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"

echo "==================== smoke launch summary ===================="
echo "ENV_NAME      : $ENV_NAME"
echo "HERE          : $HERE"
echo "ROBOMETER_DIR : $ROBOMETER_DIR"
echo "PYTHONPATH    : $PYTHONPATH"
python -c "import sys, unsloth; print('python   :', sys.version.split()[0]); print('unsloth  :', unsloth.__file__)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1
echo "==============================================================="

MODEL_PATH="${ROBOMETER_MODEL_PATH:-robometer/Robometer-4B}"
echo "MODEL_PATH    : $MODEL_PATH"
python tools/robometer_smoke.py --model-path "$MODEL_PATH"
RC=$?

echo
echo "==================== smoke exit summary ===================="
echo "smoke return code: $RC"
if [[ $RC -eq 0 ]]; then
    echo "SMOKE PASSED"
else
    echo "SMOKE FAILED (rc=$RC)"
fi
exit $RC
