#!/bin/bash
#SBATCH --job-name=demo_probe
#SBATCH --output=logs/demo_probe_%j.out
#SBATCH --error=logs/demo_probe_%j.err
#SBATCH --time=00:40:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6-1gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
unset PYTHONPATH CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL 2>/dev/null || true
ENV_NAME="/shared/home/PKA4388/miniconda3/envs/demo2reward_v3"; export IBRL_CONDA_ENV="$ENV_NAME"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true; conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1; source set_env.sh
export PYTHONPATH="$PYTHONPATH:$HERE/../Robometer"; export MUJOCO_GL=egl
export ROBOMETER_FT_PATH="/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run2_noicl_ours_step4000"
export DEMO_DIR="/shared/home/PKA4388/Master-Thesis/vlm_ibrl/release/data/metaworld/CoffeePush_frame_stack_1_224x224_end_on_success/demonstrations/mw-coffee-push/frames"
export TASK_DESC="Push a mug under a coffee machine."
python ../reward-model-study/scripts/demo_score_probe.py
echo "=== done ($?) ==="
