#!/bin/bash
#SBATCH --job-name=calib_mx
#SBATCH --output=logs/calib_mx_%j.out
#SBATCH --error=logs/calib_mx_%j.err
#SBATCH --time=02:30:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6e-4gpu-l40s,ondemand-g6e-8gpu-l40s
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"
# env hygiene: drop any inherited conda/python state (e.g. from --export=ALL) so
# the activate below deterministically lands in demo2reward_v3 (which has
# gymnasium + metaworld-v3). A leaked demo2reward env caused metaworld import to
# fail -> NameError in MetaWorldEnv.
unset PYTHONPATH CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL CONDA_PREFIX_1 CONDA_PREFIX_2 2>/dev/null || true
ENV_NAME="/shared/home/PKA4388/miniconda3/envs/demo2reward_v3"
# CRITICAL: set_env.sh runs `conda activate ${IBRL_CONDA_ENV:-demo2reward}` — without
# this export it switches python back to the WRONG env (demo2reward, no gymnasium).
export IBRL_CONDA_ENV="$ENV_NAME"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1
source set_env.sh
# verify AFTER set_env.sh (it re-activates conda) — this is the env the script uses
echo "[env] python=$(which python)  (expect .../demo2reward_v3/bin/python)"
python -c "import gymnasium, metaworld; print('[env] gymnasium+metaworld import OK')" || echo "[env] WARNING import FAILED"
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
# faithful to the 288 sweep: un-zoomed corner2 reward view, no env-set ICL
unset V3_CORNER2_ZOOM
unset ROBOMETER_ICL_DEMO_PATH
export ROBOMETER_FT_PATH="${ROBOMETER_FT_PATH:-/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run1_icl_ours_step4000}"
export ROBOMETER_4B_PATH="${ROBOMETER_4B_PATH:-/shared/home/PKA4388/checkpoints/Robometer-4B}"
export CALIB_MODEL="${CALIB_MODEL:-ft}"
export CALIB_OUT="${CALIB_OUT:-/shared/home/PKA4388/vlm_ibrl_runs/calib_matrix_${CALIB_MODEL}.json}"
# LIGHT params so each task finishes inside a short (spot) window and the
# resumable per-task save actually accumulates. Noisier (8s/8f) but enough for
# the directional questions (progress-head threshold, ICL effect). Refine later.
export CALIB_N_SUCC="${CALIB_N_SUCC:-8}"
export CALIB_N_FAIL="${CALIB_N_FAIL:-8}"
export CALIB_STRIDE="${CALIB_STRIDE:-18}"
export CALIB_MAXT="${CALIB_MAXT:-160}"
echo "=== calib matrix: model=$CALIB_MODEL out=$CALIB_OUT ==="
python ../reward-model-study/scripts/calibrate_matrix.py
echo "=== calib matrix done (exit $?) ==="
