#!/bin/bash
#SBATCH --job-name=mw_shaping
#SBATCH --output=logs/mw_shaping_%j.out
#SBATCH --error=logs/mw_shaping_%j.err
#SBATCH --time=20:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
# MetaWorld IBRL stacking arms (AWS): the winning sparse success-head anchor
# (beta=0, reward_at_truncation=1 — byte-identical to the money-plot config)
# PLUS optional dense progress shaping via the RPL_MW_* env vars added to
# env/vlm_envs.py (last-K window, condMean decode, potential-based delta).
# Arms: (a) sparse-only = leave RPL_MW_SHAPING unset; (b) sparse + our shaping
# = VLM=robometer_ft + RPL_MW_SHAPING=delta_condmean; (c) control: same
# shaping with VLM=robometer_4b (baseline progress head, no failure labels).
# NOTE: shaping adds one scorer call per env step even in truncation mode.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs

BC_POLICY="${BC_POLICY:-coffeepush}"
VLM_NAME="${VLM_NAME:-robometer_ft}"
SEED="${SEED:-1}"
NUM_TRAIN_STEP="${NUM_TRAIN_STEP:-40000}"
SAVE_DIR="${SAVE_DIR:-/shared/home/$USER/vlm_ibrl_runs/mwshape_${BC_POLICY}_${VLM_NAME}_${RPL_MW_SHAPING:-none}_s${SEED}_${SLURM_JOB_ID}}"
mkdir -p "$SAVE_DIR"

unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
conda activate "$IBRL_CONDA_ENV"
source set_env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"
export MUJOCO_GL=egl
# MetaWorld -> mujoco-py -> MuJoCo 2.1.0 binaries (installed 2026-07-08; the
# cython shim compiles on first GPU-node import and is cached in site-packages).
export MUJOCO_PY_MUJOCO_PATH=/shared/home/PKA4388/.mujoco/mujoco210
export LD_LIBRARY_PATH="/shared/home/PKA4388/.mujoco/mujoco210/bin:/usr/lib/nvidia:${LD_LIBRARY_PATH:-}"
export WANDB_DISABLE_ARTIFACTS=true

export ROBOMETER_FT_PATH="${ROBOMETER_FT_PATH:-/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run2_noicl_ours_step4000}"

echo "==================== mw shaping summary ===================="
echo "BC_POLICY / VLM  : $BC_POLICY / $VLM_NAME"
echo "SEED / STEPS     : $SEED / $NUM_TRAIN_STEP"
echo "ROBOMETER_FT_PATH: $ROBOMETER_FT_PATH"
echo "SHAPING          : ${RPL_MW_SHAPING:-<none>} K=${RPL_MW_LASTK:-4} scale=${RPL_MW_DELTA_SCALE:-1} w=${RPL_MW_SHAPING_WEIGHT:-1}"
echo "SAVE_DIR         : $SAVE_DIR"
nvidia-smi --query-gpu=name --format=csv,noheader | head -1
echo "============================================================="

python mw_main/train_rl_vlm_mw.py \
    --config_path release/cfgs/metaworld/ibrl_long.yaml \
    --bc_policy "$BC_POLICY" \
    --vlm "$VLM_NAME" \
    --train_end_on_success 0 \
    --reward_at_truncation 1 \
    --num_train_step "$NUM_TRAIN_STEP" \
    --seed "$SEED" \
    --use_wb "${USE_WB:-1}" \
    --robometer_beta 0.0 \
    --robometer_threshold 0.0 \
    --robometer_reward_scale 1.0 \
    --save_dir "$SAVE_DIR"
echo "EXIT=$? save_dir=$SAVE_DIR"
