#!/bin/bash
#SBATCH --job-name=ibrl_gt
#SBATCH --output=logs/ibrl_gt_%j.out
#SBATCH --error=logs/ibrl_gt_%j.err
#SBATCH --time=02:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=spot-g6e-1gpu-l40s
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=40G

# AWS port of ibrl_gt_control.job. GROUND-TRUTH-REWARD IBRL control: same RL
# loop / BC policy / task / budget as the VLM runs but with the env's GT reward
# (train_rl_mw.py, no VLM). No reward model loaded -> the cleanest RL-loop smoke
# (exercises BC policy + env + common_utils.rela only).
#
# Override via --export=ALL,...: NUM_TRAIN_STEP (set small, e.g. 5000, for a
# smoke), REWARD_AT_TRUNC (1=sparse/matched, 0=dense), SEED, TRAIN_TIMEOUT, TAG.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"

# Env (no Lmod on this cluster). Default to the v3 env; override via IBRL_CONDA_ENV.
ENV_NAME="${IBRL_CONDA_ENV:-/shared/home/PKA4388/miniconda3/envs/demo2reward_v3}"
export IBRL_CONDA_ENV="$ENV_NAME"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1
source set_env.sh
export MUJOCO_GL="${MUJOCO_GL:-egl}"
export WANDB_DISABLE_ARTIFACTS=true

REWARD_AT_TRUNC="${REWARD_AT_TRUNC:-1}"
SEED="${SEED:-1}"
NUM_TRAIN_STEP="${NUM_TRAIN_STEP:-300000}"
TRAIN_TIMEOUT="${TRAIN_TIMEOUT:-6600}"
TAG="${TAG:-gt}"
SAVE_BASE="${SAVE_BASE:-/shared/home/$USER/vlm_ibrl_runs}"
SAVE_DIR="${SAVE_BASE}/coffeepush_${TAG}_rt${REWARD_AT_TRUNC}_seed${SEED}_${SLURM_JOB_ID:-local}"
mkdir -p "$SAVE_DIR"

echo "==================== ibrl GT control (AWS) ===================="
echo "HOST            : $(hostname)   PARTITION: ${SLURM_JOB_PARTITION:-?}"
echo "ENV_NAME        : $ENV_NAME"
echo "python          : $(which python)"
echo "REWARD_AT_TRUNC : $REWARD_AT_TRUNC   (1=sparse/matched, 0=dense)"
echo "SEED            : $SEED"
echo "NUM_TRAIN_STEP  : $NUM_TRAIN_STEP"
echo "SAVE_DIR        : $SAVE_DIR"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1
echo "==============================================================="

timeout --kill-after=30s --signal=TERM "$TRAIN_TIMEOUT" \
    python mw_main/train_rl_mw.py \
        --config_path release/cfgs/metaworld/ibrl_long.yaml \
        --episode_length "${EPISODE_LENGTH:-100}" \
        --bc_policy coffeepush \
        --train_end_on_success ${TRAIN_END_ON_SUCCESS:-0} \
        --reward_at_truncation "$REWARD_AT_TRUNC" \
        --num_train_step "$NUM_TRAIN_STEP" \
        --seed "$SEED" \
        --use_wb ${USE_WB:-0} \
        --save_dir "$SAVE_DIR"
RC=$?
echo "return code: $RC (124/137 = timeout wrapper fired)"
exit $RC
