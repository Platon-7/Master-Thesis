#!/bin/bash
#SBATCH --job-name=mw_poc_diag
#SBATCH --output=logs/mw_poc_diag_%j.out
#SBATCH --error=logs/mw_poc_diag_%j.err
#SBATCH --time=02:00:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
# Shaping PoC with hang diagnosis: PYTHONFAULTHANDLER + a stall watchdog that
# SIGABRTs python if train.log freezes >10 min -> full thread stacks in .err.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs
unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward"
ROBOMETER_DIR="$HERE/../Robometer"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
conda activate "$IBRL_CONDA_ENV"
source set_env.sh
export PYTHONNOUSERSITE=1 PYTHONPATH="$HERE:$ROBOMETER_DIR" MUJOCO_GL=egl
export MUJOCO_PY_MUJOCO_PATH=/shared/home/PKA4388/.mujoco/mujoco210
export LD_LIBRARY_PATH="/shared/home/PKA4388/.mujoco/mujoco210/bin:/usr/lib/nvidia:${LD_LIBRARY_PATH:-}"
export PYTHONFAULTHANDLER=1
export ROBOMETER_FT_PATH=/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run2_noicl_ours_step4000
export RPL_MW_SHAPING=delta_condmean RPL_MW_LASTK=4 RPL_MW_DELTA_SCALE=1 RPL_MW_SHAPING_WEIGHT=0.5
SAVE_DIR=/shared/home/$USER/vlm_ibrl_runs/mw_poc_diag_$SLURM_JOB_ID; mkdir -p "$SAVE_DIR"

python mw_main/train_rl_vlm_mw.py \
    --config_path release/cfgs/metaworld/ibrl_long.yaml \
    --bc_policy coffeepush --vlm robometer_ft \
    --train_end_on_success 0 --reward_at_truncation 1 \
    --num_warm_up_episode 5 --num_train_step 1500 --seed 1 --use_wb 0 \
    --robometer_beta 0.0 --robometer_threshold 0.0 --robometer_reward_scale 1.0 \
    --save_dir "$SAVE_DIR" &
PY=$!
# stall watchdog: if train.log mtime freezes >600s, dump stacks via SIGABRT
( while kill -0 $PY 2>/dev/null; do
    sleep 120
    [ -f "$SAVE_DIR/train.log" ] || continue
    AGE=$(( $(date +%s) - $(stat -c %Y "$SAVE_DIR/train.log") ))
    if [ "$AGE" -gt 600 ]; then
      echo "[watchdog] stall ${AGE}s -> py-spy dump (native)"
      /shared/home/PKA4388/miniconda3/envs/demo2reward/bin/py-spy dump --pid $PY --native 2>&1 | head -80
      echo "[watchdog] -> SIGABRT"
      kill -ABRT $PY; sleep 20; kill -9 $PY 2>/dev/null; break
    fi
  done ) &
wait $PY; echo "EXIT=$?"
