#!/bin/bash
#SBATCH --job-name=can_goal
#SBATCH --output=logs/can_goal_%j.out
#SBATCH --error=logs/can_goal_%j.err
#SBATCH --time=00:20:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=40G
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs
unset PYTHONPATH 2>/dev/null || true
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1 IBRL_CONDA_ENV=demo2reward MUJOCO_PATH="$HOME/.mujoco/mujoco210"
source "$(conda info --base)/etc/profile.d/conda.sh"; conda activate demo2reward
source set_env.sh
export PYTHONPATH="$HERE:$HERE/../Robometer:${PYTHONPATH:-}"
export MUJOCO_GL=egl
OUT="${OUT:-/projects/prjs1958/$USER/robodopamine_goals/can.png}"
python tools/make_can_goal_image.py --out "$OUT" ${ALSO_START:+--also-start "$ALSO_START"}
echo "EXIT=$?"
