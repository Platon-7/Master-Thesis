#!/bin/bash
#SBATCH --job-name=rbm_ft_consol
#SBATCH --output=logs/consolidate_robometer_ft_%j.out
#SBATCH --error=logs/consolidate_robometer_ft_%j.err
#SBATCH --time=00:30:00
#SBATCH --account=gusei17535
#SBATCH --partition=staging
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G

# Consolidate a Robometer-FT FSDP sharded checkpoint into HF safetensors
# format so our `load_model_from_hf`-based scorer can load it.
#
# Source: $CKPT_DIR (must contain pytorch_model_fsdp_0/*.distcp)
# Target: $OUT_DIR (will contain model.safetensors* + config.json)
#
# Override via env vars on submission:
#   sbatch --export=ALL,CKPT_DIR=...,OUT_DIR=... jobs/consolidate_robometer_ft.job
#
# Uses the demo2reward env (already has torch, safetensors, transformers,
# AND torch.distributed.checkpoint.format_utils — confirmed via local import
# check). CPU-only per the consolidator script's docstring.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
ROBOMETER_FT_DIR="${ROBOMETER_FT_DIR:-$HERE/../Robometer-FT}"
ENV_NAME="${IBRL_CONDA_ENV:-demo2reward}"

CKPT_DIR="${CKPT_DIR:-/projects/prjs1958/Robometer_FT_weights/run1_icl_ours_22786983/robometer_ft_run1_icl_ours/checkpoint-3000}"
BASE_MODEL_ID="${BASE_MODEL_ID:-Qwen/Qwen3-VL-4B-Instruct}"
OUT_DIR="${OUT_DIR:-/scratch-shared/$USER/Robometer_FT_consolidated/run1_icl_ours_step3000}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
export PYTHONPATH="$ROBOMETER_DIR:$ROBOMETER_FT_DIR${PYTHONPATH:+:$PYTHONPATH}"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"

echo "==================== consolidate summary ===================="
echo "ENV_NAME       : $ENV_NAME"
echo "CKPT_DIR       : $CKPT_DIR"
echo "BASE_MODEL_ID  : $BASE_MODEL_ID"
echo "OUT_DIR        : $OUT_DIR"
echo "python         : $(which python)"
echo "=============================================================="

mkdir -p "$(dirname "$OUT_DIR")"
python "$ROBOMETER_FT_DIR/scripts/consolidate_sharded.py" \
    --ckpt-dir "$CKPT_DIR" \
    --base-model-id "$BASE_MODEL_ID" \
    --out-dir "$OUT_DIR"
RC=$?

echo
echo "==================== consolidate exit ===================="
echo "return code: $RC"
if [[ $RC -eq 0 ]]; then
    echo "CONSOLIDATE PASSED — out dir: $OUT_DIR"
    ls -lh "$OUT_DIR" 2>&1 | head -20
else
    echo "CONSOLIDATE FAILED (rc=$RC)"
fi
exit $RC
