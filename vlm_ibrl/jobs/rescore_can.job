#!/bin/bash
#SBATCH --job-name=rescore_can
#SBATCH --output=logs/rescore_can_%j.out
#SBATCH --error=logs/rescore_can_%j.err
#SBATCH --time=00:30:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6-1gpu-l4,ondemand-g6e-4gpu-l40s,ondemand-g6-4gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
# Re-score the existing rung-3 Can rollouts with an arbitrary Robometer ckpt (CKPT)
# to get its method-1 offline threshold. Reuses results/robomimic/rollouts_can.npz.
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs
CKPT="${CKPT:-/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run2_noicl_ours_step4000}"
TAG="${TAG:-robometer_run2_noicl}"
DUMP="$HERE/../reward-model-study/results/robomimic/rollouts_can.npz"
unset PYTHONPATH 2>/dev/null || true
export IBRL_CONDA_ENV="/shared/home/PKA4388/miniconda3/envs/demo2reward_robomimic"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
source set_env.sh
export PYTHONNOUSERSITE=1
export PYTHONPATH="$HERE:$HERE/../Robometer:${PYTHONPATH:-}"
export MUJOCO_GL=egl
echo "[rescore] ckpt=$CKPT tag=$TAG dump=$DUMP"
python jobs/rung3_score.py "$DUMP" "$CKPT" "$TAG"
echo "[rescore] done"
