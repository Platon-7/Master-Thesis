#!/bin/bash
#SBATCH --job-name=gate_ens
#SBATCH --output=logs/gate_ens_%A_%a.out
#SBATCH --error=logs/gate_ens_%A_%a.err
#SBATCH --time=05:30:00
#SBATCH --account=rob-tme-gaia
#SBATCH --partition=ondemand-g6e-1gpu-l40s,ondemand-g6e-4gpu-l40s,ondemand-g6e-8gpu-l40s,ondemand-g6-1gpu-l4,ondemand-g6-4gpu-l4,ondemand-g6-8gpu-l4
#SBATCH --requeue
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
# Round-2: fair-baseline thresholds, ICL-in-RL, stickpull calibrated op, seed
# stability. Submit with --array=0-22%6 (cap: 6 + followup %4 = 10 GPUs).
# L4 pool included as overflow (AWS L40S capacity is flaky); ondemand only.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"

CFG_FILE="${CFG_FILE:-/shared/home/PKA4388/vlm_ibrl_runs/gate_ens_configs.tsv}"
LINE=$(( SLURM_ARRAY_TASK_ID + 1 ))
read VLM_NAME BC_POLICY ROBOMETER_SUCCESS_THRESHOLD SEED ICL CONFIRM_K RSAMPLE MIN_EP_FRAC < <(sed -n "${LINE}p" "$CFG_FILE")
if [[ -z "${VLM_NAME:-}" ]]; then echo "no config at line $LINE"; exit 1; fi

# ---- environment (env-hygiene + IBRL_CONDA_ENV export: set_env.sh re-activates) ----
unset PYTHONPATH CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL 2>/dev/null || true
ENV_NAME="/shared/home/PKA4388/miniconda3/envs/demo2reward_v3"
export IBRL_CONDA_ENV="$ENV_NAME"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
source /shared/home/PKA4388/miniconda3/etc/profile.d/conda.sh
conda deactivate 2>/dev/null || true
conda activate "$ENV_NAME"
export PYTHONNOUSERSITE=1
source set_env.sh
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
export WANDB_DISABLE_ARTIFACTS=true
export WANDB_ENTITY=nlp-squad   # correct team for IBRL runs (was going to wrong team)
echo "[env] python=$(which python)"
python -c "import gymnasium, metaworld; print('[env] gymnasium+metaworld import OK')" || { echo "[env] import FAILED"; exit 1; }

export ROBOMETER_FT_PATH="${ROBOMETER_FT_PATH:-/shared/home/PKA4388/checkpoints/Robometer_FT_consolidated/run1_icl_ours_step4000}"
export ROBOMETER_4B_PATH="${ROBOMETER_4B_PATH:-/shared/home/PKA4388/checkpoints/Robometer-4B}"

# ---- winning recipe (success head, beta=0, sparse, debounce=1) ----
export AUTONOMOUS_SUCCESS=1
export V3_CORNER2_ZOOM=1
export ROBOMETER_REWARD_CAMERA=corner2_default
export ROBOMETER_DETECT_HEAD=success
export ROBOMETER_BETA=0.0
export ROBOMETER_SUCCESS_CONSECUTIVE=1
export ROBOMETER_THRESHOLD=0.0
export ROBOMETER_REWARD_SCALE=1.0
export ROBOMETER_SUCCESS_THRESHOLD
export REWARD_AT_TRUNC=1
export ROBOMETER_CONFIRM_K="${CONFIRM_K:-0}"
export ROBOMETER_REWARD_SAMPLE="${RSAMPLE:-0}"
export ROBOMETER_MIN_EP_FRAC="${MIN_EP_FRAC:-0}"
export EPISODE_LENGTH=200
export NUM_TRAIN_STEP=40000
export USE_WB=0
TRAIN_TIMEOUT="${TRAIN_TIMEOUT:-18000}"

# ---- ICL: real BC demo frames as in-context demonstration (training-time recipe) ----
ICLTAG=""
if [[ "$ICL" == "1" ]]; then
    ICL_BASE=/shared/home/PKA4388/Master-Thesis/vlm_ibrl/release/data/metaworld
    case "$BC_POLICY" in
        coffeepush) D="CoffeePush_frame_stack_1_224x224_end_on_success/demonstrations/mw-coffee-push/frames" ;;
        boxclose)   D="BoxClose_frame_stack_1_224x224_end_on_success/demonstrations/mw-box-close/frames" ;;
        stickpull)  D="StickPull_frame_stack_1_224x224_end_on_success/demonstrations/mw-stick-pull/frames" ;;
        assembly)   D="Assembly_frame_stack_1_224x224_end_on_success/demonstrations/mw-assembly/frames" ;;
        *) echo "no ICL dir for $BC_POLICY"; exit 1 ;;
    esac
    export ROBOMETER_ICL_DEMO_PATH="$ICL_BASE/$D"
    export ROBOMETER_ICL_DEMO_IDX=0
    export ROBOMETER_ICL_FRAMES=16
    [[ -d "$ROBOMETER_ICL_DEMO_PATH" ]] || { echo "ICL dir missing: $ROBOMETER_ICL_DEMO_PATH"; exit 1; }
    ICLTAG="_icl"
fi

SAVE_BASE="${SAVE_BASE:-/shared/home/$USER/vlm_ibrl_runs}"
SAVE_DIR="${SAVE_BASE}/${BC_POLICY}_${VLM_NAME}_dsucc${ROBOMETER_SUCCESS_THRESHOLD}${ICLTAG}_k${CONFIRM_K}g${MIN_EP_FRAC}_s${SEED}_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$SAVE_DIR"

echo "==================== round2 ===================="
echo "TASKID=${SLURM_ARRAY_TASK_ID} VLM=$VLM_NAME TASK=$BC_POLICY THR=$ROBOMETER_SUCCESS_THRESHOLD SEED=$SEED ICL=$ICL"
echo "ICL_PATH=${ROBOMETER_ICL_DEMO_PATH:-<none>}  SAVE=$SAVE_DIR"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1
echo "================================================"

timeout --kill-after=30s --signal=TERM "$TRAIN_TIMEOUT" \
    python mw_main/train_rl_vlm_mw.py \
        --config_path release/cfgs/metaworld/ibrl_long.yaml \
        --episode_length "$EPISODE_LENGTH" \
        --bc_policy "$BC_POLICY" \
        --vlm "$VLM_NAME" \
        --train_end_on_success 0 \
        --reward_at_truncation "$REWARD_AT_TRUNC" \
        --num_train_step "$NUM_TRAIN_STEP" \
        --seed "$SEED" \
        --use_wb 0 \
        --robometer_beta "$ROBOMETER_BETA" \
        --robometer_threshold "$ROBOMETER_THRESHOLD" \
        --robometer_reward_scale "$ROBOMETER_REWARD_SCALE" \
        --save_dir "$SAVE_DIR"
RC=$?
if [[ $RC -eq 124 || $RC -eq 137 ]]; then
    if grep -q "^${NUM_TRAIN_STEP}: " "$SAVE_DIR/train.log" 2>/dev/null; then
        echo "[wrapper] timeout but reached ${NUM_TRAIN_STEP} — PASS"; RC=0
    else
        LAST=$(grep -E "^[0-9]+: " "$SAVE_DIR/train.log" 2>/dev/null | awk -F: '{print $1}' | sort -un | tail -1)
        echo "[wrapper] timeout BEFORE ${NUM_TRAIN_STEP} — last step: ${LAST}"
    fi
fi
echo "return code: $RC"
