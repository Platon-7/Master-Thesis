#!/bin/bash
#SBATCH --job-name=diag_score4_qwen
#SBATCH --output=logs/diag_score4_qwen_%j.out
#SBATCH --error=logs/diag_score4_qwen_%j.err
#SBATCH --time=00:25:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G

# Qwen3.5-FT only — uses vlm_ibrl_qwen35 env (transformers 5.7 + qwen3_5 dispatch).
# Other two models (4B, FT-run1) already have valid numbers from job 23037095.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ENV_NAME=vlm_ibrl_qwen35
ROBOMETER_DIR="$HERE/../Robometer"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$ENV_NAME"
source set_env.sh
export PYTHONPATH="$PYTHONPATH:$ROBOMETER_DIR"
export MUJOCO_GL="${MUJOCO_GL:-egl}"

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1

# Asymmetric-loss checkpoints NaN on cold-GPU bf16 first forward.
# ROBOMETER_FORCE_FP32=1 forces fp32 inference (slower but stable).
export ROBOMETER_FORCE_FP32=1
echo "ROBOMETER_FORCE_FP32 = $ROBOMETER_FORCE_FP32"

python tools/diag_score4_examples.py --models qwen3.5
