#!/bin/bash
#SBATCH --job-name=smoke_qwen35env
#SBATCH --output=logs/smoke_qwen35env_%j.out
#SBATCH --error=logs/smoke_qwen35env_%j.err
#SBATCH --time=00:15:00
#SBATCH --account=gusei17535
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G

# Verify vlm_ibrl_qwen35 env can run the full vlm_ibrl + Qwen3.5 stack:
#   - import mujoco_py (must succeed on GPU node)
#   - import metaworld, robosuite
#   - load Qwen3.5-FT consolidated checkpoint via Robometer scorer
#   - score one CoffeePush frame batch end-to-end
# If this passes, the env is ready for IBRL.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
HERE="$(pwd)"
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
QWEN35_FT_DIR="${QWEN35_FT_DIR:-$HERE/../Qwen35-FT}"
ENV_NAME="${IBRL_CONDA_ENV:-vlm_ibrl_qwen35}"
MUJOCO_PATH="${MUJOCO_PATH:-$HOME/.mujoco/mujoco210}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export PYTHONNOUSERSITE=1
export IBRL_CONDA_ENV="$ENV_NAME"
export MUJOCO_PATH="$MUJOCO_PATH"
export MUJOCO_GL="${MUJOCO_GL:-egl}"

source "$(conda info --base)/etc/profile.d/conda.sh"
# set_env.sh activates the conda env AND sets /usr/lib/nvidia on LD_LIBRARY_PATH
# (mujoco_py's GPU builder requires this string be present, even though the
# dir doesn't exist on Snellius)
source set_env.sh

# Path priority: Qwen35-FT first so its setup_utils.py (with Qwen3.5 dispatch)
# wins resolution; Robometer/ second for shared utilities.
export PYTHONPATH="$QWEN35_FT_DIR:$HERE:$ROBOMETER_DIR:${PYTHONPATH:-}"

echo "==================== smoke summary ===================="
echo "ENV_NAME : $ENV_NAME"
echo "python   : $(which python)"
python -c "import torch, transformers; print(f'torch={torch.__version__} transformers={transformers.__version__}')"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1
echo "========================================================"

python <<'PYEOF'
print("[1/4] base imports + torch.cuda check")
import torch
assert torch.cuda.is_available(), "no CUDA available on GPU node?"
print(f"  torch.cuda: {torch.cuda.get_device_name(0)}")

print("[2/4] vlm_ibrl deps (the ones that were missing in qwen35_gpu)")
import pyrallis, hydra, wandb, gym, cloudpickle, mujoco
import mujoco_py
print(f"  mujoco_py.cymj = {mujoco_py.cymj.__file__}")
# robosuite has a known top-level import bug (collections.Iterable in Py3.10) that
# also affects demo2reward — but the IBRL CoffeePush path never imports it
# top-level so it doesn't matter. Just check the specific submodule we need:
import metaworld
print(f"  metaworld OK")
# Spot-check that the env wrappers vlm_ibrl uses actually import:
from env import vlm_envs  # noqa
print(f"  env.vlm_envs OK")

print("[3/4] Qwen3.5 transformers class importable")
from transformers import Qwen3_5ForConditionalGeneration
print(f"  Qwen3_5ForConditionalGeneration = {Qwen3_5ForConditionalGeneration}")

print("[4/4] load Qwen3.5-FT step-3000 via RobometerScorer")
import os, sys
from env.robometer_utils import get_robometer_4b
ckpt = "/scratch-shared/pkarageorgis1/Qwen35_FT_consolidated/run4_step3000"
assert os.path.isdir(ckpt), f"missing checkpoint dir: {ckpt}"
scorer = get_robometer_4b(model_path=ckpt, device="cuda")
print(f"  scorer loaded, max_frames={scorer.max_frames}, device={scorer.device}")

# fake 16-frame batch (224x224x3 uint8) to confirm forward pass works end-to-end
import numpy as np
fake_frames = [np.random.randint(0, 255, (224, 224, 3), dtype=np.uint8) for _ in range(8)]
out = scorer(fake_frames, task="push a mug under a coffee machine", episode_id=0)
print(f"  forward pass OK -> progress={out.get('progress_reward'):.4f} success_prob={out.get('success_prob'):.4f}")

print()
print(">>> SMOKE PASSED — vlm_ibrl_qwen35 env is ready for IBRL")
PYEOF
RC=$?

echo
echo "==================== smoke exit ===================="
echo "return code: $RC"
exit $RC
