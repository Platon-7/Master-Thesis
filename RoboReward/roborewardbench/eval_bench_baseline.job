#!/bin/bash
#SBATCH --job-name=rrb_bl
#SBATCH --output=logs/rrb_bl_%j.out
#SBATCH --error=logs/rrb_bl_%j.err
#SBATCH --time=06:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=80G

# RoboRewardBench for RoboDopamine and LRM, via our own transformers-based
# adapters instead of upstream's baselines.
#
# WHY NOT UPSTREAM: robometer/evals/baselines/robodopamine.py routes through
# rbd_inference.GRMInference, which needs vLLM and therefore torch 2.9 in a
# separate venv; our stack pins 2.8. Upstream has no LRM baseline at all.
# robometer_policy_learning already carries scorers for both, validated
# end-to-end on Robomimic, MetaWorld and ManiSkill, so we reuse those.
#
#   MODEL=lrm sbatch jobs/eval_bench_baseline.job
#   MODEL=robodopamine LIMIT=20 sbatch ... jobs/eval_bench_baseline.job

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs

MODEL="${MODEL:?set MODEL=lrm|robodopamine}"
RPL="${RPL:-$HERE/../../robometer-policy-learning}"
OUT="${OUT:-/scratch-shared/$USER/roborewardbench}"
OUTDIR="${OUTDIR:-$OUT/results/${MODEL}}"
LIMIT="${LIMIT:-0}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 2>/dev/null || true
ENV_PREFIX="${ENV_PREFIX:-/projects/prjs1958/$USER/envs/maniskill_rl}"
PYTHON="$ENV_PREFIX/bin/python"
[[ -x "$PYTHON" ]] || { echo "ERROR: no python at $PYTHON" >&2; exit 1; }
export PATH="$ENV_PREFIX/bin:$PATH"
export PYTHONPATH="$RPL:${PYTHONPATH:-}"
export HF_HOME="${HF_HOME:-/scratch-shared/$USER/hf_cache}"
export TOKENIZERS_PARALLELISM=false

echo "==================== RoboRewardBench baseline ===================="
echo "host    : $(hostname)  job ${SLURM_JOB_ID:-local}"
echo "MODEL   : $MODEL     LIMIT=$LIMIT"
echo "CACHE   : ${RRB_CACHE:-<default>}"
echo "OUTDIR  : $OUTDIR"
echo "python  : $PYTHON"
nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1
echo "=================================================================="

ARGS=(--model "$MODEL" --out "$OUTDIR")
[[ -n "${RRB_CACHE:-}" ]] && ARGS+=(--cache "$RRB_CACHE")
[[ "$LIMIT" != "0" ]] && ARGS+=(--limit "$LIMIT")
"$PYTHON" "$HERE/score_bench_baseline.py" "${ARGS[@]}"
RC=$?
echo "EXIT=$RC"
exit $RC
