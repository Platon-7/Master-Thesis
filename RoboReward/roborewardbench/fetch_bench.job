#!/bin/bash
#SBATCH --job-name=rrb_fetch
#SBATCH --output=logs/rrb_fetch_%j.out
#SBATCH --error=logs/rrb_fetch_%j.err
#SBATCH --time=06:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --partition=staging
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; mkdir -p logs
source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
export HF_HOME="${HF_HOME:-/scratch-shared/$USER/hf_cache}"
export RRB_LOCAL="${RRB_LOCAL:-/scratch-shared/$USER/RoboReward}"
export RRB_MAX_SECONDS="${RRB_MAX_SECONDS:-20000}"
echo "egress IP: $(curl -s --max-time 10 https://api.ipify.org || echo unknown)"
exec /home/$USER/.conda/envs/robometer_gpu/bin/python fetch_bench.py
