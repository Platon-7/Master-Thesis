#!/bin/bash
#SBATCH --job-name=dl_models
#SBATCH --output=/home/pkarageorgis/droid_failures/download_models_%j.out
#SBATCH --partition=staging
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00

source $(conda info --base)/etc/profile.d/conda.sh
conda activate qwen_host

export HF_HOME="/scratch-shared/pkarageorgis/hf_cache"

echo "Downloading Qwen3-VL-30B-A3B-Instruct..."
python -c "
from huggingface_hub import snapshot_download
snapshot_download('Qwen/Qwen3-VL-30B-A3B-Instruct')
print('VLM download complete')
"

echo "Downloading Qwen3-32B..."
python -c "
from huggingface_hub import snapshot_download
snapshot_download('Qwen/Qwen3-32B')
print('LLM download complete')
"

echo "Done at: $(date)"
