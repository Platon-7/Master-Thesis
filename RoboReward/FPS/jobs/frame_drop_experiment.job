#!/bin/bash
#SBATCH --job-name=frame_drop
#SBATCH --output=/home/%u/master-thesis/Robo-Reward-FPS/logs/frame_drop_%j.txt
#SBATCH --partition=defq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --constraint=TitanRTX
#SBATCH --time=12:00:00

# Load CUDA
module load cuda12.6/toolkit/12.6

# Activate Conda
source $(conda info --base)/etc/profile.d/conda.sh
conda activate /var/scratch/$USER/conda_envs/roboreward

# Environment setup
export HF_HOME="/var/scratch/$USER/hf_cache"
export TORCH_HOME="/var/scratch/$USER/torch_cache"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export FORCE_QWENVL_VIDEO_READER=torchvision
export SCRATCH_DIR="/var/scratch/$USER"

# Debug Info
echo "============================================"
echo "Frame Drop Experiment - RoboReward"
echo "============================================"
echo "Node: $(hostname)"
echo "Date: $(date)"
echo "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)"
echo "Drop rates: 20%, 40%, 60%"
echo "Qwen FPS: 60.0 (native DROID pillow FPS)"
echo "============================================"

# Create results/logs directories
mkdir -p /var/scratch/$USER/roboreward_results
mkdir -p /home/$USER/master-thesis/Robo-Reward-FPS/logs

# Run experiment
python -u /home/$USER/master-thesis/Robo-Reward-FPS/scripts/frame_drop_experiment.py \
    --drop-rates 0.2 0.4 0.6

echo "============================================"
echo "Experiment completed at: $(date)"
echo "============================================"
