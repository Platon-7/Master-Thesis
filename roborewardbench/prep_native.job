#!/bin/bash
#SBATCH --job-name=rrb_native
#SBATCH --output=logs/rrb_native_%j.out
#SBATCH --error=logs/rrb_native_%j.err
#SBATCH --time=03:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --partition=staging

# Step 2 over the ORIGINAL bench clips (native resolution, no re-encode), to test
# whether our MAE gap against the published 0.72 comes from input fidelity.
set -euo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs
ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
RAW="/scratch-shared/$USER/roborewardbench/native_raw"
CACHE="/scratch-shared/$USER/roborewardbench/step2_native"
NF="${NF:-32}"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
module load 2025 FFmpeg/7.1.1-GCCcore-14.2.0
PYTHON="${PYTHON:-/home/$USER/.conda/envs/robometer_gpu/bin/python}"
export ROBOMETER_PROCESSED_DATASETS_PATH="$CACHE"
mkdir -p "$CACHE"; cd "$ROBOMETER_DIR"

TMP="$(mktemp --suffix=.yaml)"; trap 'rm -f "$TMP"' EXIT
cat > "$TMP" <<YAML
train_datasets:
  - $RAW
train_subsets:
  - ["roboreward_test"]
eval_datasets: []
eval_subsets: []
max_frames_for_preprocessing: $NF
video_frame_sampling: "uniform"
num_proc: 1
num_threads: 16
force_reprocess: false
cache_dir: $CACHE
precompute_embeddings: false
YAML
cat "$TMP"
"$PYTHON" -m robometer.data.scripts.preprocess_datasets --config "$TMP" --cache_dir "$CACHE"

HASHED="${RAW//\//_}_roboreward_test"
[[ -d "$CACHE/$HASHED" ]] || { echo "ERROR: missing $CACHE/$HASHED" >&2; exit 4; }
ln -sfn "$HASHED" "$CACHE/roboreward_test"
echo "linked $CACHE/roboreward_test -> $HASHED"
"$PYTHON" - <<PY
import numpy as np, glob
f=sorted(glob.glob("$CACHE/$HASHED/frames/*.npz"))[:3]
for p in f:
    with np.load(p) as z: print(p.split('/')[-1][:40], z['frames'].shape, z['frames'].dtype)
PY
echo "NATIVE PREP DONE"
