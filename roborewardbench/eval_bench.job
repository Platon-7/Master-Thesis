#!/bin/bash
#SBATCH --job-name=rrb_eval
#SBATCH --output=logs/rrb_eval_%j.out
#SBATCH --error=logs/rrb_eval_%j.err
#SBATCH --time=08:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=80G

# RoboRewardBench MAE for one checkpoint, through the repo's own harness.
#
# eval_type=reward_alignment with use_frame_steps=false gives exactly one
# prediction per clip; compile_results.py then bins the LAST progress value to
# 1..5 and compares against partial_success binned the same way, which is the
# MAE the RoboReward paper and Robometer both report.
#
#   MODEL=run2 sbatch jobs-dir/eval_bench.job     # RoboRef (the deployed model)
#   MODEL=base sbatch jobs-dir/eval_bench.job     # released Robometer-4B
#   MODEL=run3 ...                                # Robometer + Failures
# or pass CKPT=<path> directly.

set -uo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs

MODEL="${MODEL:-run2}"
REWARD_MODEL="${REWARD_MODEL:-rbm}"   # rbm | roboreward | robodopamine | topreward | lrm
CKPT_ROOT=/projects/prjs1958/Robometer_FT_consolidated
case "$MODEL" in
  run2) CKPT="${CKPT:-$CKPT_ROOT/run2_noicl_ours_step4000}" ;;
  run3) CKPT="${CKPT:-$CKPT_ROOT/run3_noicl_standard_step5000}" ;;
  base) CKPT="${CKPT:-robometer/Robometer-4B}" ;;
  roboreward) REWARD_MODEL=roboreward; CKPT="${CKPT:-teetone/RoboReward-4B}" ;;
  roboreward8b) REWARD_MODEL=roboreward; CKPT="${CKPT:-teetone/RoboReward-8B}" ;;
  *)    CKPT="${CKPT:?set CKPT=<path> for MODEL=$MODEL}" ;;
esac

ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
OUT="${OUT:-/scratch-shared/$USER/roborewardbench}"
STEP2="${STEP2:-$OUT/step2}"   # STEP2 lets us point at an alternative cache (e.g. step2_native)
OUTDIR="${OUTDIR:-$OUT/results/${MODEL}}"
BATCH="${BATCH:-8}"
# baseline_eval_config.yaml pins max_frames=32 and feeds it to DataConfig for EVERY
# model, so a checkpoint whose native budget is 8 or 16 gets padded up to 32 with
# duplicated frames. MAXF sets it to the model's own budget.
MAXF="${MAXF:-}"
MAXF_ARG=""; [[ -n "$MAXF" ]] && MAXF_ARG="max_frames=$MAXF"
# model_config differs per reward_model; only rbm/rewind expose batch_size
case "$REWARD_MODEL" in
  rbm|rewind) BATCH_ARG="model_config.batch_size=$BATCH" ;;
  *)          BATCH_ARG="" ;;
esac

[[ -d "$STEP2/roboreward_test" ]] || { echo "ERROR: no bench cache at $STEP2/roboreward_test — run prep_bench.job" >&2; exit 2; }

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
ENV_PREFIX="${ENV_PREFIX:-/home/$USER/.conda/envs/robometer_gpu_fa2}"
PYTHON="$ENV_PREFIX/bin/python"
[[ -x "$PYTHON" ]] || { echo "ERROR: no python at $PYTHON" >&2; exit 1; }
export PATH="$ENV_PREFIX/bin:$PATH"

export ROBOMETER_PROCESSED_DATASETS_PATH="$STEP2"
export ROBOMETER_DISABLE_UNSLOTH=1
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="$ROBOMETER_DIR:${PYTHONPATH:-}"
mkdir -p "$OUTDIR"

echo "==================== RoboRewardBench ===================="
echo "host   : $(hostname)  job ${SLURM_JOB_ID:-local}"
echo "MODEL  : $MODEL   reward_model=$REWARD_MODEL"
echo "CKPT   : $CKPT"
echo "cache  : $STEP2/roboreward_test -> $(readlink -f "$STEP2/roboreward_test")"
echo "OUTDIR : $OUTDIR   batch=$BATCH  max_frames=${MAXF:-<config default 32>}"
nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1
echo "========================================================="

cd "$ROBOMETER_DIR"
"$PYTHON" robometer/evals/run_baseline_eval.py \
    reward_model="$REWARD_MODEL" \
    model_path="$CKPT" \
    $BATCH_ARG $MAXF_ARG \
    custom_eval.eval_types="[reward_alignment]" \
    custom_eval.reward_alignment="[roboreward_test]" \
    custom_eval.reward_alignment_max_trajectories=null \
    custom_eval.use_frame_steps=false \
    output_dir="$OUTDIR"
RC=$?
echo "EXIT=$RC"
echo "=== metrics ==="
cat "$OUTDIR/baseline_metrics.json" 2>/dev/null || find "$OUTDIR" -name "*metrics*.json" -exec sh -c 'echo "--- $1"; cat "$1"' _ {} \;
exit $RC
