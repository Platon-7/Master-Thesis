#!/bin/bash
#SBATCH --job-name=rrb_prep
#SBATCH --output=logs/rrb_prep_%j.out
#SBATCH --error=logs/rrb_prep_%j.err
#SBATCH --time=06:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --partition=staging

# RoboRewardBench (teetone/RoboReward, test split, 2831 human-verified clips)
# -> Robometer HF dataset -> step-2 training-ready cache.
#
# Two upstream steps, both unmodified:
#   1. dataset_upload.generate_hf_dataset with the repo's own roboreward.yaml.
#      The loader is picked by name ("roboreward" in dataset_name, line 1115),
#      and the split by name too ("test" -> test/), so roboreward_test hits both.
#      data_source comes out as roboreward_<archive>, which is what makes
#      compile_results.py take its is_roboreward branch and emit MAE.
#   2. robometer.data.scripts.preprocess_datasets, at 16 keyframes to match the
#      budget our fine-tunes were trained on.
#
# The short-name symlink at the end is what lets the eval refer to the cache as
# plain "roboreward_test" (base.py::_get_available_datasets looks for the short
# name, preprocess writes the path-mangled one).

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"; HERE="$(pwd)"; mkdir -p logs

ROBOMETER_DIR="${ROBOMETER_DIR:-$HERE/../Robometer}"
SRC="${SRC:-/scratch-shared/$USER/RoboReward}"
OUT="${OUT:-/scratch-shared/$USER/roborewardbench}"
RAW="$OUT/test_raw"
STEP2="$OUT/step2"

source /etc/profile.d/lmod.sh 2>/dev/null || true
module load 2025 Anaconda3/2025.06-1
module load 2025 FFmpeg/7.1.1-GCCcore-14.2.0
PYTHON="${PYTHON:-/home/$USER/.conda/envs/robometer_gpu/bin/python}"
[[ -x "$PYTHON" ]] || { echo "ERROR: no python at $PYTHON" >&2; exit 1; }

N=$(find "$SRC/test" -name '*.mp4' 2>/dev/null | wc -l)
[[ -f "$SRC/test/metadata.jsonl" ]] || { echo "ERROR: $SRC/test/metadata.jsonl missing" >&2; exit 2; }
echo "source clips: $N   (bench is 2831)"
if [[ "${REQUIRE_FULL:-1}" == "1" && "$N" -ne 2831 ]]; then
    echo "ERROR: incomplete download ($N/2831). Rerun fetch_bench.job, or set REQUIRE_FULL=0." >&2
    exit 3
fi

mkdir -p "$RAW" "$STEP2"
export ROBOMETER_PROCESSED_DATASETS_PATH="$STEP2"
export TOKENIZERS_PARALLELISM=false
cd "$ROBOMETER_DIR"

echo "=============== step 1: generate_hf_dataset ==============="
"$PYTHON" -m dataset_upload.generate_hf_dataset \
    --config_path dataset_upload/configs/data_gen_configs/roboreward.yaml \
    --dataset.dataset_path "$SRC" \
    --dataset.dataset_name roboreward_test \
    --output.output_dir "$RAW" \
    --output.num_workers 16 \
    --hub.push_to_hub=False

echo "=============== step 2: preprocess_datasets ==============="
TMP_PP_YAML="$(mktemp --suffix=.yaml)"
trap 'rm -f "$TMP_PP_YAML"' EXIT
cat > "$TMP_PP_YAML" <<YAML
train_datasets:
  - $RAW
train_subsets:
  - ["roboreward_test"]
eval_datasets: []
eval_subsets: []
max_frames_for_preprocessing: 16
video_frame_sampling: "uniform"
num_proc: 1
num_threads: 16
force_reprocess: false
cache_dir: $STEP2
precompute_embeddings: false
YAML
cat "$TMP_PP_YAML"
"$PYTHON" -m robometer.data.scripts.preprocess_datasets --config "$TMP_PP_YAML" --cache_dir "$STEP2"

HASHED="${RAW//\//_}_roboreward_test"
if [[ -d "$STEP2/$HASHED" ]]; then
    ln -sfn "$HASHED" "$STEP2/roboreward_test"
    echo "linked $STEP2/roboreward_test -> $HASHED"
else
    echo "ERROR: expected cache dir not found: $STEP2/$HASHED" >&2; exit 4
fi
echo "PREP DONE. rows: $("$PYTHON" -c "
from datasets import load_from_disk; print(load_from_disk('$STEP2/$HASHED/processed_dataset').num_rows)" 2>/dev/null || echo '?')"
