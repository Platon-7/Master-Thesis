#!/bin/bash
#SBATCH --job-name=failsafe_sample
#SBATCH --output=/home/pkarageorgis1/Master-Thesis/Failsafe/logs/sample_%j.out
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --cpus-per-task=8
#SBATCH --time=4:00:00

# Quick verification run: 3 episodes per score, all 3 tasks.
# Run this first to get the HTML and verify stage→score mapping before committing to grand run.

CONDA_BASE=/gpfs/scratch1/shared/pkarageorgis1/miniforge3
source $CONDA_BASE/etc/profile.d/conda.sh
conda activate failsafe

export FAILSAFE_PATH=/home/pkarageorgis1/Master-Thesis/Failsafe/failsafe_repo
export MUJOCO_GL=egl
export PYTHONUNBUFFERED=1

THESIS=/home/pkarageorgis1/Master-Thesis
OUTPUT=/gpfs/scratch1/shared/pkarageorgis1/failsafe_failures

mkdir -p $THESIS/Failsafe/logs

# Wipe previous run so all slots regenerate with updated parameters
rm -rf $OUTPUT/sample_v1

python $THESIS/Failsafe/generate_failures.py \
    --output-dir $OUTPUT/sample_v1

echo "=== Generating HTML verification page ==="
python $THESIS/Failsafe/visualize_labels.py \
    --jsonl   $OUTPUT/sample_v1/maniskill_failures.jsonl \
    --keyframes $OUTPUT/sample_v1/keyframes \
    --output  $THESIS/Failsafe/logs/sample_review.html

echo "=== Done. Open Failsafe/logs/sample_review.html to verify labels. ==="
